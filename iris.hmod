import asyncio
import html
import random
import re
import time
from collections import defaultdict
from datetime import datetime, timedelta, timezone

IRIS_BOTS = [
    "iris_black_bot",
    "iris_dp_bot",
    "iris_bs_bot",
    "iris_moon_bot",
    "iris_cm_bot",
]
FARM_WORDS = ["Ферма", "Фарма", "Фармить"]
BASE_COOLDOWN = 4 * 3600
MUTE_UNTIL = 2**31 - 1

_RT = {"peers": {}, "bot_ids": {}}


def _t(ctx, key, default="", **params):
    default = HOTARU["lexicon"]["en"]["strings"].get(key, default)
    try:
        value = ctx.t("iris." + key, default, **params)
    except Exception:
        value = None
    if not isinstance(value, str) or not value:
        try:
            value = default.format(**params)
        except (KeyError, IndexError, ValueError):
            value = default
    return value


def _parse_icoins(text):
    m = re.search(r"([0-9][0-9 ]*)\s*i[¢c]", text, re.IGNORECASE)
    return int(m.group(1).replace(" ", "")) if m else 0


def _parse_cooldown_seconds(text):
    chunk = re.search(r"через\s+([^\n\r.!]+)", text.lower())
    if not chunk:
        return None
    part = chunk.group(1)
    hours = re.search(r"(\d+)\s*час", part)
    mins = re.search(r"(\d+)\s*мин", part)
    secs = re.search(r"(\d+)\s*сек", part)
    total = (
        int(hours.group(1)) * 3600 if hours else 0
    ) + (
        int(mins.group(1)) * 60 if mins else 0
    ) + (
        int(secs.group(1)) if secs else 0
    )
    return total or None


def _parse_all_loads(text):
    result = {}
    for bot in IRIS_BOTS:
        match = re.search(
            rf"t\.me/{re.escape(bot)}.{{0,450}}?Загружен:\s*([\d,.]+)\s*%",
            text,
            re.IGNORECASE | re.DOTALL,
        )
        if match:
            result[bot] = float(match.group(1).replace(",", "."))
    return result


def _msg_text(m):
    if not isinstance(m, dict):
        return ""
    out = m.get("message") or ""
    for ent in m.get("entities") or []:
        if not isinstance(ent, dict):
            continue
        if ent.get("_") == "messageEntityTextUrl":
            url = ent.get("url") or ""
            off = ent.get("offset", 0)
            ln = ent.get("length", 0)
            if url and 0 <= off and off + ln <= len(out):
                out = out[:off] + f'<a href="{html.escape(url, quote=True)}">' + out[off:off + ln] + "</a>" + out[off + ln:]
        elif ent.get("_") == "messageEntityBold":
            off = ent.get("offset", 0)
            ln = ent.get("length", 0)
            if 0 <= off and off + ln <= len(out):
                out = out[:off] + "<b>" + html.escape(out[off:off + ln]) + "</b>" + out[off + ln:]
    return out


def _msg_raw(m):
    return (m.get("message") or "") if isinstance(m, dict) else ""


def _st(ctx):
    raw = ctx.state.get("rt", {})
    if not isinstance(raw, dict):
        raw = {}
    raw.setdefault("running", False)
    raw.setdefault("start_ts", 0.0)
    raw.setdefault("session_count", 0)
    raw.setdefault("cooldown_until", 0.0)
    raw.setdefault("next_run_at", 0.0)
    raw.setdefault("last_farm_ts", 0.0)
    raw.setdefault("last_farm_bot", "")
    raw.setdefault("last_farm_coins", 0)
    return raw


def _st_set(ctx, st):
    ctx.state.set("rt", st)


def _num(ctx, key, default=0):
    v = ctx.state.get(key, default)
    try:
        return float(v) if isinstance(default, float) else int(v)
    except Exception:
        return default


def _tz_hours(ctx):
    try:
        return int(str(ctx.config.get("timezone_offset", "UTC+3")).replace("UTC", ""))
    except Exception:
        return 3


def _tz(ctx):
    return timezone(timedelta(hours=_tz_hours(ctx)))


def _now_ts():
    return datetime.now(timezone.utc).timestamp()


def _format_dt(ctx, ts):
    if not ts:
        return _t(ctx, "unknown", "—")
    return datetime.fromtimestamp(ts, timezone.utc).astimezone(_tz(ctx)).strftime("%H:%M")


def _lang_code(ctx):
    language = str(ctx.i18n.language or "ru").split("_")[0]
    return "jp" if language == "ja" else language


def _format_td(ctx, seconds):
    total = max(0, int(seconds))
    if total <= 0:
        return _t(ctx, "now", "now")
    hours, rem = divmod(total, 3600)
    mins, secs = divmod(rem, 60)
    parts = []
    if hours:
        parts.append(f"{hours}{_t(ctx, 'td_h', 'h')}")
    if mins:
        parts.append(f"{mins}{_t(ctx, 'td_m', 'm')}")
    if secs and not hours:
        parts.append(f"{secs}{_t(ctx, 'td_s', 's')}")
    return " ".join(parts) if parts else _t(ctx, "now", "now")


def _add_log(ctx, text):
    logs = ctx.state.get("logs", [])
    if not isinstance(logs, list):
        logs = []
    stamp = datetime.now(timezone.utc).astimezone(_tz(ctx)).strftime("%d.%m %H:%M")
    logs.append(f"[{stamp}] {text}")
    limit = int(ctx.config.get("max_logs", 300) or 300)
    if len(logs) > limit:
        logs = logs[-limit:]
    ctx.state.set("logs", logs)


async def _peer(ctx, username):
    cached = _RT["peers"].get(username)
    if cached:
        return cached
    try:
        res = await ctx.tg.call("contacts.resolveUsername", {"username": username.lstrip("@")})
    except Exception:
        return None
    users = (res or {}).get("users") or []
    for u in users:
        if isinstance(u, dict) and u.get("id") and u.get("access_hash") is not None:
            peer = {"_": "inputPeerUser", "user_id": u["id"], "access_hash": u["access_hash"]}
            _RT["peers"][username] = peer
            _RT["bot_ids"][u["id"]] = username
            return peer
    return None


async def _send(ctx, bot, text):
    peer = await _peer(ctx, bot)
    if not peer:
        return None
    try:
        res = await ctx.tg.call("messages.sendMessage", {
            "peer": peer,
            "message": text,
            "random_id": random.randint(1, 2**62),
        })
    except Exception:
        return None
    if isinstance(res, dict) and res.get("id"):
        return {"id": res["id"], "date": res.get("date", int(time.time()))}
    for upd in (res or {}).get("updates") or []:
        if not isinstance(upd, dict):
            continue
        message = upd.get("message")
        if isinstance(message, dict) and message.get("id"):
            return {"id": message["id"], "date": message.get("date", int(time.time()))}
        if upd.get("id"):
            return {"id": upd["id"], "date": upd.get("date", int(time.time()))}
    raise RuntimeError("Telegram did not return a sent message ID")


async def _hist(ctx, bot, limit=8):
    peer = await _peer(ctx, bot)
    if not peer:
        return []
    try:
        res = await ctx.tg.call("messages.getHistory", {
            "peer": peer, "offset_id": 0, "offset_date": 0, "add_offset": 0,
            "limit": limit, "max_id": 0, "min_id": 0, "hash": 0,
        })
    except Exception:
        return []
    return [m for m in ((res or {}).get("messages") or []) if isinstance(m, dict)]


async def _wait_response(ctx, bot, after_id, after_date, matcher=None):
    timeout = int(ctx.config.get("response_timeout", 120) or 120)
    fallback = None
    for _ in range(timeout):
        for m in await _hist(ctx, bot, 8):
            if m.get("out") or m.get("id", 0) <= after_id:
                continue
            if after_date and m.get("date") and m["date"] < after_date:
                continue
            if matcher is None:
                return m
            if matcher(m):
                return m
            if fallback is None:
                fallback = m
        await asyncio.sleep(1)
    return fallback


async def _mark_read(ctx, bot, max_id=0):
    peer = await _peer(ctx, bot)
    if not peer:
        return
    try:
        await ctx.tg.call("messages.readHistory", {"peer": peer, "max_id": max_id})
    except Exception:
        pass


async def _delete(ctx, bot, ids):
    if not ids:
        return
    peer = await _peer(ctx, bot)
    if not peer:
        return
    try:
        await ctx.tg.call("messages.deleteMessages", {"id": list(ids), "revoke": True})
    except Exception:
        pass


async def _mute_bot(ctx, bot, mute):
    peer = await _peer(ctx, bot)
    if not peer:
        return
    try:
        await ctx.tg.call("account.updateNotifySettings", {
            "peer": {"_": "inputNotifyPeer", "peer": peer},
            "settings": {"_": "inputPeerNotifySettings", "mute_until": MUTE_UNTIL if mute else 0},
        })
    except Exception:
        pass


async def _mute_all(ctx, mute):
    for bot in IRIS_BOTS:
        await _mute_bot(ctx, bot, mute)


async def _request_bot(ctx, bot, command, matcher=None):
    sent = []
    try:
        msg = await _send(ctx, bot, command)
        if not msg:
            return None, sent
        sent.append(msg["id"])
        resp = await _wait_response(ctx, bot, msg["id"], msg["date"], matcher)
        await _mark_read(ctx, bot)
        if resp:
            sent.append(resp["id"])
        return resp, sent
    finally:
        if ctx.config.get("auto_cleanup", True) and sent:
            await _delete(ctx, bot, sent)


async def _fetch_loads(ctx):
    for probe_bot in IRIS_BOTS:
        try:
            await _mute_bot(ctx, probe_bot, True)
            msg = await _send(ctx, probe_bot, "🌺 Семейство ирисовых")
            if not msg:
                continue
            resp = await _wait_response(ctx, probe_bot, msg["id"], msg["date"])
            await _mark_read(ctx, probe_bot)
            if not resp:
                continue
            loads = _parse_all_loads(_msg_raw(resp))
            if ctx.config.get("auto_cleanup", True):
                await _delete(ctx, probe_bot, [msg["id"], resp["id"]])
            if loads:
                ctx.state.set("bot_loads", loads)
                ctx.state.set("bot_loads_updated", _now_ts())
                best = sorted(loads.items(), key=lambda item: item[1])[0][0]
                ctx.state.set("active_bot", best)
                return loads
        except Exception as e:
            logs.warn("iris: load fetch via %s failed: %s" % (probe_bot, e))
        finally:
            await _mute_bot(ctx, probe_bot, False)
    ctx.state.set("bot_loads_updated", _now_ts())
    _add_log(ctx, "⚠️ Load check failed for all Iris bots")
    return {}


def _best_bot(ctx):
    loads = ctx.state.get("bot_loads", {})
    if not isinstance(loads, dict) or not loads:
        return IRIS_BOTS[0], -1.0
    return sorted(loads.items(), key=lambda item: item[1])[0]


async def _get_best_bot(ctx):
    updated = float(ctx.state.get("bot_loads_updated", 0.0) or 0.0)
    stale = (_now_ts() - updated) > float(ctx.config.get("load_refresh_minutes", 20) or 20) * 60
    if not ctx.state.get("bot_loads", {}) or stale:
        await _fetch_loads(ctx)
    return _best_bot(ctx)


async def _pick_request_bot(ctx):
    bot, load = await _get_best_bot(ctx)
    ctx.state.set("active_bot", bot)
    return bot, load


def _extra_delay(ctx):
    low = int(ctx.config.get("extra_delay_min", 3) or 0) * 60
    high = int(ctx.config.get("extra_delay_max", 8) or 0) * 60
    if low >= high:
        return low
    return random.randint(low, high) + random.randint(0, 59)


def _plan_next_run(ctx, st, cooldown_seconds):
    base = _now_ts() + max(0, cooldown_seconds)
    st["cooldown_until"] = base
    st["next_run_at"] = base + _extra_delay(ctx)
    _st_set(ctx, st)


def _normalize_runtime_state(ctx, st):
    now = _now_ts()
    if not st.get("running"):
        return
    if st.get("last_farm_ts") and st.get("cooldown_until", 0) < st["last_farm_ts"]:
        st["cooldown_until"] = st["last_farm_ts"] + BASE_COOLDOWN
    if st.get("cooldown_until") and not st.get("next_run_at"):
        st["next_run_at"] = st["cooldown_until"]
    if st.get("next_run_at") and st.get("cooldown_until") and st["next_run_at"] < st["cooldown_until"]:
        st["next_run_at"] = st["cooldown_until"]
    if not st.get("start_ts"):
        st["start_ts"] = st.get("last_farm_ts") or now
    if st.get("cooldown_until") and (now - st["cooldown_until"]) > BASE_COOLDOWN * 3:
        st["cooldown_until"] = 0.0
    if st.get("next_run_at") and (now - st["next_run_at"]) > BASE_COOLDOWN * 3:
        st["next_run_at"] = now
    _st_set(ctx, st)


async def _do_farm(ctx, bot):
    st = _st(ctx)
    sent = []
    try:
        msg = await _send(ctx, bot, random.choice(FARM_WORDS))
        if not msg:
            _add_log(ctx, f"⚠️ [{bot}] send failed")
            return 10 * 60
        sent.append(msg["id"])
        resp = await _wait_response(ctx, bot, msg["id"], msg["date"])
        await _mark_read(ctx, bot)
        if not resp:
            _add_log(ctx, f"⚠️ [{bot}] no response")
            return 10 * 60
        sent.append(resp["id"])
        text = _msg_raw(resp)
        upper = text.upper()
        if "ЗАЧЁТ" in upper and "НЕЗАЧЁТ" not in upper:
            coins = _parse_icoins(text)
            total = _num(ctx, "total_icoins", 0) + coins
            session = _num(ctx, "session_icoins", 0) + coins
            ctx.state.set("total_icoins", total)
            ctx.state.set("session_icoins", session)
            st = _st(ctx)
            st["session_count"] = int(st.get("session_count", 0)) + 1
            st["last_farm_ts"] = _now_ts()
            st["last_farm_bot"] = bot
            st["last_farm_coins"] = coins
            _plan_next_run(ctx, st, BASE_COOLDOWN)
            _add_log(ctx, f"✅ [{bot}] +{coins} i¢ | total {total} i¢ | iris {_format_dt(ctx, st['cooldown_until'])} | run {_format_dt(ctx, st['next_run_at'])}")
            return max(1, int(st["next_run_at"] - _now_ts()))
        if "НЕЗАЧЁТ" in upper:
            seconds = _parse_cooldown_seconds(text) or BASE_COOLDOWN
            st = _st(ctx)
            _plan_next_run(ctx, st, seconds)
            _add_log(ctx, f"❌ [{bot}] cooldown {_format_td(ctx, seconds)} | iris {_format_dt(ctx, st['cooldown_until'])} | run {_format_dt(ctx, st['next_run_at'])}")
            return max(1, int(st["next_run_at"] - _now_ts()))
        _add_log(ctx, f"❓ [{bot}] unknown response")
        return 10 * 60
    finally:
        if ctx.config.get("auto_cleanup", True):
            await _delete(ctx, bot, sent)


def _render_loads(ctx):
    loads = ctx.state.get("bot_loads", {})
    if not isinstance(loads, dict):
        loads = {}
    lines = []
    for bot in IRIS_BOTS:
        load = loads.get(bot)
        if load is None:
            lines.append(_t(ctx, "load_unknown", "{emoji} <b>{bot}</b>: <b>{value}</b>", emoji="❔", bot=bot, value=_t(ctx, "no_data", "no data")))
            continue
        emoji = "💚" if load < 20 else "💛" if load < 45 else "🧡" if load < 70 else "❤️"
        lines.append(_t(ctx, "load_line", "{emoji} <b>{bot}</b>: <b>{load}%</b>", emoji=emoji, bot=bot, load=f"{load:.1f}"))
    return "\n".join(lines)


def _last_farm_text(ctx, st):
    if not st.get("last_farm_ts"):
        return _t(ctx, "not_yet", "not yet")
    return _t(ctx, "last_farm_line", "{time} via <b>{bot}</b> (+{coins} i¢)",
              time=_format_dt(ctx, st["last_farm_ts"]), bot=st.get("last_farm_bot", ""), coins=st.get("last_farm_coins", 0))


def _schedule_text(ctx, ts):
    if not ts:
        return _t(ctx, "unknown", "—"), _t(ctx, "unknown", "—")
    left = max(0, int(ts - _now_ts()))
    return _format_td(ctx, left), _format_dt(ctx, ts)


def _clean_iris_text(text):
    text = html.escape((text or "").strip())
    text = re.sub(r"(?im)^💬.*?$", "", text)
    text = re.sub(r"(?im)^•\s*описание.*?$", "", text)
    text = re.sub(r"(?im)^•\s*description.*?$", "", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


def _plain_text(html_text):
    return html.unescape(re.sub(r"<[^>]+>", "", html_text or "")).strip()


def _extract_href(html_line):
    match = re.search(r'href="([^"]+)"', html_line or "")
    return html.escape(match.group(1), quote=True) if match else ""


def _is_super_top_response(text):
    source = (text or "").lower()
    return "топ чатов" in source or "супер топ бесед" in source


def _is_day_top_response(text):
    source = (text or "").lower()
    return "топ дня" in source and "бесед" in source


