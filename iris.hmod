def _localize_profile_value(ctx, value, field):
    lang = _lang_code(ctx)
    normalized = html.unescape((value or "").strip()).lower()
    return html.escape(_PROFILE_LOCALIZE.get(lang, {}).get(field, {}).get(normalized, value))


def _profile_map(ctx, text):
    source = text or ""
    unknown = _t(ctx, "unknown", "—")
    data = {
        "name": unknown, "status": unknown, "handle": unknown,
        "since_date": unknown, "since_span": unknown,
        "gender": unknown, "birth": unknown, "city": unknown,
        "day": "0", "week": "0", "month": "0", "total": "0",
        "rank": unknown, "candies": "0", "stars": "0", "icoins": "0",
        "gold": "0", "tg_stars": "0", "donate_points": "",
    }
    who = re.search(r"👤\s*(?:Это|It'?s)\s+(.+?)\s+\((.+?)\)", source, re.IGNORECASE)
    if who:
        data["name"] = html.escape(who.group(1).strip())
        data["status"] = _localize_profile_value(ctx, who.group(2).strip(), "status")
    handle = re.search(r"🆔\s*([^\n\r]+)", source)
    if handle:
        data["handle"] = html.escape(handle.group(1).strip())
    since = re.search(r"Во вселенной [^:]+:\s*с\s*([0-9.]+)\s*\(([^)]+)\)", source)
    if since:
        data["since_date"] = html.escape(since.group(1).strip())
        data["since_span"] = html.escape(since.group(2).strip())
    gender = re.search(r"Пол:\s*([^\n\r]+)", source)
    if gender:
        data["gender"] = _localize_profile_value(ctx, gender.group(1).strip(), "gender")
    birth = re.search(r"Дата рождения:\s*([^\n\r]+)", source)
    if birth:
        data["birth"] = _localize_profile_value(ctx, birth.group(1).strip(), "birth")
    city = re.search(r"Город:\s*([^\n\r]+)", source)
    if city:
        data["city"] = _localize_profile_value(ctx, city.group(1).strip(), "city")
    activity = re.search(r"Активность.*?:\s*([0-9 ]+)\s*\|\s*([0-9 ]+)\s*\|\s*([0-9 ]+)\s*\|\s*([0-9 ]+)", source)
    if activity:
        data["day"] = activity.group(1).strip()
        data["week"] = activity.group(2).strip()
        data["month"] = activity.group(3).strip()
        data["total"] = activity.group(4).strip()
    rank = re.search(r"Зв[её]здность:\s*([^\n\r]+)", source)
    if rank:
        data["rank"] = _localize_profile_value(ctx, rank.group(1).strip(), "rank")
    candies = re.search(r"🍬\s*([0-9 ]+)", source)
    if candies:
        data["candies"] = candies.group(1).strip()
    stars = re.search(r"✨\s*([0-9 ]+)\s*(?:зв[её]здочек|stars?)", source, re.IGNORECASE)
    if stars:
        data["stars"] = stars.group(1).strip()
    icoins = re.search(r"☢️\s*([0-9 ]+)\s*i[¢c]", source, re.IGNORECASE)
    if icoins:
        data["icoins"] = icoins.group(1).strip()
    gold = re.search(r"🌕\s*([0-9 ]+)", source)
    if gold:
        data["gold"] = gold.group(1).strip()
    tg_stars = re.search(r"⭐️\s*([0-9 ]+)\s*(?:tg[- ]?зв[её]зд|tg[- ]?stars?)", source, re.IGNORECASE)
    if tg_stars:
        data["tg_stars"] = tg_stars.group(1).strip()
    donate_points = re.search(r"🥯\s*([0-9 ]+)\s*оч(?:к(?:ов|а)?|ки)\s*доната", source, re.IGNORECASE)
    if donate_points:
        data["donate_points"] = donate_points.group(1).strip()
    return data


def _render_bag(ctx, bot, text):
    source = text or ""
    owner = re.search(r"В мешке\s+(.+?):", source)
    candies = re.search(r"🍬\s*([0-9 ]+)", source)
    gold = re.search(r"🌕\s*([0-9 ]+)", source)
    icoins = re.search(r"☢️\s*([0-9 ]+)\s*i[¢c]", source)
    stars = re.search(r"✨\s*([0-9 ]+)", source)
    tg_stars = re.search(r"⭐️\s*([0-9 ]+)", source)
    donate_points = re.search(r"🥯\s*([0-9 ]+)\s*оч(?:к(?:ов|а)?|ки)\s*доната", source, re.IGNORECASE)
    if owner and candies and gold and icoins and stars:
        bag_extra = ""
        if tg_stars:
            bag_extra += _t(ctx, "tg_stars_line", "\n⭐️ TG Stars: <b>{value}</b>", value=tg_stars.group(1).strip())
        if donate_points:
            bag_extra += _t(ctx, "donate_points_line", "\n🥯 Donate points: <b>{value}</b>", value=donate_points.group(1).strip())
        return (
            _t(ctx, "bag_title", "<b>Bag</b> ({bot})", bot=bot) + "\n\n"
            + _t(ctx, "bag_text", "Owner: <b>{owner}</b>",
                 owner=html.escape(owner.group(1).strip()),
                 candies=candies.group(1).strip(),
                 gold=gold.group(1).strip(),
                 icoins=icoins.group(1).strip(),
                 stars=stars.group(1).strip(),
                 tg_stars=tg_stars.group(1).strip() if tg_stars else "0",
                 bag_extra=bag_extra)
        )
    cleaned = _clean_iris_text(source)
    return f"{_t(ctx, 'bag_title', '<b>Bag</b> ({bot})', bot=bot)}\n\n{cleaned or _t(ctx, 'unknown', '—')}"


def _render_profile(ctx, bot, text):
    data = _profile_map(ctx, text)
    unknown = _t(ctx, "unknown", "—")
    if data["name"] == unknown and data["handle"] == unknown:
        cleaned = _clean_iris_text(text)
        return f"{_t(ctx, 'profile_title', '<b>Profile</b> ({bot})', bot=bot)}\n\n{cleaned or _t(ctx, 'profile_empty', 'Empty profile.')}"
    profile_extra = ""
    if data.get("donate_points"):
        profile_extra += _t(ctx, "donate_points_line", "\n🥯 Donate points: <b>{value}</b>", value=data["donate_points"])
    return _t(ctx, "profile_text", "{title}",
              title=_t(ctx, "profile_title", "<b>Profile</b> ({bot})", bot=bot),
              universe_label=_t(ctx, "profile_universe", "Iris universe"),
              profile_extra=profile_extra,
              **data)


def _parse_top_entries(source_html):
    entries = []
    current = None
    for html_line in (source_html or "").splitlines():
        line = _plain_text(html_line)
        if not line:
            continue
        top_match = re.match(r"🔸\s*(\d+)\.\s*«(.+?)»\s*\(([0-9 ][0-9 ]*)\s*i[¢c]\)", line, re.IGNORECASE)
        if top_match:
            if current:
                entries.append(current)
            current = {
                "place": top_match.group(1).strip(),
                "name": html.escape(top_match.group(2).strip()),
                "coins": top_match.group(3).strip(),
                "join_kind": "", "join_name": "", "join_url": "", "card_url": "",
            }
            continue
        if not current:
            continue
        if "войти в чат" in line.lower():
            current["join_kind"] = "open"
            current["join_url"] = _extract_href(html_line)
            continue
        apply = re.search(r"попроситься в чат:\s*(.+)", line, re.IGNORECASE)
        if apply:
            current["join_kind"] = "apply"
            current["join_name"] = html.escape(apply.group(1).strip())
            current["join_url"] = _extract_href(html_line)
            continue
        if "карточка" in line.lower():
            current["card_url"] = _extract_href(html_line)
    if current:
        entries.append(current)
    return entries


def _make_top_link(emoji, label, url):
    rendered = f'<a href="{url}">{label}</a>' if url else label
    return f"{emoji} <b>{rendered}</b>\n"


def _render_top(ctx, bot, source_html, title_key, title_default):
    entries = _parse_top_entries(source_html)
    if not entries:
        cleaned = _clean_iris_text(_plain_text(source_html))
        return f"{_t(ctx, title_key, title_default, bot=bot)}\n\n{cleaned or _t(ctx, 'top_empty', 'Could not parse chat top.')}"
    blocks = []
    for entry in entries:
        join_line = ""
        if entry["join_kind"] == "open":
            join_line = _make_top_link("🚪", _t(ctx, "top_join_open", "Open join"), entry["join_url"])
        elif entry["join_kind"] == "apply":
            join_line = _make_top_link("🙋", _t(ctx, "top_join_apply", "Ask via {name}", name=entry["join_name"]), entry["join_url"])
        card_line = _make_top_link("🗂", _t(ctx, "top_card", "Catalog card"), entry["card_url"]) if entry["card_url"] else ""
        blocks.append(_t(ctx, "top_entry", "▫️ <b>{place}.</b> <b>{name}</b>\n☢️ <b>{coins} i¢</b>\n{join_line}{card_line}",
                         place=entry["place"], name=entry["name"], coins=entry["coins"],
                         join_line=join_line, card_line=card_line).strip())
    return f"{_t(ctx, title_key, title_default, bot=bot)}\n\n" + "\n\n".join(blocks)


async def on_startup(ctx):
    st = _st(ctx)
    _normalize_runtime_state(ctx, st)
    if st.get("running"):
        await _mute_all(ctx, True)
        _add_log(ctx, "↩️ Autofarm restored after restart")


async def task_farm(ctx):
    st = _st(ctx)
    if not st.get("running"):
        return
    now = _now_ts()
    if st.get("next_run_at") and now < st["next_run_at"]:
        return
    bot, load = await _get_best_bot(ctx)
    ctx.state.set("active_bot", bot)
    _add_log(ctx, f"🎯 {bot} selected ({load:.1f}% load)")
    delay = await _do_farm(ctx, bot)
    st = _st(ctx)
    if not st.get("next_run_at") or st["next_run_at"] < now:
        st["next_run_at"] = _now_ts() + delay
        _st_set(ctx, st)


async def task_loads(ctx):
    st = _st(ctx)
    if not st.get("running"):
        return
    fresh = await _fetch_loads(ctx)
    if fresh:
        line = ", ".join(f"{bot.replace('iris_', '').replace('_bot', '')}={load:.1f}%" for bot, load in sorted(fresh.items(), key=lambda item: item[1]))
        _add_log(ctx, f"🔄 Load refresh: {line}")


async def watcher_sync(ctx, invocation):
    st = _st(ctx)
    if not st.get("running"):
        return
    msg = getattr(ctx, "message", None)
    if msg is None or getattr(msg, "out", False):
        return
    sender_id = ctx.message.from_id or 0
    username = _RT["bot_ids"].get(sender_id, "")
    if not username:
        peer_id = ctx.chat_id
        username = _RT["bot_ids"].get(peer_id, "")
    if username not in IRIS_BOTS:
        return
    text = ctx._msg.get("text") or ctx._msg.get("message") or ""
    if isinstance(text, str):
        pass
    else:
        text = ""
    upper = text.upper()
    if "ЗАЧЁТ" in upper and "НЕЗАЧЁТ" not in upper:
        new_cooldown = _now_ts() + BASE_COOLDOWN
        if abs(new_cooldown - float(st.get("cooldown_until", 0.0))) > 60:
            st["cooldown_until"] = new_cooldown
            st["next_run_at"] = new_cooldown + _extra_delay(ctx)
            _st_set(ctx, st)
            _add_log(ctx, f"🔁 Watcher synced success from {username}")
    elif "НЕЗАЧЁТ" in upper:
        seconds = _parse_cooldown_seconds(text)
        if seconds:
            new_cooldown = _now_ts() + seconds
            if abs(new_cooldown - float(st.get("cooldown_until", 0.0))) > 60:
                st["cooldown_until"] = new_cooldown
                st["next_run_at"] = new_cooldown + _extra_delay(ctx)
                _st_set(ctx, st)
                _add_log(ctx, f"🔁 Watcher synced cooldown from {username}: {_format_td(ctx, seconds)}")


async def command_irf(ctx, invocation):
    args = (getattr(invocation, "raw_args", "") or "").strip().lower()
    st = _st(ctx)
    start = args in {"", "on", "start", "старт"}
    stop = args in {"off", "stop", "стоп"}
    if not args:
        start = not st.get("running")
        stop = bool(st.get("running"))
    if stop:
        if not st.get("running"):
            await ctx.respond(_t(ctx, "farm_stopped_already", "Autofarm is already stopped."), parse_mode="HTML")
            return
        await ctx.respond(_t(ctx, "loading_reset", "Resetting..."), parse_mode="HTML")
        st["running"] = False
        st["session_count"] = 0
        st["cooldown_until"] = 0.0
        st["next_run_at"] = 0.0
        _st_set(ctx, st)
        await _mute_all(ctx, False)
        _add_log(ctx, "⛔ Manual stop")
        await ctx.respond(_t(ctx, "farm_stopping", "Autofarm stopped."), parse_mode="HTML")
        return
    if not start:
        return
    if st.get("running"):
        await ctx.respond(_t(ctx, "farm_already", "Autofarm is already running."), parse_mode="HTML")
        return
    st["running"] = True
    st["start_ts"] = _now_ts()
    st["session_count"] = 0
    st["cooldown_until"] = 0.0
    st["next_run_at"] = 0.0
    ctx.state.set("session_icoins", 0)
    _st_set(ctx, st)
    await _mute_all(ctx, True)
    await ctx.respond(_t(ctx, "checking_load", "Checking Iris bot load..."), parse_mode="HTML")
    best_bot, best_load = await _get_best_bot(ctx)
    ctx.state.set("active_bot", best_bot)
    _add_log(ctx, f"🚀 Started with {best_bot} ({best_load:.1f}%)")
    await ctx.respond(_t(ctx, "farm_started", "Iris launched",
                         bot=best_bot,
                         load=f"{best_load:.1f}" if best_load >= 0 else "?",
                         first=_t(ctx, "start_now", "now"),
                         tz=str(ctx.config.get("timezone_offset", "UTC+3"))), parse_mode="HTML")


async def command_iris(ctx, invocation):
    st = _st(ctx)
    cooldown_left, cooldown_at = _schedule_text(ctx, float(st.get("cooldown_until", 0.0)))
    planned_left, planned_at = _schedule_text(ctx, float(st.get("next_run_at", 0.0)))
    uptime = _format_td(ctx, _now_ts() - st["start_ts"]) if st.get("start_ts") else _t(ctx, "unknown", "—")
    state = _t(ctx, "state_on", "Enabled") if st.get("running") else _t(ctx, "state_off", "Disabled")
    active_bot = ctx.state.get("active_bot", "") or _t(ctx, "unknown", "—")
    if active_bot == IRIS_BOTS[0] and ctx.state.get("bot_loads", {}):
        active_bot = _best_bot(ctx)[0]
    text = _t(ctx, "status", "{title}",
              title=_t(ctx, "status_title", "Iris — status"),
              state=state,
              uptime=uptime,
              session=_num(ctx, "session_icoins", 0),
              total=_num(ctx, "total_icoins", 0),
              count=int(st.get("session_count", 0)),
              tz=str(ctx.config.get("timezone_offset", "UTC+3")),
              last_farm=_last_farm_text(ctx, st),
              cooldown_left=cooldown_left,
              cooldown_at=cooldown_at,
              planned_left=planned_left,
              planned_at=planned_at,
              active_bot=active_bot,
              loads=_render_loads(ctx))
    await ctx.respond(text, parse_mode="HTML")


async def command_irlogs(ctx, invocation):
    args = (getattr(invocation, "raw_args", "") or "").strip()
    logs = ctx.state.get("logs", [])
    if not isinstance(logs, list):
        logs = []
    logs = list(reversed(logs))
    if not args:
        logs = logs[:8]
    elif re.fullmatch(r"\d{1,3}", args):
        logs = logs[: max(1, min(int(ctx.config.get("max_logs", 300) or 300), int(args)))]
    elif re.fullmatch(r"\d{2}\.\d{2}", args):
        logs = [entry for entry in logs if args in entry]
    else:
        await ctx.respond(_t(ctx, "logs_bad_arg", "Bad format"), parse_mode="HTML")
        return
    if not logs:
        await ctx.respond(_t(ctx, "logs_empty", "Logs are empty."), parse_mode="HTML")
        return
    await ctx.respond(_t(ctx, "logs_title", "Logs ({count})", count=len(logs)) + "\n\n" + "\n".join(logs), parse_mode="HTML")


async def command_irbag(ctx, invocation):
    await ctx.respond(_t(ctx, "loading_bag", "Loading bag..."), parse_mode="HTML")
    bot, _ = await _pick_request_bot(ctx)
    try:
        await _mute_bot(ctx, bot, True)
        resp, _ = await _request_bot(ctx, bot, "Мешок")
        if not resp:
            await ctx.respond(_t(ctx, "no_response", "No response from {bot}.", bot=bot), parse_mode="HTML")
            return
        await ctx.respond(_render_bag(ctx, bot, _msg_raw(resp)), parse_mode="HTML")
    except Exception as e:
        await ctx.respond(_t(ctx, "bag_error", "Could not get bag from {bot}: <code>{err}</code>", bot=bot, err=html.escape(str(e))), parse_mode="HTML")
    finally:
        await _mute_bot(ctx, bot, False)


