async def command_irreset(ctx, invocation):
    await ctx.respond(_t(ctx, "loading_reset", "Resetting module data..."), parse_mode="HTML")
    st = _st(ctx)
    st.update({
        "running": False, "start_ts": 0.0, "session_count": 0,
        "cooldown_until": 0.0, "next_run_at": 0.0,
        "last_farm_ts": 0.0, "last_farm_bot": "", "last_farm_coins": 0,
    })
    _st_set(ctx, st)
    ctx.state.set("total_icoins", 0)
    ctx.state.set("session_icoins", 0)
    ctx.state.set("logs", [])
    ctx.state.set("bot_loads", {})
    ctx.state.set("bot_loads_updated", 0.0)
    ctx.state.set("active_bot", IRIS_BOTS[0])
    await _mute_all(ctx, False)
    await ctx.respond(_t(ctx, "reset_done", "Iris data reset completed."), parse_mode="HTML")
