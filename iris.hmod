                "UTC-2",
                "UTC-1",
                "UTC+0",
                "UTC+1",
                "UTC+2",
                "UTC+3",
                "UTC+4",
                "UTC+5",
                "UTC+6",
                "UTC+7",
                "UTC+8",
                "UTC+9",
                "UTC+10",
                "UTC+11",
                "UTC+12"
            ],
            "default": "UTC+3",
            "description": "Display timezone"
        }
    },
