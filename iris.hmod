HOTARU = {
    "id": "iris",
    "version": "1.0.3",
    "commands": [
        "irf",
        "iris",
        "irlogs",
        "irbag",
        "irprofile",
        "irsupertop",
        "irdaytop",
        "irreset"
    ],
    "capabilities": [
        "mt",
        "state"
    ],
    "watchers": [
        "sync"
    ],
    "tasks": {
        "farm": {
            "interval": 30,
            "autostart": True
        },
        "loads": {
            "interval": 300,
            "autostart": True
        }
    },
    "config_schema": {
        "extra_delay_min": {
            "type": "int",
            "default": 3,
            "min": 0,
            "max": 30,
            "description": "Min random delay after Iris cooldown (minutes)"
        },
        "extra_delay_max": {
            "type": "int",
            "default": 8,
            "min": 0,
            "max": 60,
            "description": "Max random delay after Iris cooldown (minutes)"
        },
        "max_logs": {
            "type": "int",
            "default": 300,
            "min": 20,
            "max": 1000,
            "description": "Maximum log entries"
        },
        "load_refresh_minutes": {
            "type": "int",
            "default": 20,
            "min": 5,
            "max": 120,
            "description": "How often to refresh bot load in background (minutes)"
        },
        "response_timeout": {
            "type": "int",
            "default": 120,
            "min": 30,
            "max": 300,
            "description": "Bot response timeout in seconds"
        },
        "auto_cleanup": {
            "type": "bool",
            "default": True,
            "description": "Delete service messages after requests"
        },
        "timezone_offset": {
            "type": "choice",
