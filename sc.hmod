import asyncio
import contextlib
import io
import json
import os
import re
import shutil
import sys
import tempfile
import textwrap
import time

try:
    from PIL import Image, ImageDraw, ImageEnhance, ImageFilter, ImageFont
    HAS_PIL = True
except Exception:
    HAS_PIL = False

STORAGE_DIR = "soundcloud_storage"
SEARCH_CACHE = {}
RENAME_STATE = {}
TRIM_STATE = {}
FONT_CACHE = {"url": None, "bytes": None}
SC_HDRS = {"User-Agent": "SoundCloudMusic-Module/4.0 (Core by @samsepi0l_ovf; AGPLv3)"}


def _t(ctx, key, **fmt):
    en = HOTARU["lexicon"]["en"]["strings"].get(key, key)
    try:
        value = ctx.t("sc." + key, en, **fmt)
    except Exception:
        value = None
    if not isinstance(value, str) or not value:
        try:
            value = en.format(**fmt)
        except (KeyError, IndexError, ValueError):
            value = en
    return value


def _esc(text):
    return str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _btn(ctx, text, cb, payload=None):
    maker = getattr(ctx.ui, "button", None) or getattr(ctx.ui, "primary", None) or ctx.screens.button
    return maker(text, cb, payload)


async def _fetch_bytes(ctx, url):
    r = await ctx.net(url, method="GET", binary=True, headers=SC_HDRS, timeout=15)
    if r["status"] != 200:
        raise RuntimeError("HTTP " + str(r["status"]))
    import base64
    return base64.b64decode(r["body"], validate=True)


async def _net_get(ctx, url, timeout=15, binary=False):
    r = await ctx.net(url, method="GET", binary=binary, headers=SC_HDRS, timeout=timeout)
    return r


class Banners:
    def __init__(self, title, artists, duration, progress, track_cover, font_bytes, blur, dynamic_color=True):
        self.title = title
        self.artists = ", ".join(artists) if isinstance(artists, list) else artists
        self.duration = duration
        self.progress = progress
        self.track_cover = track_cover
        self.font_bytes = font_bytes
        self.blur_intensity = blur
        self.accent = self._get_dominant() if dynamic_color else "white"

    def _get_dominant(self):
        try:
            c = Image.open(io.BytesIO(self.track_cover)).convert("RGB").resize((1, 1)).getpixel((0, 0))
            return f"#{c[0]:02x}{c[1]:02x}{c[2]:02x}"
        except Exception:
            return "white"

    def _get_font(self, size, font_bytes):
        return ImageFont.truetype(io.BytesIO(font_bytes), size)

    def _prepare_cover(self, size, radius):
        cover = Image.open(io.BytesIO(self.track_cover)).convert("RGBA")
        cover = cover.resize((size, size), Image.Resampling.LANCZOS)
        mask = Image.new("L", (size, size), 0)
        draw = ImageDraw.Draw(mask)
        draw.rounded_rectangle((0, 0, size, size), radius=radius, fill=255)
        output = Image.new("RGBA", (size, size), (0, 0, 0, 0))
        output.paste(cover, (0, 0), mask=mask)
        return output

    def _prepare_background(self, w, h):
        bg = Image.open(io.BytesIO(self.track_cover)).convert("RGBA")
        bg = bg.resize((w, h), Image.Resampling.LANCZOS)
        bg = bg.filter(ImageFilter.GaussianBlur(radius=self.blur_intensity))
        bg = ImageEnhance.Brightness(bg).enhance(0.35)
        return bg

    def _draw_progress_bar(self, draw, x, y, w, h, progress_pct, color="white", bg_color="#6b6b6b"):
        draw.rounded_rectangle((x, y, x + w, y + h), radius=h / 2, fill=bg_color)
        fill_w = int(w * progress_pct)
        if fill_w > 0:
            draw.rounded_rectangle((x, y, x + fill_w, y + h), radius=h / 2, fill=color)

    def horizontal(self):
        W, H = 1500, 600
        padding = 60
        cover_size = 480
        title_font = self._get_font(55, self.font_bytes)
        artist_font = self._get_font(45, self.font_bytes)
        time_font = self._get_font(25, self.font_bytes)
        img = self._prepare_background(W, H)
        draw = ImageDraw.Draw(img)
        cover = self._prepare_cover(cover_size, 30)
        img.paste(cover, (padding, (H - cover_size) // 2), cover)
        text_x = padding + cover_size + 60
        text_y_start = 100
        text_width_limit = W - text_x - padding
        wrapper = textwrap.TextWrapper(width=23)
        title_lines = wrapper.wrap(self.title)
        if len(title_lines) > 2:
            title_lines = title_lines[:2]
            title_lines[-1] += "..."
        current_y = text_y_start
        title_height = title_font.getbbox("Ah")[3] + 15
        for line in title_lines:
            draw.text((text_x, current_y), line, font=title_font, fill="white")
            current_y += title_height
        display_artist = self.artists
        while artist_font.getlength(display_artist) > text_width_limit and len(display_artist) > 0:
            display_artist = display_artist[:-1]
        if len(display_artist) < len(self.artists):
            display_artist += "…"
        artist_y = current_y + 10
        draw.text((text_x, artist_y), display_artist, font=artist_font, fill="#b3b3b3")
        cur_time = f"{(self.progress//1000//60):02}:{(self.progress//1000%60):02}"
        dur_time = f"{(self.duration//1000//60):02}:{(self.duration//1000%60):02}"
        cur_w = time_font.getlength(cur_time)
        dur_w = time_font.getlength(dur_time)
        bar_y = 480
        bar_h = 8
        gap = 25
        draw.text((text_x, bar_y - 12), cur_time, font=time_font, fill="white")
        bar_start_x = text_x + cur_w + gap
        bar_end_x = text_x + text_width_limit - dur_w - gap
        bar_w = bar_end_x - bar_start_x
        prog_pct = self.progress / self.duration if self.duration > 0 else 0
        self._draw_progress_bar(draw, bar_start_x, bar_y, bar_w, bar_h, prog_pct, color=self.accent)
        draw.text((bar_end_x + gap, bar_y - 12), dur_time, font=time_font, fill="white")
        try:
            draw.text((10, 10), "Core by @samsepi0l_ovf - AGPLv3", fill=(255, 255, 255, 2))
        except Exception:
            pass
        by = io.BytesIO()
        img.save(by, format="PNG")
        by.seek(0)
        by.name = "banner.png"
        return by

    def vertical(self):
        W, H = 1000, 1500
        padding = 80
        cover_size = 800
        title_font = self._get_font(60, self.font_bytes)
        artist_font = self._get_font(45, self.font_bytes)
        time_font = self._get_font(35, self.font_bytes)
        img = self._prepare_background(W, H)
        draw = ImageDraw.Draw(img)
        cover = self._prepare_cover(cover_size, 40)
        cover_x = (W - cover_size) // 2
        cover_y = 120
        img.paste(cover, (cover_x, cover_y), cover)
        text_area_y = cover_y + cover_size + 120
        text_width_limit = W - (padding * 2)
        wrapper = textwrap.TextWrapper(width=23)
        title_lines = wrapper.wrap(self.title)
        if len(title_lines) > 2:
            title_lines = title_lines[:2]
            title_lines[-1] += "..."
        current_y = text_area_y
        title_height = title_font.getbbox("Ah")[3] + 15
        for line in title_lines:
            w = title_font.getlength(line)
            draw.text(((W - w) / 2, current_y), line, font=title_font, fill="white")
            current_y += title_height
        display_artist = self.artists
        while artist_font.getlength(display_artist) > text_width_limit and len(display_artist) > 0:
            display_artist = display_artist[:-1]
        if len(display_artist) < len(self.artists):
            display_artist += "…"
        artist_w = artist_font.getlength(display_artist)
        draw.text(((W - artist_w) / 2, current_y + 15), display_artist, font=artist_font, fill="#b3b3b3")
        bar_y = text_area_y + 260
        if len(title_lines) > 1:
            bar_y += 60
        bar_h = 8
        bar_w = W - (padding * 2)
        prog_pct = self.progress / self.duration if self.duration > 0 else 0
        self._draw_progress_bar(draw, padding, bar_y, bar_w, bar_h, prog_pct, color=self.accent, bg_color="#6b6b6b")
        cur_time = f"{(self.progress//1000//60):02}:{(self.progress//1000%60):02}"
        dur_time = f"{(self.duration//1000//60):02}:{(self.duration//1000%60):02}"
        draw.text((padding, bar_y + 40), cur_time, font=time_font, fill="white")
        dur_w = time_font.getlength(dur_time)
        draw.text((W - padding - dur_w, bar_y + 40), dur_time, font=time_font, fill="white")
        try:
            draw.text((10, 10), "Core by @samsepi0l_ovf - AGPLv3", fill=(255, 255, 255, 2))
        except Exception:
            pass
        by = io.BytesIO()
        img.save(by, format="PNG")
        by.seek(0)
        by.name = "banner.png"
        return by


def _cleanup_cache():
    if len(SEARCH_CACHE) > 30:
        for k in list(SEARCH_CACHE.keys())[:-20]:
            SEARCH_CACHE.pop(k, None)


def _get_base_dlp_args():
    return [
        sys.executable, "-m", "yt_dlp",
        "--socket-timeout", "12",
        "--no-warnings", "--ignore-errors",
        "--extractor-retries", "2",
        "--retries", "2",
        "--fragment-retries", "2",
        "--concurrent-fragments", "8",
    ]


def _get_playlists(ctx):
    playlists = ctx.state.get("playlists", {"History": [], "Favs": []})
    if not isinstance(playlists, dict):
        playlists = {"History": [], "Favs": []}
    playlists.setdefault("History", [])
    playlists.setdefault("Favs", [])
    return playlists


def _set_playlists(ctx, playlists):
    playlists.setdefault("History", [])
    playlists.setdefault("Favs", [])
    ctx.state.set("playlists", playlists)


def _get_track_paths(track_id):
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", str(track_id)):
        raise ValueError("Invalid track ID")
    return {
        "audio": os.path.join(STORAGE_DIR, f"{track_id}.mp3"),
        "thumb": os.path.join(STORAGE_DIR, f"{track_id}.jpg"),
        "banner": os.path.join(STORAGE_DIR, f"{track_id}_banner.png"),
        "meta": os.path.join(STORAGE_DIR, f"{track_id}.json"),
    }


def _read_json_file(path):
    if not os.path.exists(path):
        return None
    try:
        with open(path, "r", encoding="utf-8") as file_obj:
            return json.load(file_obj)
    except Exception:
        return None


def _write_json_file(path, payload):
    temp_path = f"{path}.tmp"
    with open(temp_path, "w", encoding="utf-8") as file_obj:
        json.dump(payload, file_obj, ensure_ascii=False, indent=2)
    os.replace(temp_path, path)


def _normalize_track(raw, source=None):
    raw = dict(raw or {})
    track_id = str(raw.get("id") or "").strip()
    if not track_id or not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", track_id):
        return {}
    uploader = (
        raw.get("uploader")
        or raw.get("channel")
        or raw.get("artist")
        or raw.get("creator")
        or (raw.get("user") or {}).get("username")
        or (raw.get("publisher_metadata") or {}).get("artist")
        or "Unknown"
    )
    normalized = {
        "id": track_id,
        "title": (raw.get("title") or "Unknown").strip() or "Unknown",
        "uploader": str(uploader).strip() or "Unknown",
        "duration": int(raw.get("duration") or 0),
        "source": source or raw.get("source") or "sc",
        "_ovf_sign": raw.get("_ovf_sign") or "https://github.com/sepiol026-wq/",
    }
    for key in ("channel", "artist", "thumbnail", "thumbnails", "webpage_url", "artwork_url", "user", "publisher_metadata"):
        if raw.get(key):
            normalized[key] = raw.get(key)
    return normalized


def _extract_cover_url(track_info, meta=None):
    candidates = []
    for source in (track_info or {}, meta or {}):
        for key in ("artwork_url", "thumbnail", "thumbnail_url", "avatar_url"):
            thumb = source.get(key)
            if thumb:
                candidates.append(thumb)
        thumbs = source.get("thumbnails") or []
        if isinstance(thumbs, list):
            for item in thumbs:
                if isinstance(item, dict) and item.get("url"):
                    candidates.append(item["url"])
    for candidate in reversed(candidates):
        if candidate:
            return candidate
    return "https://via.placeholder.com/800"


async def _get_font_bytes(ctx):
    font_url = ctx.config.get("font", "https://raw.githubusercontent.com/kamekuro/assets/master/fonts/Onest-Bold.ttf")
    if FONT_CACHE["url"] == font_url and FONT_CACHE["bytes"]:
        return FONT_CACHE["bytes"]
    font_bytes = await _fetch_bytes(ctx, font_url)
    FONT_CACHE["url"] = font_url
    FONT_CACHE["bytes"] = font_bytes
    return font_bytes


async def _ensure_visual_assets(ctx, track_info, duration_sec, paths, meta=None):
    if not HAS_PIL:
        return
    if os.path.exists(paths["thumb"]) and os.path.exists(paths["banner"]):
        return
    if os.path.exists(paths["thumb"]):
        with open(paths["thumb"], "rb") as file_obj:
            cover_bytes = file_obj.read()
    else:
        cover_url = _extract_cover_url(track_info, meta)
        try:
            cover_bytes = await _fetch_bytes(ctx, cover_url)
        except Exception:
            return
        with open(paths["thumb"], "wb") as file_obj:
            file_obj.write(cover_bytes)
    font_bytes = await _get_font_bytes(ctx)
    banners = Banners(
        title=track_info.get("title", "Unknown"),
        artists=track_info.get("uploader") or track_info.get("channel") or "Unknown",
        duration=duration_sec * 1000,
        progress=0,
        track_cover=cover_bytes,
        font_bytes=font_bytes,
        blur=int(ctx.config.get("blur_intensity", 40)),
        dynamic_color=bool(ctx.config.get("dynamic_colors", True)),
    )
    banner_file = (
        banners.vertical()
        if ctx.config.get("banner_version", "horizontal") == "vertical"
        else banners.horizontal()
    )
    with open(paths["banner"], "wb") as file_obj:
        file_obj.write(banner_file.read())


async def _get_client_id(ctx, html):
    m = re.findall(r'https://[a-v0-9]+\.sndcdn\.com/[a-zA-Z0-9_-]+\.js', html)
    for script_url in reversed(m):
        try:
            r = await _net_get(ctx, script_url, timeout=12)
            body = r["body"] or ""
            cm = re.search(r'client_id\s*[:=]\s*"([a-zA-Z0-9]{32})"', body)
            if cm:
                return cm.group(1)
        except Exception:
            continue
    raise ValueError("client_id not found")


async def _download_soundcloud_track(ctx, track_url, out_path):
    r = await _net_get(ctx, track_url)
    if r["status"] != 200:
        raise ValueError("SoundCloud page not reachable")
    html = r["body"] or ""
    c_id = await _get_client_id(ctx, html)
    h_m = re.search(r'window\.__sc_hydration\s*=\s*(\[.*?\]);</script>', html)
    if not h_m:
        raise ValueError("No hydration payload")
    payload = json.loads(h_m.group(1))
    t_d = next((i.get("data") for i in payload if i.get("hydratable") == "sound"), None)
    if not t_d or t_d.get("kind") != "track":
        raise ValueError("Not a track")
    art = t_d.get("artwork_url") or (t_d.get("user") or {}).get("avatar_url")
    if art:
        art = art.replace("-large.jpg", "-t500x500.jpg")
    tr = (t_d.get("media") or {}).get("transcodings", [])
    if not tr:
        raise ValueError("No transcodings")
    s_info = next((t for t in tr if (t.get("format") or {}).get("protocol") == "progressive"), tr[0])
    auth = f"&track_authorization={t_d.get('track_authorization')}" if t_d.get("track_authorization") else ""
    s_url = s_info.get("url") + f"?client_id={c_id}" + auth
    s_resp = await _net_get(ctx, s_url)
    if s_resp["status"] != 200:
        raise ValueError("Stream metadata failed")
    s_json = json.loads(s_resp["body"])
    media_url = s_json.get("url")
    if not media_url:
        raise ValueError("No stream url")
    protocol = (s_info.get("format") or {}).get("protocol")
    if protocol == "progressive":
        m_resp = await _net_get(ctx, media_url, timeout=60, binary=True)
        if m_resp["status"] != 200:
            raise ValueError("Audio download failed")
        import base64
        data = base64.b64decode(m_resp["body"], validate=True)
        with open(out_path, "wb") as file_obj:
            file_obj.write(data)
    else:
        m3_resp = await _net_get(ctx, media_url)
        if m3_resp["status"] != 200:
            raise ValueError("Playlist download failed")
        chunks = [l.strip() for l in (m3_resp["body"] or "").splitlines() if l and not l.startswith("#")]
        if not chunks:
            raise ValueError("Empty HLS playlist")
        base_url = media_url.rsplit("/", 1)[0] + "/"
        sem = asyncio.Semaphore(10)

        async def _fetch_segment(url, index):
            if not url.startswith("http"):
                url = base_url + url
            async with sem:
                resp = await _net_get(ctx, url, timeout=30, binary=True)
                if resp["status"] != 200:
                    raise ValueError(f"Segment {index} failed")
                import base64
                data = base64.b64decode(resp["body"], validate=True)
                return index, data

        segments = await asyncio.gather(*[_fetch_segment(u, i) for i, u in enumerate(chunks)])
        segments.sort(key=lambda x: x[0])
        with open(out_path, "wb") as file_obj:
            for _, data in segments:
                file_obj.write(data)
    return {
        "id": str(t_d.get("id") or ""),
        "title": t_d.get("title") or "Unknown",
        "uploader": (
            (t_d.get("user") or {}).get("username")
            or (t_d.get("publisher_metadata") or {}).get("artist")
            or (t_d.get("user") or {}).get("full_name")
            or "Unknown"
        ),
        "duration": int(t_d.get("duration") or 0) // 1000,
        "thumbnail": art,
        "webpage_url": track_url,
        "source": "sc",
    }


async def _run_proc(ctx, cmd, timeout=60):
    import shlex
    cmd = list(cmd)
    dependency_path = os.path.abspath(".media-deps")
    if cmd[:3] == [sys.executable, "-m", "yt_dlp"]:
        import yt_dlp
        source = os.path.dirname(yt_dlp.__file__)
        destination = os.path.join(dependency_path, "yt_dlp")
        if not os.path.exists(destination):
            os.makedirs(dependency_path, exist_ok=True)
            shutil.copytree(source, destination)
        cmd[0] = "/usr/bin/python3" if os.path.exists("/usr/bin/python3") else sys.executable
    for index, argument in enumerate(cmd):
        if (index and cmd[index - 1] == "--ffmpeg-location") or (index == 0 and "ffmpeg" in os.path.basename(str(argument))):
            if os.path.exists("/usr/bin/ffmpeg"):
                cmd[index] = "/usr/bin/ffmpeg"
            elif os.path.isfile(argument):
                target = os.path.abspath(".media-ffmpeg")
                if not os.path.exists(target):
                    shutil.copy2(argument, target)
                cmd[index] = target
    job = await ctx.cap("shell", {"op": "start", "command": "PYTHONPATH=" + shlex.quote(dependency_path) + " " + " ".join(shlex.quote(str(arg)) for arg in cmd), "timeout": timeout})
    try:
        while True:
            state = await ctx.cap("shell", {"op": "poll", "id": job["id"], "wait": 1})
            if state.get("done"):
                result = state.get("result") or {}
                if state.get("error"):
                    return -1, b"", str(state["error"]).encode()
                return result.get("returncode", -1), (result.get("stdout") or "").encode(), (result.get("stderr") or "").encode()
    finally:
        await ctx.cap("shell", {"op": "forget", "id": job["id"]})


def _parse_sc_error(ctx, stderr_bytes):
    text = stderr_bytes.decode('utf-8', errors='ignore').lower()
    if "timeout" in text or "timeouterror" in text:
        return _t(ctx, "err_timeout")
    if "403" in text:
        return _t(ctx, "err_403")
    if any(e in text for e in ["name or service not known", "unreachable", "connection reset"]):
        return _t(ctx, "err_conn")
    if "sign in" in text or "captcha" in text:
        return _t(ctx, "err_auth")
    return _t(ctx, "err_unknown")


def _time_to_sec(t_str):
    parts = t_str.split(":")
    if len(parts) == 2:
        return int(parts[0]) * 60 + int(parts[1])
    elif len(parts) == 3:
        return int(parts[0]) * 3600 + int(parts[1]) * 60 + int(parts[2])
    return 0


def _ffmpeg_path():
    try:
        import imageio_ffmpeg
        return imageio_ffmpeg.get_ffmpeg_exe()
    except Exception:
        return shutil.which("ffmpeg") or "ffmpeg"


async def _ensure_soundcloud_track_cached(ctx, track_info):
    os.makedirs(STORAGE_DIR, exist_ok=True)
    track_info = _normalize_track(track_info, source="sc")
    track_id = track_info["id"]
    paths = _get_track_paths(track_id)
    meta = _read_json_file(paths["meta"]) or {}
    duration_sec = int(track_info.get("duration") or meta.get("duration") or 0)
    if os.path.exists(paths["audio"]):
        await _ensure_visual_assets(ctx, track_info, duration_sec, paths, meta=meta)
        return paths, meta

    dl_dir = tempfile.mkdtemp(prefix="scmusic_cache_", dir=".")
    try:
        track_url = (
            track_info.get("webpage_url")
            or track_info.get("url")
            or track_info.get("original_url")
            or track_info.get("permalink_url")
            or ""
        )
        if not track_url:
            uploader = track_info.get("uploader") or "unknown"
            track_url = f"https://soundcloud.com/{uploader}/{track_id}"
        mp3_path = os.path.join(dl_dir, f"{track_id}.mp3")
        try:
            meta = await _download_soundcloud_track(ctx, track_url, mp3_path)
        except Exception:
            ffmpeg = _ffmpeg_path()
            cmd = _get_base_dlp_args() + [
                "--format", "bestaudio/best",
                "-x", "--audio-format", "mp3",
                "--audio-quality", "0",
                "--ffmpeg-location", ffmpeg,
                "--embed-thumbnail", "--embed-metadata",
                "--write-info-json",
                "-o", f"{dl_dir}/%(id)s.%(ext)s",
                track_url,
            ]
            returncode, stdout, stderr = await _run_proc(ctx, cmd, timeout=180)
            if returncode != 0 or not os.path.exists(mp3_path):
                raise RuntimeError(_parse_sc_error(ctx, stderr))
            info_path = os.path.join(dl_dir, f"{track_id}.info.json")
            info = _read_json_file(info_path) or {}
            duration_sec = int(
                track_info.get("duration") or info.get("duration") or duration_sec or 0
            )
            meta = {
                "id": track_id,
                "title": track_info.get("title") or info.get("title") or "Unknown",
                "uploader": track_info.get("uploader")
                or info.get("uploader")
                or info.get("channel")
                or info.get("creator")
                or "Unknown",
                "duration": duration_sec,
                "thumbnail": _extract_cover_url(track_info, info),
                "fetched_at": int(time.time()),
                "source": "sc",
                "stdout_size": len(stdout or b""),
                "webpage_url": track_url,
            }
        shutil.copy(mp3_path, paths["audio"])
        _write_json_file(paths["meta"], meta)
        await _ensure_visual_assets(ctx, {**track_info, **meta}, duration_sec, paths, meta=meta)
        return paths, meta
    finally:
        shutil.rmtree(dl_dir, ignore_errors=True)


async def _search_tracks(ctx, query, limit=5):
    cmd = _get_base_dlp_args() + ["--dump-json", f"scsearch{limit}:{query}"]
    returncode, stdout, stderr = await _run_proc(ctx, cmd, timeout=45)
    results = []
    if stdout:
        for line in stdout.decode('utf-8', errors='ignore').split('\n'):
            if not line.strip():
                continue
            try:
                track = _normalize_track(json.loads(line), source="sc")
                if track:
                    results.append(track)
            except json.JSONDecodeError:
                pass
    return results


async def _dl_and_send(ctx, call_or_msg, track_info, target_chat_id):
    track_info = _normalize_track(track_info, source=track_info.get("source", "sc"))
    track_id = str(track_info.get("id"))
    source = track_info.get("source", "sc")
    track_title = track_info.get("title", "Unknown")
    track_artist = track_info.get("uploader") or track_info.get("channel") or "Unknown Artist"
    duration_sec = track_info.get("duration", 0)
    paths = _get_track_paths(track_id)
    audio_path = paths["audio"]

    if source == "tg":
        if not os.path.exists(audio_path):
            await ctx.respond(_t(ctx, "cache_missing"), parse_mode="HTML")
            return
        with open(audio_path, "rb") as f:
            await ctx.reply_audio(f.read(), title=track_title, performer=track_artist, caption=_t(ctx, "local_db", title=_esc(track_title)))
        with contextlib.suppress(Exception):
            await ctx.delete()
        return

    sc_url = (
        track_info.get("webpage_url")
        or track_info.get("url")
        or track_info.get("permalink_url")
        or f"https://soundcloud.com/{track_info.get('uploader', 'unknown')}/{track_id}"
    )
    try:
        paths, meta = await _ensure_soundcloud_track_cached(ctx, track_info)
    except asyncio.CancelledError:
        raise
    except Exception as e:
        err_text = _t(ctx, "dump_error", err=_esc(str(e)[:160]))
        await ctx.respond(err_text, parse_mode="HTML")
        return

    audio_path = paths["audio"]
    banner_path = paths["banner"]
    track_title = meta.get("title") or track_title
    track_artist = meta.get("uploader") or track_artist
    duration_sec = int(meta.get("duration") or duration_sec or 0)

    sdata = {
        "track": _esc(track_title),
        "artists": _esc(track_artist),
        "duration": f"{duration_sec//60}:{duration_sec%60:02}",
        "sc_url": sc_url,
    }
    try:
        caption = ctx.config.get("custom_text", HOTARU["config_schema"]["custom_text"]["default"]).format(**sdata)
    except Exception:
        caption = HOTARU["config_schema"]["custom_text"]["default"].format(**sdata)

    with contextlib.suppress(Exception):
        await ctx.respond(_t(ctx, "upload"), parse_mode="HTML")

    if os.path.exists(banner_path):
        with open(banner_path, "rb") as f:
            with contextlib.suppress(Exception):
                await ctx.reply_photo(f.read(), caption="")
    with open(audio_path, "rb") as f:
        await ctx.reply_audio(f.read(), title=track_title, performer=track_artist, caption=caption)

    with contextlib.suppress(Exception):
        await ctx.delete()


async def _inline_search_dl(ctx, call, call_id, track_idx, target_chat_id):
    with contextlib.suppress(Exception):
        await ctx.respond(_t(ctx, "downloading"), parse_mode="HTML")
    results = SEARCH_CACHE.get(call_id)
    if not results or track_idx >= len(results):
        with contextlib.suppress(Exception):
            await ctx.respond(_t(ctx, "cache_stale"), parse_mode="HTML")
        return
    track_info = results[track_idx]
    await _dl_and_send(ctx, call, track_info, target_chat_id)
    SEARCH_CACHE.pop(call_id, None)


def _search_buttons(ctx, results, call_id, target_chat_id):
    keyboard = []
    for idx, track in enumerate(results):
        title = track.get("title", "Unknown")[:30]
        artist = (track.get("uploader") or track.get("channel") or "Unknown")[:15]

        async def cb(call, payload):
            await _inline_search_dl(ctx, call, payload['_cid'], payload['_i'], payload['_chat'])

        keyboard.append([_btn(ctx, f"{title} — {artist}", cb, {'_cid': call_id, '_i': idx, '_chat': target_chat_id})])
    return keyboard


async def _inline_pl_view(ctx, call, pl_name, target_chat_id):
    playlists = _get_playlists(ctx)
    tracks = playlists.get(pl_name, [])
    text = _t(ctx, "pl_view", pl=_esc(pl_name), count=len(tracks))
    keyboard = []

    for idx, t in enumerate(tracks[:15]):
        title = t.get("title", "Unknown")[:25]

        async def play(call, payload):
            await _inline_pl_play(ctx, call, payload['_pl'], payload['_i'], payload['_chat'])

        row = [_btn(ctx, _t(ctx, "btn_play", title=title), play, {'_pl': pl_name, '_i': idx, '_chat': target_chat_id})]
        if pl_name != "History":
            async def trim(call, payload):
                await _inline_trim_req(ctx, call, payload['_pl'], payload['_i'], payload['_chat'])

            async def rm(call, payload):
                await _inline_rm_track(ctx, call, payload['_pl'], payload['_i'], payload['_chat'])

            row.append(_btn(ctx, _t(ctx, "btn_trim"), trim, {'_pl': pl_name, '_i': idx, '_chat': target_chat_id}))
            row.append(_btn(ctx, _t(ctx, "btn_del"), rm, {'_pl': pl_name, '_i': idx, '_chat': target_chat_id}))
        keyboard.append(row)

    admin_row = []
    if pl_name != "History":
        async def ren(call, payload):
            await _inline_pl_rename_req(ctx, call, payload['_pl'], payload['_chat'])

        async def dele(call, payload):
            await _inline_pl_delete(ctx, call, payload['_pl'], payload['_chat'])

        admin_row.append(_btn(ctx, _t(ctx, "btn_rename"), ren, {'_pl': pl_name, '_chat': target_chat_id}))
        admin_row.append(_btn(ctx, _t(ctx, "btn_del_db"), dele, {'_pl': pl_name, '_chat': target_chat_id}))
    if admin_row:
        keyboard.append(admin_row)

    async def back(call, payload):
        await _inline_pl_back(ctx, call, payload['_chat'])

    keyboard.append([_btn(ctx, _t(ctx, "btn_back"), back, {'_chat': target_chat_id})])
    with contextlib.suppress(Exception):
        await ctx.respond(text, buttons=keyboard, parse_mode="HTML")


async def _inline_trim_req(ctx, call, pl_name, track_idx, target_chat_id):
    TRIM_STATE[target_chat_id] = {"pl_name": pl_name, "track_idx": track_idx}
    with contextlib.suppress(Exception):
        await ctx.respond(_t(ctx, "trim_hint"), parse_mode="HTML")


async def _inline_pl_rename_req(ctx, call, pl_name, target_chat_id):
    RENAME_STATE[target_chat_id] = {"pl_name": pl_name}
    with contextlib.suppress(Exception):
        await ctx.respond(_t(ctx, "rename_hint", pl=_esc(pl_name)), parse_mode="HTML")


async def _inline_pl_delete(ctx, call, pl_name, target_chat_id):
    playlists = _get_playlists(ctx)
    if pl_name in playlists and pl_name != "History":
        del playlists[pl_name]
        _set_playlists(ctx, playlists)
        await ctx.respond(_t(ctx, "pl_deleted", pl=_esc(pl_name)), parse_mode="HTML")
        await _inline_pl_back(ctx, call, target_chat_id)
    else:
        await ctx.respond(_t(ctx, "pl_del_err"), parse_mode="HTML")


async def _inline_rm_track(ctx, call, pl_name, track_idx, target_chat_id):
    playlists = _get_playlists(ctx)
    if pl_name in playlists and track_idx < len(playlists[pl_name]):
        track = playlists[pl_name].pop(track_idx)
        _set_playlists(ctx, playlists)
        await ctx.respond(_t(ctx, "track_removed", title=_esc(track.get('title', 'Unknown'))), parse_mode="HTML")
        await _inline_pl_view(ctx, call, pl_name, target_chat_id)
    else:
        await ctx.respond(_t(ctx, "pl_del_err"), parse_mode="HTML")


async def _inline_pl_back(ctx, call, target_chat_id):
    playlists = _get_playlists(ctx)
    keyboard = []
    for pl_name, tracks in playlists.items():
        async def view(call, payload):
            await _inline_pl_view(ctx, call, payload['_pl'], payload['_chat'])

        keyboard.append([_btn(ctx, f"📁 {pl_name} [{len(tracks)}]", view, {'_pl': pl_name, '_chat': target_chat_id})])
    with contextlib.suppress(Exception):
        await ctx.respond(_t(ctx, "pl_list"), buttons=keyboard, parse_mode="HTML")


async def _inline_pl_play(ctx, call, pl_name, track_idx, target_chat_id):
    playlists = _get_playlists(ctx)
    if pl_name not in playlists or track_idx >= len(playlists[pl_name]):
        with contextlib.suppress(Exception):
            await ctx.respond(_t(ctx, "pl_unavail"), parse_mode="HTML")
        return
    track_info = playlists[pl_name][track_idx]
    if pl_name != "History":
        history = playlists.get("History", [])
        history.insert(0, track_info)
        seen = set()
        new_history = []
        for t in history:
            if t.get("id") not in seen:
                new_history.append(t)
                seen.add(t.get("id"))
        playlists["History"] = new_history[:20]
        _set_playlists(ctx, playlists)
    with contextlib.suppress(Exception):
        await ctx.respond(_t(ctx, "downloading"), parse_mode="HTML")
    await _dl_and_send(ctx, call, track_info, target_chat_id)


async def watcher_global(ctx, invocation):
    message = ctx.message
    text = ctx._msg.get("text") or ctx._msg.get("message")
    if not text or not isinstance(text, str) or not message.out:
        return
    chat_id = ctx.chat_id

    if chat_id in RENAME_STATE:
        old_name = RENAME_STATE[chat_id]["pl_name"]
        new_name = text.strip()
        del RENAME_STATE[chat_id]
        playlists = _get_playlists(ctx)
        if old_name in playlists:
            if new_name in playlists:
                await ctx.respond(_t(ctx, "pl_exists", name=_esc(new_name)), parse_mode="HTML")
                return
            playlists[new_name] = playlists.pop(old_name)
            _set_playlists(ctx, playlists)
            await ctx.delete()
            await ctx.respond(_t(ctx, "pl_renamed", old=_esc(old_name), new=_esc(new_name)), parse_mode="HTML")
        return

    if chat_id in TRIM_STATE:
        match = re.match(r"^(\d{1,2}:\d{2})\s*-\s*(\d{1,2}:\d{2})$", text.strip())
        if not match:
            return
        state = TRIM_STATE.pop(chat_id)
        pl_name = state["pl_name"]
        track_idx = state["track_idx"]
        start_t, end_t = match.groups()
        playlists = _get_playlists(ctx)
        if pl_name not in playlists or track_idx >= len(playlists[pl_name]):
            return await ctx.respond(_t(ctx, "trim_gone"), parse_mode="HTML")
        track = playlists[pl_name][track_idx]
        track_id = track.get("id")
        in_path = os.path.join(STORAGE_DIR, f"{track_id}.mp3")
        out_path = os.path.join(STORAGE_DIR, f"{track_id}_cut.mp3")
        if not os.path.exists(in_path):
            return await ctx.respond(_t(ctx, "trim_nofile"), parse_mode="HTML")
        await ctx.respond(_t(ctx, "trim_cut"), parse_mode="HTML")
        cmd = [
            _ffmpeg_path(), "-y", "-i", in_path,
            "-ss", start_t, "-to", end_t,
            "-map", "0:a", "-map", "0:v?", "-c:v", "copy",
            "-c:a", "libmp3lame", "-q:a", "2", out_path
        ]
        ret, _, _ = await _run_proc(ctx, cmd, timeout=60)
        if ret != 0 or not os.path.exists(out_path):
            return await ctx.respond(_t(ctx, "trim_ffmpeg"), parse_mode="HTML")
        shutil.move(out_path, in_path)
        new_dur = _time_to_sec(end_t) - _time_to_sec(start_t)
        track["duration"] = new_dur if new_dur > 0 else track["duration"]
        playlists[pl_name][track_idx] = track
        _set_playlists(ctx, playlists)
        await ctx.respond(_t(ctx, "trim_ok"), parse_mode="HTML")


async def command_scexport(ctx, invocation=None):
    playlists = _get_playlists(ctx)
    if not playlists:
        return await ctx.respond(_t(ctx, "export_empty"), parse_mode="HTML")
    data = json.dumps(playlists, ensure_ascii=False, indent=4)
    await ctx.reply_file(data.encode("utf-8"), file_name="soundcloud_music_export.json", caption=_t(ctx, "export_cap"))
    await ctx.delete()


async def command_scimport(ctx, invocation=None):
    reply = await ctx.reply()
    attachment = ctx.reply_attachment
    if not attachment:
        return await ctx.respond(_t(ctx, "import_need"), parse_mode="HTML")
    try:
        downloaded = await ctx.download({"chat_id": ctx.chat_id, "id": reply["id"]})
        with open(downloaded, "rb") as handle:
            new_pl = json.load(handle)
        if not isinstance(new_pl, dict) or any(not isinstance(k, str) or not isinstance(v, list) or any(not isinstance(t, dict) for t in v) for k, v in new_pl.items()):
            raise ValueError("Invalid playlist document")
        playlists = _get_playlists(ctx)
        for name, tracks in new_pl.items():
            if name not in playlists:
                playlists[name] = []
            for t in tracks:
                normalized = _normalize_track(t, source=t.get("source"))
                if normalized and not any(ext.get("id") == normalized.get("id") for ext in playlists[name]):
                    playlists[name].append(normalized)
        _set_playlists(ctx, playlists)
        await ctx.respond(_t(ctx, "import_ok"), parse_mode="HTML")
    except Exception as e:
        await ctx.respond(_t(ctx, "import_err", err=_esc(str(e))), parse_mode="HTML")


async def command_scbatch(ctx, invocation):
    args = invocation.raw_args
    if not args or " " not in args:
        return await ctx.respond(_t(ctx, "batch_fmt"), parse_mode="HTML")
    pl_name, url = args.split(" ", 1)
    await ctx.respond(_t(ctx, "batch_parsing"), parse_mode="HTML")
    cmd = _get_base_dlp_args() + ["--flat-playlist", "--dump-json", url]
    ret, stdout, _ = await _run_proc(ctx, cmd, timeout=120)
    if not stdout:
        return await ctx.respond(_t(ctx, "batch_none"), parse_mode="HTML")
    playlists = _get_playlists(ctx)
    if pl_name not in playlists:
        playlists[pl_name] = []
    count = 0
    for line in stdout.decode('utf-8', errors='ignore').split('\n'):
        if not line.strip():
            continue
        try:
            data = json.loads(line)
            track = _normalize_track(data, source="sc")
            if not track:
                continue
            if not any(t.get("id") == str(track["id"]) for t in playlists[pl_name]):
                playlists[pl_name].append(track)
                count += 1
        except Exception:
            pass
    _set_playlists(ctx, playlists)
    await ctx.respond(_t(ctx, "batch_done", count=count, pl=_esc(pl_name)), parse_mode="HTML")


async def command_sc(ctx, invocation):
    args = invocation.raw_args
    if not args:
        return await ctx.respond(_t(ctx, "no_query"), parse_mode="HTML")
    if args.strip() == "/_scm_diag":
        return await ctx.respond(_t(ctx, "diag"), parse_mode="HTML")
    await ctx.respond(_t(ctx, "searching"), parse_mode="HTML")
    results = await _search_tracks(ctx, args)
    if not results:
        return await ctx.respond(_t(ctx, "no_tracks"), parse_mode="HTML")
    call_id = str(ctx.message.id)
    target_chat_id = ctx.chat_id
    SEARCH_CACHE[call_id] = results
    _cleanup_cache()
    keyboard = _search_buttons(ctx, results, call_id, target_chat_id)
    await ctx.respond(
        _t(ctx, "search_results", query=_esc(args)),
        buttons=keyboard,
        parse_mode="HTML",
    )


async def command_scpl(ctx, invocation=None):
    target_chat_id = ctx.chat_id
    playlists = _get_playlists(ctx)
    _set_playlists(ctx, playlists)
    keyboard = []
    for pl_name, tracks in playlists.items():
        async def view(call, payload):
            await _inline_pl_view(ctx, call, payload['_pl'], payload['_chat'])

        keyboard.append([_btn(ctx, f"📁 {pl_name} [{len(tracks)}]", view, {'_pl': pl_name, '_chat': target_chat_id})])
    await ctx.respond(_t(ctx, "pl_list"), buttons=keyboard, parse_mode="HTML")


async def command_scadd(ctx, invocation):
    args = invocation.raw_args
    reply = await ctx.reply()
    attachment = ctx.reply_attachment
    if not args:
        return await ctx.respond(_t(ctx, "add_fmt"), parse_mode="HTML")
    parts = args.split(" ", 1)
    pl_name = parts[0].strip()
    query = parts[1].strip() if len(parts) > 1 else ""
    playlists = _get_playlists(ctx)
    if pl_name not in playlists:
        playlists[pl_name] = []

    if reply and attachment:
        document = ((reply.get("media") or {}).get("document") or {})
        attributes = document.get("attributes") or []
        is_voice = any(isinstance(attr, dict) and attr.get("voice") for attr in attributes)
        mime = getattr(attachment, "mime_type", "") or ""
        if not is_voice and mime and mime not in ["audio/mpeg", "audio/ogg"]:
            return await ctx.respond(_t(ctx, "add_badfmt"), parse_mode="HTML")
        await ctx.respond(_t(ctx, "add_id3"), parse_mode="HTML")
        audio = document
        title = f"Voice {audio.get('id', reply['id'])}" if is_voice else "Unknown"
        artist = "Telegram User" if is_voice else "Unknown"
        duration = 0
        for attr in attributes:
            if isinstance(attr, dict) and str(attr.get("_", "")).lower() == "documentattributeaudio":
                title = attr.get("title") or title
                artist = attr.get("performer") or artist
                duration = attr.get("duration") or duration
        track_id = f"tg_{audio.get('id', reply['id'])}"
        if any(t.get("id") == track_id for t in playlists[pl_name]):
            return await ctx.respond(_t(ctx, "add_dup", pl=_esc(pl_name)), parse_mode="HTML")
        os.makedirs(STORAGE_DIR, exist_ok=True)
        storage_path = os.path.join(STORAGE_DIR, f"{track_id}.mp3")
        if not os.path.exists(storage_path):
            temp_raw_path = os.path.join(STORAGE_DIR, f"raw_{track_id}.bin")
            try:
                await ctx.download({"chat_id": ctx.chat_id, "id": reply["id"]}, destination=temp_raw_path)
                cmd = [
                    _ffmpeg_path(), "-y", "-i", temp_raw_path,
                    "-metadata", f"title={title}",
                    "-metadata", f"artist={artist}"
                ]
                if is_voice or mime == "audio/ogg":
                    cmd += ["-c:a", "libmp3lame", "-q:a", "2"]
                else:
                    cmd += ["-c", "copy"]
                cmd.append(storage_path)
                ret, _, _ = await _run_proc(ctx, cmd, timeout=60)
                if os.path.exists(temp_raw_path):
                    os.remove(temp_raw_path)
                if ret != 0:
                    return await ctx.respond(_t(ctx, "add_ffmpeg"), parse_mode="HTML")
            except Exception as e:
                return await ctx.respond(_t(ctx, "add_syserr", err=_esc(str(e)[:50])), parse_mode="HTML")
        track = {
            "id": track_id,
            "title": title,
            "uploader": artist,
            "duration": duration,
            "source": "tg",
            "_ovf_sign": "https://github.com/sepiol026-wq/",
        }
        playlists[pl_name].append(track)
        _set_playlists(ctx, playlists)
        return await ctx.respond(_t(ctx, "pl_added", pl=_esc(pl_name), track=_esc(title)), parse_mode="HTML")

    if not query:
        return await ctx.respond(_t(ctx, "no_query"), parse_mode="HTML")
    await ctx.respond(_t(ctx, "searching"), parse_mode="HTML")
    results = await _search_tracks(ctx, query, limit=1)
    if not results:
        return await ctx.respond(_t(ctx, "no_tracks"), parse_mode="HTML")
    track = _normalize_track(results[0], source="sc")
    if any(t.get("id") == str(track.get("id")) for t in playlists[pl_name]):
        return await ctx.respond(_t(ctx, "add_dup_title", pl=_esc(pl_name), title=_esc(track.get('title', ''))), parse_mode="HTML")
    playlists[pl_name].append(track)
    _set_playlists(ctx, playlists)
    await ctx.respond(_t(ctx, "pl_added", pl=_esc(pl_name), track=_esc(track.get('title', 'Unknown'))), parse_mode="HTML")


async def command_scrm(ctx, invocation):
    args = invocation.raw_args
    if not args or " " not in args:
        return await ctx.respond(_t(ctx, "rm_fmt"), parse_mode="HTML")
    pl_name, query = args.split(" ", 1)
    playlists = _get_playlists(ctx)
    if pl_name not in playlists or not playlists[pl_name]:
        return await ctx.respond(_t(ctx, "pl_empty"), parse_mode="HTML")
    original_len = len(playlists[pl_name])
    playlists[pl_name] = [t for t in playlists[pl_name] if query.lower() not in t.get("title", "").lower()]
    if len(playlists[pl_name]) == original_len:
        return await ctx.respond(_t(ctx, "rm_none"), parse_mode="HTML")
    _set_playlists(ctx, playlists)
    await ctx.respond(_t(ctx, "pl_removed", pl=_esc(pl_name), track=_esc(query)), parse_mode="HTML")
