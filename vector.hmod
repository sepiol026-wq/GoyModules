def norm_hash_name(ctx, value):
    log.debug('_norm_hash_name: value=%r', str(value)[:64] if value else '')
    value = unicodedata.normalize('NFKC', str(value or ''))
    value = value.replace('\u200b', '').replace('\u200c', '').replace('\u200d', '').replace('\ufeff', '')
    return ' '.join(value.strip().split())

def fmt_comments(ctx, comments, m_name, pg=0, pp=5):
    log.debug('_fmt_comments: name=%s count=%d pg=%d', m_name, len(comments) if comments else 0, pg)
    h = f"{ctx.t('vector.v_talk_hdr', '{emoji} <b>Thread: {name}</b>', emoji=EMOJI['comments'], name=m_name)}\n<b>{ctx.t('vector.v_talk_desc', 'Community reviews')}</b>\n<i>{ctx.t('vector.v_talk_num', 'Posts: {count}', count=len(comments))}</i>"
    if not comments:
        return f"{h}\n\n{ctx.t('vector.v_talk_0', 'Thread is empty. Be the first!')}"
    roots, chmap = ([], {})
    for c in comments:
        pid = c.get('parent_id')
        if pid:
            chmap.setdefault(str(pid), []).append(c)
        else:
            roots.append(c)
        if c.get('replies'):
            chmap.setdefault(str(c.get('id')), []).extend(c['replies'])
    total_pages = max(1, (len(roots) + pp - 1) // pp)
    pg = max(0, min(pg, total_pages - 1))
    start, end = (pg * pp, min((pg + 1) * pp, len(roots)))
    page_roots = roots[start:end]
    blks = [h]
    if total_pages > 1:
        blks.append(f"<i>{ctx.t('vector.v_page', '[{idx}/{total}]', idx=pg + 1, total=total_pages)}</i>")
    for r in page_roots:
        rid = str(r.get('id'))
        raw_uname = r.get('author_username')
        uname = (str(raw_uname).strip() if raw_uname else '').lstrip('@')
        meta = [f'@{html.escape(uname)}'] if uname else []
        ts = str(r.get('created_at') or '').replace('T', ' ').replace('Z', '').strip()
        if ts:
            meta.append(html.escape(ts))
        meta_str = f" <i>{' · '.join(meta)}</i>" if meta else ''
        edit_mark = ' *' if r.get('can_edit') else ''
        auth = f"<b>{html.escape(r.get('author_name') or r.get('author_username') or 'Unknown')}</b>{edit_mark}{meta_str}"
        blks.append(f"╭─ {auth}\n╰─\n<blockquote>{html.escape(str(r.get('body', '')))}</blockquote>")
        subs = chmap.get(rid, [])
        for s in subs:
            raw_s_uname = s.get('author_username')
            s_uname = (str(raw_s_uname).strip() if raw_s_uname else '').lstrip('@')
            s_meta = [f'@{html.escape(s_uname)}'] if s_uname else []
            s_ts = str(s.get('created_at') or '').replace('T', ' ').replace('Z', '').strip()
            if s_ts:
                s_meta.append(html.escape(s_ts))
            s_meta_str = f" <i>{' · '.join(s_meta)}</i>" if s_meta else ''
            s_edit_mark = ' *' if s.get('can_edit') else ''
            s_auth = f"<b>{html.escape(s.get('author_name') or s.get('author_username') or 'Unknown')}</b>{s_edit_mark}{s_meta_str}"
            blks.append(f"  {EMOJI['reply']} {s_auth}\n<blockquote>{html.escape(str(s.get('body', '')))}</blockquote>")
    return '\n\n'.join(blks)

def extract_counts(ctx, data):
    likes = dislikes = None
    for container in (data, data.get('module'), data.get('data'), data.get('result'), data.get('summary')):
        if not isinstance(container, dict):
            continue
        for lk in ('likes', 'likes_count', 'likesCount', 'likeCount', 'like_count'):
            v = container.get(lk)
            if v is not None:
                try:
                    likes = int(v)
                except (ValueError, TypeError):
                    pass
                break
        for dk in ('dislikes', 'dislikes_count', 'dislikesCount', 'dislikeCount', 'dislike_count'):
            v = container.get(dk)
            if v is not None:
                try:
                    dislikes = int(v)
                except (ValueError, TypeError):
                    pass
                break
        if likes is not None and dislikes is not None:
            break
    log.debug('_extract_counts: likes=%s dislikes=%s', likes, dislikes)
    return (likes, dislikes)

async def sync_via_ntp(ctx):
    for host in _ntp_hosts:
        offset = await ntp_query(ctx, host)
        if offset is not None:
            return offset
    return None

def build_html(ctx, m_data, current_idx, total_cnt):
    log.debug('_build_html: name=%s idx=%d/%d', m_data.get('name', '?'), current_idx, total_cnt)
    name = html.escape(str(m_data.get('name', 'Unknown')))
    author = html.escape(str(m_data.get('author', '@Unknown')))
    ver = str(m_data.get('version', '?.?.?'))
    blocks = []
    banner = str(m_data.get('banner') or '')
    if banner.startswith(('https://', 'http://')):
        banner = html.escape(banner).replace('"', '&quot;')
        blocks.append(f'<figure><img src="{banner}"/></figure>')
    blocks.append(f"<h1>{EMOJI['module']} {name}</h1>")
    status_text = ctx.t('vector.v_dev_ofc', 'official') if m_data.get('official') else ctx.t('vector.v_dev_unofc', 'unofficial')
    blocks.append(f"<p>{EMOJI['verified']} <b>{html.escape(status_text)}</b></p>")
    byline = f"{ctx.t('vector.v_dev_lbl', 'Author:')}: {author}"
    if ver != '?.?.?':
        byline += f' · <code>v{html.escape(ver)}</code>'
    blocks.append(f'<p>{byline}</p>')
    if total_cnt > 1:
        blocks.append(f"<p><i>{ctx.t('vector.v_page', '[{idx}/{total}]', idx=current_idx, total=total_cnt)}</i></p>")
    desc = str(m_data.get('description') or '').strip()
    if desc:
        desc_html = html.escape(desc).replace('\n', '<br>')
        blocks.append(f"<details><summary>{EMOJI['description']} {ctx.t('vector.v_info', 'Info:')}</summary><p>{desc_html}</p></details>")
    commands = m_data.get('commands', [])
    if commands:
        bot = 'bot'
        rows = []
        for command in commands:
            command_name = html.escape(str(command.get('name', '')))
            command_desc = html.escape(str(command.get('description', ''))).replace('\n', '<br>')
            if command.get('is_placeholder'):
                command_text = f'<code>{{{command_name}}}</code>'
            elif command.get('is_inline'):
                command_text = f'<code>@{html.escape(bot)} {command_name}</code>'
            else:
                command_text = f'<code>{str(ctx.prefix)}{command_name}</code>'
            rows.append(f"<li>{command_text}{(': ' + command_desc if command_desc else '')}</li>")
        blocks.append(f"<details><summary>{EMOJI['command']} {ctx.t('vector.v_cmds', 'Usage:')} ({len(commands)})</summary><ul>{''.join(rows)}</ul></details>")
    tags = m_data.get('tags', [])
    if tags:
        blocks.append(f"<details><summary>{EMOJI['tag']} {ctx.t('vector.v_tags', 'Tags')} ({len(tags)})</summary><p>{' · '.join((html.escape(str(tag)) for tag in tags))}</p></details>")
    dependencies = m_data.get('dependencies', [])
    if dependencies:
        blocks.append(f"<details><summary>{EMOJI['dependency']} {ctx.t('vector.v_deps', 'Dependencies')} ({len(dependencies)})</summary><ul>{''.join((f'<li><code>{html.escape(str(dependency))}</code></li>' for dependency in dependencies))}</ul></details>")
    return '\n'.join(blocks)

def now(ctx):
    return time.time() + clock['_time_offset']

def fmt_sec(ctx, m_name, payload):
    log.debug('_fmt_sec: name=%s has_check=%s', m_name, bool(payload.get('check')))
    payload = json.loads(json.dumps(payload), object_hook=lambda value: {key: html.escape(item, quote=False) if isinstance(item, str) else item for key, item in value.items()})
    chk = payload.get('check')
    qta = payload.get('quota') or (chk.get('quota') if chk else None) or {}
    if not chk:
        return f"{EMOJI['shield']} <b>{ctx.t('vector.v_aud_hdr', 'Code Audit: {name}', name=m_name)}</b>\n\n{EMOJI['warn']} {ctx.t('vector.v_aud_none', 'Not scanned yet. Takes 1 API slot.')}\n{EMOJI['quota']} <i>{ctx.t('vector.v_aud_left', 'Slots left: {remaining}/{limit}', remaining=qta.get('remaining', '?'), limit=qta.get('limit', '?'))}</i>"
    v = str(chk.get('verdict', 'unknown'))
    v_icon = EMOJI.get(v, EMOJI['shield'])
    static = chk.get('details', {}).get('static', {})
    fnds = static.get('findings', {})
    lines = [f"{v_icon} <b>{ctx.t('vector.v_aud_hdr', 'Code Audit: {name}', name=m_name)}</b>\n", f"{EMOJI['shield']} <b>{ctx.t('vector.v_aud_lvl', 'Threat Level')}:</b> <code>{chk.get('label', v)}</code> (<code>{chk.get('confidence', 0)}%</code>)"]
    if static.get('score', '?') != '?' or static.get('risk', 'unknown') != 'unknown':
        lines.append(f"{EMOJI['stats']} <b>{ctx.t('vector.v_aud_stat', 'Scanner Data')}:</b> risk <code>{static.get('risk', 'unknown')}</code>, score <code>{static.get('score', '?')}</code>")
    lines.append(f"{EMOJI['description']} <b>{ctx.t('vector.v_aud_out', 'Summary')}:</b>\n<blockquote expandable>{chk.get('summary', ctx.t('vector.v_aud_no_txt', 'No summary generated.'))}</blockquote>")
    f_blocks = []
    for hdr, key in [(ctx.t('vector.v_sig_crit', 'Critical'), 'critical'), (ctx.t('vector.v_sig_warn', 'Warnings'), 'warning'), (ctx.t('vector.v_sig_info', 'Notices'), 'info')]:
        arr = fnds.get(key, [])
        if arr:
            f_blocks.append(f'<b>{hdr}</b>: ' + ', '.join((x.get('title', '?') for x in arr)))
    if f_blocks:
        lines.append(f"{EMOJI['search']} <b>{ctx.t('vector.v_aud_sigs', 'Triggers')}:</b>\n<blockquote expandable>{chr(10).join(f_blocks)}</blockquote>")
    remaining = qta.get('remaining', '?')
    if remaining != '?':
        lines.append(f"{EMOJI['quota']} <i>{ctx.t('vector.v_aud_left', 'Slots left: {remaining}/{limit}', remaining=remaining, limit=qta.get('limit', '?'))}</i>")
    return '\n'.join(lines)

async def sync_via_https(ctx):
    for url in _http_time_hosts:
        with suppress(Exception):
            t0 = time.time()
            response = await ctx.net(url, method='HEAD', timeout=3)
            t1 = time.time()
            date_header = next((value for key, value in response.get('headers', {}).items() if key.lower() == 'date'), None)
            if date_header:
                srv_ts = parsedate_to_datetime(date_header).timestamp()
                rtt_half = max(0.0, (t1 - t0) / 2)
                offset = srv_ts + rtt_half - t1
                log.debug('_sync_via_https: url=%s offset=%.3fs', url, offset)
                return offset
    return None

def format_ban_notice(ctx, raw_text):
    log.debug('_format_ban_notice: raw_len=%d', len(raw_text) if raw_text else 0)
    txt = str(raw_text or '').strip()
    reason_match = brrx.search(txt)
    term_match = btrx.search(txt)
    reason_raw = reason_match.group(1).strip() if reason_match else ''
    term_raw = term_match.group(1).strip() if term_match else ''
    if not reason_raw or not term_raw:
        for line in txt.splitlines():
            if ':' not in line:
                continue
            key, value = line.split(':', 1)
            key_l = key.strip().lower()
            val = value.strip()
            if not reason_raw and key_l in {'причина', 'reason', '理由', 'grund', 'r3450n', 'weason', 'charge'}:
                reason_raw = val
            if not term_raw and key_l in {'срок', 'term', '期間', 'dauer', '73rm', 'tewm'}:
                term_raw = val
    reason = html.escape(reason_raw or '-')
    term = html.escape(term_raw or 'permanent')
    return ctx.t('vector.v_ban_notice', '⛔ <b>Vector access blocked.</b>\n<b>Reason:</b> <code>{reason}</code>\n<b>Term:</b> <code>{term}</code>', reason=reason, term=term)

def parse_jwt(ctx, token):
    log.debug('_parse_jwt: token len=%d', len(token) if token else 0)
    try:
        b64_part = token.split('.')[1]
        b64_part += '=' * (-len(b64_part) % 4)
        return json.loads(base64.urlsafe_b64decode(b64_part.encode()).decode())
    except Exception:
        return {}

async def ntp_query(ctx, host, timeout=1.5):
    stream = None
    try:
        stream = await ctx.stream('udp://' + host + ':123', timeout=timeout)
        t0 = time.time()
        await stream.send(base64.b64encode(b'\x1b' + 47 * b'\x00').decode(), binary=True)

        async def receive():
            while True:
                event = await stream.recv(timeout=timeout)
                if not event or event.get('event') in ('close', 'error'):
                    return None
                if event.get('event') == 'message':
                    return event
        event = await asyncio.wait_for(receive(), timeout)
        t1 = time.time()
        if not event:
            return None
        response = base64.b64decode(event['data']) if event.get('binary') else event['data'].encode()
        if len(response) < 48:
            return None
        secs, frac = struct.unpack('!II', response[40:48])
        return secs - _ntp_epoch_delta + frac / 2 ** 32 + max(0.0, (t1 - t0) / 2) - t1
    except Exception:
        return None
    finally:
        if stream:
            await stream.close()

def normalize_module(ctx, raw):
    log.debug('_normalize_module: name=%s version=%s', raw.get('name', '?'), raw.get('version', '?'))
    lang = detect_lang_suffix(ctx)
    db_suffix = {'en': '', 'ua': '_ua'}.get(lang, f'_{lang}')
    cmds = []
    for c in raw.get('commands') or []:
        if isinstance(c, dict):
            cmd_desc_key = f'desc{db_suffix}'
            cmd_desc = (c.get(cmd_desc_key) if cmd_desc_key != 'desc' else None) or c.get('description') or c.get('desc') or ''
            cmds.append({'name': c.get('name') or c.get('cmd') or '', 'description': cmd_desc, 'is_inline': bool(c.get('is_inline')), 'is_placeholder': bool(c.get('is_placeholder'))})
    dev = str(raw.get('developer') or raw.get('author') or '@Unknown')
    ioff = bool(raw.get('official') or raw.get('is_official') or raw.get('verified') or raw.get('is_verified') or raw.get('telegram_verified') or raw.get('official_developer') or raw.get('is_official_developer'))
    name = str(raw.get('name') or raw.get('class_name') or 'Unknown')
    locales = raw.get('locales')
    desc = raw.get('description') or ''
    if isinstance(locales, dict):
        loc_key = f'description{db_suffix}'
        loc_val = locales.get(loc_key)
        if isinstance(loc_val, str) and loc_val.strip():
            desc = loc_val
    return {'name': name, 'owner': raw.get('source_owner') or 'unknown', 'version': raw.get('version') or '?.?.?', 'author': dev, 'description': desc, 'commands': cmds, 'dependencies': [str(d) for d in raw.get('dependencies') or []], 'official': ioff, 'likes': int(raw.get('likes') or 0), 'dislikes': int(raw.get('dislikes') or 0), 'banner': raw.get('banner'), 'source_url': module_url(raw.get('source_owner', 'unknown'), name), 'tags': raw.get('tags') or [], 'dl_url': module_url(raw.get('source_owner', 'unknown'), name)}

async def ensure_time_synced(ctx, max_age=300.0, force=False):
    if not force and clock['_time_offset_ts'] and (time.time() - clock['_time_offset_ts'] < max_age):
        return
    if clock['_time_sync_lock'] is None:
        clock['_time_sync_lock'] = threading.Lock()
    while not clock['_time_sync_lock'].acquire(False):
        await asyncio.sleep(0.05)
    try:
        if not force and clock['_time_offset_ts'] and (time.time() - clock['_time_offset_ts'] < max_age):
            return
        source = 'ntp'
        offset = await sync_via_ntp(ctx)
        if offset is None:
            source = 'https'
            offset = await sync_via_https(ctx)
        if offset is None:
            log.warning('_ensure_time_synced: all external sources failed, keeping previous offset=%.3fs', clock['_time_offset'])
            clock['_time_offset_ts'] = time.time()
            return
        clock['_time_offset'] = offset
        clock['_time_offset_ts'] = time.time()
        log.info('_ensure_time_synced: offset=%.3fs source=%s', clock['_time_offset'], source)
    finally:
        clock['_time_sync_lock'].release()

def detect_lang_suffix(ctx):
    return {'ja': 'jp', 'uk': 'ua'}.get(ctx.i18n.language, ctx.i18n.language)


def platform_url(value):
    parsed = urlparse(urljoin(apirt + '/', value))
    query = dict(parse_qsl(parsed.query))
    query['platform'] = 'hotaru'
    return urlunparse(parsed._replace(query=urlencode(query)))


def module_url(owner, name):
    return platform_url('/modules/' + quote(str(owner), safe='') + '/' + quote(str(name), safe='') + '/source')


async def net_req(ctx, method, path, token='', params=None, json_data=None, as_bytes=False, timeout=None):
    headers = {'User-Agent': 'VectorHotaru/' + HOTARU['version']}
    if token:
        headers['Authorization'] = 'Bearer ' + token
    try:
        response = await ctx.net(platform_url(path), method=method, params={**(params or {}), 'platform': 'hotaru'}, json=json_data, headers=headers, timeout=timeout or (90 if path == '/api/search' else 15), binary=as_bytes)
        status = response.get('status', 0)
        if status >= 300 or response.get('truncated'):
            return None, status
        body = response.get('body', '')
        if as_bytes:
            return (base64.b64decode(body) if response.get('encoding') == 'base64' else str(body).encode()), status
        return (json.loads(body) if isinstance(body, str) else body), status
    except Exception as exc:
        log.warning('Vector %s %s: %s', method, path, exc)
        return None, -1


async def get_active_token(ctx, force=False):
    global _validated_token
    if force:
        ctx.state.delete('auth_token')
        _validated_token = ''
    await ensure_time_synced(ctx)
    while not _token_lock.acquire(False):
        await asyncio.sleep(0.05)
    try:
        cached = ctx.state.get('auth_token', '')
        if cached and parse_jwt(ctx, cached).get('exp', 0) - now(ctx) > 60:
            if _validated_token == cached:
                return cached
            result, status = await net_req(ctx, 'GET', '/api/search', token=cached, params={'q': 'vector', 'limit': 1})
            if status not in (401, 403) and result is not None:
                _validated_token = cached
                return cached
        info, status = await net_req(ctx, 'GET', '/api/tg-bot')
        username = str((info or {}).get('username', '')).strip().lstrip('@')
        if not username:
            ctx.state.set('ban_notice', ctx.t('vector.v_token_fail'))
            return ''
        me = await ctx.tg.call('users.getUsers', {'id': [{'_': 'inputUserSelf'}]})
        me = (me if isinstance(me, list) else me.get('users', []))[0]
        uid = str(me['id'])
        bot = await ctx.resolve(username)
        bot_id = int(bot.get('id') or bot.get('user_id') or 0)
        if bot_id:
            ctx.state.set('bot_id', bot_id)
        with suppress(Exception):
            await ctx.tg.call('contacts.unblock', {'id': username})
        for attempt in range(2):
            history = await ctx.chat_history(peer=username, limit=1)
            last = max((m.get('id', 0) for m in history.get('messages', [])), default=0)
            stamp = int(now(ctx) // 10) - attempt
            digest = hashlib.sha256(f'vector-token-v2|{uid}|{stamp}|{auths}'.encode()).hexdigest()[:32]
            sent = await ctx.tg.call('messages.sendMessage', {'peer': username, 'message': '/' + digest, 'random_id': secrets.randbits(63)})
            sent_ids = [u['message']['id'] for u in (sent or {}).get('updates', []) if isinstance(u.get('message'), dict) and u['message'].get('id')]
            try:
                deadline = time.monotonic() + 10
                while time.monotonic() < deadline:
                    history = await ctx.chat_history(peer=username, min_id=last, limit=10)
                    for message in sorted(history.get('messages', []), key=lambda m: m.get('id', 0)):
                        if message.get('out') or message.get('id', 0) <= last:
                            continue
                        sender = message.get('from_id')
                        sender = sender.get('user_id') if isinstance(sender, dict) else sender
                        if bot_id and sender and int(sender) != bot_id:
                            continue
                        text = str(message.get('message') or message.get('text') or '')
                        match = jwtrx.search(text)
                        if match and str(parse_jwt(ctx, match.group()).get('sub')) == uid:
                            token = match.group()
                            ctx.state.set('auth_token', token)
                            ctx.state.set('ban_notice', '')
                            _validated_token = token
                            return token
                        if 'заблок' in text.lower() or '⛔' in text:
                            ctx.state.set('ban_notice', format_ban_notice(ctx, text))
                            return ''
                    await asyncio.sleep(0.4)
            finally:
                if sent_ids:
                    with suppress(Exception):
                        await ctx.tg.call('messages.deleteMessages', {'id': sent_ids, 'revoke': True})
        ctx.state.set('ban_notice', ctx.t('vector.v_token_fail'))
        return ''
    finally:
        _token_lock.release()


async def safe_install(ctx, name, url):
    try:
        token = await get_active_token(ctx)
        if not token:
            raise ValueError(ctx.state.get('ban_notice', '') or ctx.t('vector.v_err_api'))
        url = platform_url(url)
        parsed = urlparse(url)
        if parsed.scheme != 'https' or parsed.netloc != urlparse(apirt).netloc or not parsed.path.startswith('/modules/') or not parsed.path.endswith('/source'):
            raise ValueError('Expected a Vector Hotaru source endpoint')
        body, status = await net_req(ctx, 'GET', url, token=token, as_bytes=True)
        if status != 200 or not body:
            raise ValueError('Module download failed')
        source = body.decode('utf-8-sig')
        tree = ast.parse(source)
        first = tree.body[0] if tree.body else None
        if not isinstance(first, ast.Assign) or not any(isinstance(t, ast.Name) and t.id == 'HOTARU' for t in first.targets):
            raise ValueError('Not a native Hotaru .hmod')
        metadata = ast.literal_eval(first.value)
        module_id = metadata.get('id')
        if not isinstance(module_id, str) or not re.fullmatch('[a-z][a-z0-9_]{0,63}', module_id):
            raise ValueError('Invalid Hotaru module identity')
        if name.casefold() == 'vector' and module_id != 'vector':
            raise ValueError('Vector update identity mismatch')
        result = await ctx.modules.load(text=source)
        action = result.get('action', '')
        inventory = ctx.state.get('vector_inventory', {})
        inventory[module_id] = {'url': url, 'name': name, 'digest': hashlib.sha256(body).hexdigest(), 'pending': action == 'confirm'}
        if action == 'confirm':
            ctx.state.set('vector_inventory', inventory)
            upload = await ctx.upload_file(source.encode(), file_name=module_id + '.hmod')
            media = ctx.file_media(upload, file_name=module_id + '.hmod')
            await ctx.tg.call('messages.sendMedia', {'peer': ctx.chat_id, 'media': media, 'message': 'Hotaru capability approval required. Reply with ' + str(ctx.prefix) + 'ld to review requested permissions. No permissions were granted.', 'random_id': secrets.randbits(63)})
            return 'confirm', ', '.join(result.get('capabilities', []))
        if action not in ('loaded', 'reloaded', 'updated', 'installed', 'activated'):
            raise ValueError('Module activation: ' + action)
        ctx.state.set('vector_inventory', inventory)
        return 'ok', ''
    except Exception as exc:
        log.warning('Install %s failed: %s', name, exc)
        return 'error', str(exc)


async def show(ctx, text, rows=None):
    await ctx.screens.show({'text': text, 'rows': rows or [], 'rich': True})


def button(ctx, text, session, action, **values):
    return ctx.ui.button(text, 'vector_action', {'session': session, 'action': action, **values})


def save_session(ctx, value):
    key = secrets.token_urlsafe(12)
    value = {**value, 'language': ctx.i18n.language, 'config': dict(ctx.config), 'prefix': str(ctx.prefix), 'created': time.time()}
    ctx.state.set('menu:' + key, value)
    _sessions[key] = ctx
    return key


def card(ctx, key, state):
    group = state['group']
    idx = max(0, min(int(state.get('index', 0)), len(group) - 1))
    item = group[idx]
    source = module_url(item['owner'], item['name'])
    rows = [[{'text': ctx.t('vector.v_btn_copy'), 'copy_text': state['query']}, button(ctx, ctx.t('vector.v_btn_dl'), key, 'install'), {'text': ctx.t('vector.v_btn_code'), 'url': source}], [button(ctx, '👍 ' + str(item['likes']), key, 'like'), button(ctx, '👎 ' + str(item['dislikes']), key, 'dislike')]]
    if len(group) > 1:
        rows.append([button(ctx, '◀️', key, 'nav', index=(idx - 1) % len(group)), button(ctx, ctx.t('vector.v_page', idx=idx + 1, total=len(group)), key, 'list'), button(ctx, '▶️', key, 'nav', index=(idx + 1) % len(group))])
    rows.append([button(ctx, ctx.t('vector.v_btn_col' if state.get('expanded') else 'vector.v_btn_exp'), key, 'toggle')])
    if state.get('expanded'):
        rows.append([button(ctx, ctx.t('vector.v_btn_talk'), key, 'comments'), button(ctx, ctx.t('vector.v_btn_sec'), key, 'audit')])
    return build_html(ctx, item, idx + 1, len(group)), rows


async def command_vector(ctx, invocation):
    query = invocation.raw_args.strip()
    if not query:
        return await ctx.respond(ctx.t('vector.v_err_empty', p=html.escape(str(ctx.prefix))))
    if len(query) > 120:
        return await ctx.respond(ctx.t('vector.v_err_len'))
    await ctx.respond('<figure><img src="https://raw.githubusercontent.com/sepiol026-wq/GoyModules/refs/heads/main/assets/vsearch.png"/></figure>\n' + EMOJI['search'] + ' ' + ctx.t('vector.v_loading_ui'), rich=True)
    token = await get_active_token(ctx)
    if not token:
        return await ctx.respond(ctx.state.get('ban_notice', '') or ctx.t('vector.v_err_api'))
    result = None
    for attempt in range(2):
        result, status = await net_req(ctx, 'GET', '/api/search', token=token, params={'q': query, 'limit': ctx.config.get('limit', 30), 'lang': detect_lang_suffix(ctx)})
        if result is not None:
            break
        if status == 401:
            token = await get_active_token(ctx, force=True)
            if not token:
                break
    group = result.get('results', []) if isinstance(result, dict) else result or []
    group = [normalize_module(ctx, item) for item in group if isinstance(item, dict) and item.get('platform', 'hotaru') == 'hotaru']
    if not group:
        return await ctx.respond(ctx.t('vector.v_err_api') if result is None else ctx.t('vector.v_err_404', q=html.escape(query)))
    key = save_session(ctx, {'group': group, 'query': query, 'index': 0, 'expanded': False, 'page': 0})
    text, rows = card(ctx, key, ctx.state.get('menu:' + key))
    await show(ctx, text, rows)


async def command_vecme(ctx, invocation):
    info, status = await net_req(ctx, 'GET', '/api/tg-bot')
    username = str((info or {}).get('username', '')).strip().lstrip('@')
    if not re.fullmatch('[A-Za-z0-9_]+', username):
        return await ctx.respond(ctx.t('vector.v_err_api'))
    await show(ctx, EMOJI['shield'] + ' <b>' + ctx.t('vector.v_miniapp_title') + '</b>\n\n' + ctx.t('vector.v_miniapp_body'), [[{'text': ctx.t('vector.v_miniapp_btn'), 'url': 'https://t.me/' + username + '/vector?startapp=hotaru'}, ctx.ui.close(ctx.t('vector.v_upd_cancel'))]])


async def command_vecupdate(ctx, invocation):
    url = module_url('sepiol026-wq', 'Vector')
    if not any(arg in ('-f', '--force') for arg in invocation.args):
        await ctx.respond(ctx.t('vector.v_upd_check'))
        token = await get_active_token(ctx)
        body, status = await net_req(ctx, 'GET', url, token=token, as_bytes=True)
        if not body:
            return await ctx.respond(ctx.t('vector.v_upd_err'))
        local = await ctx.modules.info('vector')
        if hashlib.sha256(body).hexdigest() == local.get('digest'):
            key = save_session(ctx, {'update': url})
            return await show(ctx, ctx.t('vector.v_upd_same'), [[button(ctx, ctx.t('vector.v_upd_force_btn'), key, 'update'), ctx.ui.close(ctx.t('vector.v_upd_cancel'))]])
    status, detail = await safe_install(ctx, 'Vector', url)
    await ctx.respond(ctx.t('vector.v_upd_ok' if status == 'ok' else 'vector.v_upd_err') if status != 'confirm' else 'Hotaru permission review required; .hmod exported.')


async def command_vecdl(ctx, invocation):
    raw = invocation.raw_args.strip()
    slug = raw.split('/collections/')[-1].split('/')[0].split('?')[0] if '/collections/' in raw else raw
    if not slug:
        return await ctx.respond(ctx.t('vector.v_vecdl_usage', p=html.escape(str(ctx.prefix))))
    token = await get_active_token(ctx)
    result, status = await net_req(ctx, 'GET', '/api/collections/' + quote(slug, safe=''), token=token)
    if not result or not result.get('ok'):
        return await ctx.respond(ctx.t('vector.v_dlcoll_not_found'))
    collection = result['collection']
    modules = [entry['module'] for entry in collection.get('modules', []) if isinstance(entry.get('module'), dict) and entry['module'].get('platform', 'hotaru') == 'hotaru']
    if not modules:
        return await ctx.respond(ctx.t('vector.v_dlcoll_empty'))
    limit = ctx.config.get('max_batch', 50)
    key = save_session(ctx, {'collection': modules, 'name': collection.get('name', slug)})
    text = ctx.t('vector.v_dlcoll_hdr', name=html.escape(collection.get('name', slug))) + '\n' + ctx.t('vector.v_dlcoll_count', count=min(len(modules), limit))
    if len(modules) > limit:
        text += '\n' + ctx.t('vector.v_dlcoll_max_batch', total=len(modules), max=limit)
    await show(ctx, text, [[button(ctx, ctx.t('vector.v_btn_dl'), key, 'collection'), ctx.ui.close(ctx.t('vector.v_upd_cancel'))]])


async def sync_inventory(ctx):
    token = await get_active_token(ctx)
    if not token:
        return False
    tracked = ctx.state.get('vector_inventory', {})
    modules = []
    for module in await ctx.modules.list():
        record = tracked.get(module['module_id'])
        if record and module.get('active') and module.get('digest'):
            modules.append({'class_name': record['name'], 'module_id': module['module_id'], 'contentHash': module['digest'], 'language': detect_lang_suffix(ctx), 'platform': 'hotaru'})
    result, status = await net_req(ctx, 'PUT', '/api/users/me/modules', token=token, json_data={'modules': modules, 'replace_inventory': True, 'platform': 'hotaru'})
    return bool(result and result.get('ok'))


async def task_token_keeper(ctx):
    await get_active_token(ctx)


async def task_sync_modules_keeper(ctx):
    if ctx.config.get('auto_update_notify', True):
        await sync_inventory(ctx)


async def vector_action(call, payload):
    key = str((payload or {}).get('session', ''))
    ctx = _sessions.get(key)
    if ctx is None:
        return await call.respond('This Vector menu expired. Run .vector again.', alert=True)
    state = ctx.state.get('menu:' + key)
    if not state:
        return await call.respond('This Vector menu expired.', alert=True)
    action = payload.get('action')
    if action == 'update':
        status, detail = await safe_install(ctx, 'Vector', state['update'])
        return await call.respond(ctx.t('vector.v_upd_ok' if status == 'ok' else 'vector.v_upd_err') if status != 'confirm' else 'Hotaru permission review required; .hmod exported.', alert=True)
    if action == 'collection':
        modules = state['collection'][:ctx.config.get('max_batch', 50)]
        await call.respond(ctx.t('vector.v_dlcoll_start'))
        successes = 0
        failed = []
        for item in modules:
            status, detail = await safe_install(ctx, item['name'], module_url(item.get('source_owner', 'unknown'), item['name']))
            successes += status == 'ok'
            if status != 'ok':
                failed.append(ctx.t('vector.v_dlcoll_fail_item', name=html.escape(item['name']), reason=html.escape(detail or ('Hotaru permission review required' if status == 'confirm' else ctx.t('vector.v_dl_err')))))
        result = ctx.t('vector.v_dlcoll_done' if successes == len(modules) else 'vector.v_dlcoll_done_partial' if successes else 'vector.v_dlcoll_done_none')
        return await call.edit(result + f'\n<b>{successes}/{len(modules)}</b>\n' + '\n'.join(failed), reply_markup=[[ctx.ui.close()]], rich=True)
    group = state['group']
    if action == 'nav':
        state['index'] = int(payload['index']) % len(group)
    elif action == 'toggle':
        state['expanded'] = not state.get('expanded')
    idx = state.get('index', 0)
    item = group[idx]
    owner, name = item['owner'], item['name']
    path = '/api/modules/' + quote(owner, safe='') + '/' + quote(name, safe='')
    source = module_url(owner, name)
    back = [[button(ctx, ctx.t('vector.v_btn_bck'), key, 'nav', index=idx)]]
    if action == 'list':
        pages = max(1, (len(group) + 4) // 5)
        page = int(payload.get('page', state.get('page', 0))) % pages
        state['page'] = page
        ctx.state.set('menu:' + key, state)
        rows = [[button(ctx, str(i + 1) + '. ' + m['name'] + ' by ' + m['author'], key, 'nav', index=i)] for i, m in enumerate(group) if page * 5 <= i < (page + 1) * 5]
        rows.append([button(ctx, '◀️', key, 'list', page=(page - 1) % pages), {'text': ctx.t('vector.v_page', idx=page + 1, total=pages), 'disabled': True}, button(ctx, '▶️', key, 'list', page=(page + 1) % pages)])
        return await call.edit(EMOJI['modules_list'] + ' ' + ctx.t('vector.v_res_hdr'), reply_markup=rows + back, rich=True)
    if action in ('like', 'dislike'):
        token = await get_active_token(ctx)
        result = None
        for attempt in range(2):
            uid = str(parse_jwt(ctx, token).get('sub', ''))
            result, status = await net_req(ctx, 'POST', '/api/rate/' + quote(uid, safe='') + '/' + quote(owner, safe='') + '/' + quote(name, safe='') + '/' + action, token=token)
            if result and result.get('ok'):
                break
            if attempt == 0:
                token = await get_active_token(ctx, force=True)
        if not result or not result.get('ok'):
            return await call.respond(ctx.t('vector.v_rep_err'), alert=True)
        likes, dislikes = extract_counts(ctx, result)
        if likes is not None:
            item['likes'] = likes
        if dislikes is not None:
            item['dislikes'] = dislikes
        await call.respond(ctx.t('vector.v_fb_rm' if result.get('rating', {}).get('state') == 'removed' else 'vector.v_fb_add'), alert=True)
    elif action == 'install':
        status, detail = await safe_install(ctx, name, source)
        text = ctx.t('vector.v_dl_ok' if status == 'ok' else 'vector.v_dl_err')
        if status == 'confirm':
            text = 'Hotaru permission review required; .hmod exported. ' + detail
        elif detail:
            text += '\n' + detail
        return await call.respond(text, alert=True)
    elif action in ('audit', 'audit_run'):
        token = await get_active_token(ctx)
        cached = ctx.state.get('audit:' + owner + '/' + name)
        if action == 'audit' and cached and cached.get('check'):
            result, status = cached, 200
        else:
            await call.respond(ctx.t('vector.v_aud_proc' if action == 'audit_run' else 'vector.v_aud_req'))
            result, status = await net_req(ctx, 'POST' if action == 'audit_run' else 'GET', path + '/security-check', token=token, timeout=120)
        rows = [[{'text': ctx.t('vector.v_btn_code'), 'url': source}]] + back
        if status == 429:
            return await call.edit(ctx.t('vector.v_aud_zero'), reply_markup=rows)
        if not result or status >= 400:
            return await call.edit(ctx.t('vector.v_aud_err'), reply_markup=rows)
        if result.get('check'):
            ctx.state.set('audit:' + owner + '/' + name, result)
        else:
            rows.insert(0, [button(ctx, ctx.t('vector.v_btn_aud_run'), key, 'audit_run')])
        return await call.edit(fmt_sec(ctx, html.escape(name), result), reply_markup=rows, rich=True)
    elif action == 'comments':
        state['comments_page'] = int(payload.get('page', state.get('comments_page', 0)))
        ctx.state.set('menu:' + key, state)
        text, rows = await comments_screen(ctx, key, state)
        await show(ctx, text, rows)
        return await call.respond()
    ctx.state.set('menu:' + key, state)
    text, rows = card(ctx, key, state)
    await call.edit(text, reply_markup=rows, rich=True)
    if action not in ('like', 'dislike'):
        await call.respond()


async def comments_screen(ctx, key, state, comments=None):
    item = state['group'][state['index']]
    owner, name = item['owner'], item['name']
    if comments is None:
        token = await get_active_token(ctx)
        result, status = await net_req(ctx, 'GET', '/api/modules/' + quote(owner, safe='') + '/' + quote(name, safe='') + '/comments', token=token)
        if not isinstance(result, dict):
            return ctx.t('vector.v_talk_err'), [[button(ctx, ctx.t('vector.v_btn_bck'), key, 'nav', index=state['index'])]]
        comments = result.get('comments', [])
    pages = max(1, (len([c for c in comments if not c.get('parent_id')]) + 4) // 5)
    page = max(0, min(state.get('comments_page', 0), pages - 1))
    rows = [[{'text': ctx.t('vector.v_btn_wrt'), 'k': 'input', 'm': 'vector', 'f': 'comment_submit', 'p': ctx.t('vector.v_rep_ask'), 'a': {'session': key}}]]
    if pages > 1:
        rows.append([button(ctx, '◀️', key, 'comments', page=(page - 1) % pages), {'text': ctx.t('vector.v_page', idx=page + 1, total=pages), 'disabled': True}, button(ctx, '▶️', key, 'comments', page=(page + 1) % pages)])
    rows += [[{'text': ctx.t('vector.v_btn_code'), 'url': module_url(owner, name)}], [button(ctx, ctx.t('vector.v_btn_bck'), key, 'nav', index=state['index'])]]
    text = fmt_comments(ctx, comments, html.escape(name), page)
    if item.get('banner'):
        text = '<figure><img src="' + html.escape(item['banner'], quote=True) + '"/></figure>\n' + text
    return text, rows


async def comment_submit(ctx, nav):
    key = nav.arg('session')
    state = ctx.state.get('menu:' + key)
    text = str(nav.value or '').strip()
    if not state:
        return ctx.t('vector.v_rep_err')
    if len(text) < 2 or len(text) > 1800:
        return ctx.t('vector.v_rep_min' if len(text) < 2 else 'vector.v_rep_max')
    item = state['group'][state['index']]
    token = await get_active_token(ctx)
    result, status = await net_req(ctx, 'POST', '/api/modules/' + quote(item['owner'], safe='') + '/' + quote(item['name'], safe='') + '/comments', token=token, json_data={'body': text})
    if not result or status >= 400:
        return ctx.t('vector.v_rep_err')
    text, rows = await comments_screen(ctx, key, state, result.get('comments'))
    return ctx.screens.screen(text, rows, rich=True, toast=ctx.t('vector.v_rep_ok'))


async def watcher_install(ctx, invocation):
    data = ctx._msg
    text = str(data.get('text') or data.get('message') or '').strip()
    if data.get('out') or not ctx.config.get('VectorInstall', True) or not text.startswith('#v_payload_hotaru:'):
        return
    sender = data.get('from_id')
    sender = sender.get('user_id') if isinstance(sender, dict) else sender
    bot_id = ctx.state.get('bot_id', 0)
    if not bot_id:
        info, status = await net_req(ctx, 'GET', '/api/tg-bot')
        username = str((info or {}).get('username', '')).strip().lstrip('@')
        if not username:
            return
        bot = await ctx.resolve(username)
        bot_id = int(bot.get('id') or bot.get('user_id') or 0)
        ctx.state.set('bot_id', bot_id)
    if not bot_id or sender != bot_id:
        return
    parts = text.split(':', 4)
    if len(parts) != 5:
        return
    _, owner_module, action, stamp, signature = parts
    if not owner_module or action not in ('install', 'update', 'like', 'dislike') or not stamp.isdigit():
        return
    await ensure_time_synced(ctx)
    if abs(now(ctx) - int(stamp)) > 60:
        return
    expected = hmac.new(auths.encode(), f'{owner_module}:{action}:{stamp}'.encode(), hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected, signature):
        return
    if ctx.state.get('payload:' + signature):
        return
    ctx.state.set('payload:' + signature, int(stamp))
    for key in ctx.state.keys():
        if key.startswith('payload:') and now(ctx) - ctx.state.get(key, 0) > 120:
            ctx.state.delete(key)
    owner, name = owner_module.split('|', 1) if '|' in owner_module else ('unknown', owner_module)
    if not name or ':' in name:
        return
    peer = {'_': 'inputNotifyPeer', 'peer': ctx.chat_id}
    saved = None
    try:
        with suppress(Exception):
            saved = await ctx.tg.call('account.getNotifySettings', {'peer': peer})
            await ctx.tg.call('account.updateNotifySettings', {'peer': peer, 'settings': {'_': 'inputPeerNotifySettings', 'mute_until': 2 ** 31 - 1}})
        with suppress(Exception):
            await ctx.tg.call('messages.deleteMessages', {'id': [ctx.message_id], 'revoke': True})
        token = await get_active_token(ctx)
        status, reason = 'error', ''
        if not token:
            status, reason = 'banned', ctx.state.get('ban_notice', '') or 'User is banned'
        elif action in ('install', 'update'):
            if action == 'update':
                result, code = await net_req(ctx, 'GET', '/api/modules/by-id', token=token, params={'id': owner_module})
                module = (result or {}).get('module', {})
                owner, name = module.get('source_owner', ''), module.get('name', '')
            if owner and name:
                status, reason = await safe_install(ctx, name, module_url(owner, name))
        else:
            uid = str(parse_jwt(ctx, token).get('sub', ''))
            result, code = await net_req(ctx, 'POST', '/api/rate/' + quote(uid, safe='') + '/' + quote(owner, safe='') + '/' + quote(name, safe='') + '/' + action, token=token)
            status = 'ok' if result and result.get('ok') else 'banned' if code in (401, 403) else 'error'
        timestamp = int(now(ctx))
        reason = str(reason).replace(':', ' ').strip()
        until = 'permanent' if status == 'banned' else ''
        feedback = f'{owner_module}:{action}:{status}:{timestamp}:{reason}:{until}'
        signed = hmac.new(auths.encode(), feedback.encode(), hashlib.sha256).hexdigest()
        with suppress(Exception):
            await ctx.tg.call('messages.sendMessage', {'peer': ctx.chat_id, 'message': '#v_feedback:' + feedback + ':' + signed, 'random_id': secrets.randbits(63)})
        with suppress(Exception):
            await ctx.net(platform_url('/api/tg-bot/install-feedback'), method='POST', json={'owner_module': owner_module, 'status': status, 'reason': reason, 'platform': 'hotaru'}, headers={'x-bot-secret': auths}, timeout=5)
    finally:
        if isinstance(saved, dict):
            settings = {k: v for k, v in saved.items() if k in ('show_previews', 'silent', 'mute_until', 'sound', 'stories_muted', 'stories_hide_sender', 'stories_sound')}
            with suppress(Exception):
                await ctx.tg.call('account.updateNotifySettings', {'peer': peer, 'settings': {'_': 'inputPeerNotifySettings', **settings}})
