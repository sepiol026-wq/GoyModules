              'cdxpresets',
              'cdxmemdel',
              'cdxmemchats',
              'cdxmemexport',
              'cdxmemimport',
              'cdxmemfind',
              'cdxmem',
              'cdxmemshow',
              'cdxmodel',
              'cdxreset'],
 'capabilities': ['mt', 'state', 'files', 'shell', 'net', 'assets'],
 'requires': ['pytz', 'markdown-it-py', 'psutil'],
 'watchers': ['watcher'],
 'rise': 'rise',
 'fade': 'fade',
 'config_schema': {'codex_path': {'type': 'str',
                                  'default': '',
                                  'description': 'Путь до бинарника codex. При необходимости укажите полный '
