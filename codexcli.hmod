                   'codex_model': {'type': 'str',
                                   'default': 'gpt-5.4',
                                   'description': 'Модель для Codex CLI (например gpt-5.4).'},
                   'cli_backend': {'type': 'select',
                                   'default': 'codex',
                                   'description': 'CLI backend: codex.',
