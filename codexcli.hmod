HOTARU = {'id': 'codexcli',
 'version': '1.3.3',
 'commands': ['cdx',
              'codex',
              'cdxstop',
              'cdxpatch',
              'cdxperf',
              'cdxprod',
              'cdxamod',
              'cdxcfgcheck',
              'cdxauth',
              'cdxinstall',
              'cdxch',
              'cdxprompt',
              'cdxauto',
              'cdxsend',
              'cdxchatinfo',
              'cdxme',
              'cdxchance',
              'cdxautochats',
