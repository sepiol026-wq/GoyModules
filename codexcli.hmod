                   'interactive_buttons': {'type': 'bool',
                                           'default': True,
                                           'description': 'Включить интерактивные кнопки.'},
                   'system_instruction': {'type': 'str',
                                          'default': '',
                                          'description': 'Системный промпт для Codex CLI.'},
                   'max_history_length': {'type': 'int',
                                          'default': 100,
                                          'description': 'Макс. число пар вопрос-ответ в памяти. 0 — без '
