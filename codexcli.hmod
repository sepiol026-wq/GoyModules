                                          'min': 0},
                   'timezone': {'type': 'str',
                                'default': 'Europe/Moscow',
                                'description': 'Ваш часовой пояс.'},
                   'proxy': {'type': 'str',
                             'default': '',
                             'description': 'Прокси для Codex CLI. Формат: http://user:pass@host:port',
                             'secret': True},
                   'auto_reply_chats': {'type': 'str',
                                        'default': '',
                                        'description': 'Чаты для авто-ответа. IDs или @username через '
                                                       'запятую/новую строку.'},
                   'memory_disabled_chats': {'type': 'str',
                                             'default': '',
                                             'description': 'Чаты, где память отключена. IDs или @username '
                                                            'через запятую/новую строку.'},
                   'impersonation_prompt': {'type': 'str',
                                            'default': 'Ты — это я, пользователь Telegram по имени '
                                                       '{my_name}. Твоя задача — отвечать в чате от моего '
                                                       'имени, основываясь на последних сообщениях. Веди '
                                                       'себя естественно, как обычный человек, а не как '
                                                       'ассистент. Не признавайся, что ты — ИИ.\n'
                                                       'Правила:\n'
                                                       '- Отвечай кратко и по делу.\n'
                                                       '- Используй естественный живой язык.\n'
                                                       '- Не отвечай на каждое сообщение.\n'
                                                       '- Не используй префиксы и кавычки.\n'
                                                       '\n'
                                                       'ИСТОРИЯ ЧАТА:\n'
                                                       '{chat_history}\n'
                                                       '\n'
                                                       '{my_name}:',
                                            'description': 'Промпт для режима авто-ответа. {my_name} и '
                                                           '{chat_history} будут заменены.'},
                   'impersonation_history_limit': {'type': 'int',
                                                   'default': 20,
                                                   'description': 'Сколько последних сообщений из чата '
                                                                  'отправлять как контекст для авто-ответа.',
                                                   'min': 5,
                                                   'max': 100},
                   'impersonation_reply_chance': {'type': 'float',
