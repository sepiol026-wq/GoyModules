data.get('fwd_from'))}\n    return all(checks.get(key, False) for key, enabled in tags.items() if enabled)"
_CORE_SIGNATURE = {'modules': ['updater', 'power', 'acl', 'genesis', 'logger', 'accounts', 'info', 'shield', 'singularity', 'executor', 'catalyst', 'help', 'translations', 'settings', 'backups'], 'commands': ['upd', 'updlog', 'updoff', 'updon', 'restart', 'stop', 'resume', 'unpause', 'perms', 'perm', 'whois', 'owadd', 'owrm', 'owls', 'sgls', 'sg', 'sgnew', 'sgdel', 'sgadd', 'sgrm', 'rule', 'rulerm', 'ruleclr', 'logs', 'loglevel', 'account', 'addaccount', 'accounts', 'info', 'ping', 'shield', 'suspend_api', 'dash', 'sh', 'py', 'kill', 'ld', 'ul', 'rl', 'ex', 'resetdb', 'help', 'language', 'translate', 'loadlex', 'rmlex', 'config', 'alias', 'rmalias', 'lsalias', 'prefix', 'backup', 'restore'], 'methods': []}
def _config_spec(cfg):
    name = cfg.get('validator', 'String')
    meta = cfg.get('validator_args') or {}
    default, error = _parse_default_for_validator(name, cfg.get('default', ''), meta)
    if error:
        raise ValueError('Invalid default for configuration ' + str(cfg.get('key')))
    spec = {'type': {'Boolean': 'bool', 'Integer': 'int', 'TelegramID': 'int', 'Float': 'float', 'Choice': 'choice', 'MultiChoice': 'series', 'Series': 'series'}.get(name, 'str'), 'default': default, 'description': str(cfg.get('doc') or '')}
    if name == 'Choice':
        spec['options'] = meta.get('possible_values', [])
    elif name == 'MultiChoice':
        spec['item'] = {'type': 'choice', 'options': meta.get('possible_values', [])}
    elif name == 'Hidden':
        spec['secret'] = True
    elif name == 'RegExp':
        spec['regex'] = meta.get('regex', '')
    elif name == 'Link':
        spec['regex'] = r'^https?://[^\s]+$'
    return spec


def _watcher_matches(ctx, tags):
    data = getattr(ctx, '_msg', {})
    text = str(data.get('text') or data.get('message') or '')
    attachment = data.get('attachment') or {}
    kind = str(attachment.get('kind') or '').lower()
    mime = str(attachment.get('mime_type') or '')
    command = text.startswith(str(ctx.prefix))
    media = bool(attachment or data.get('media'))
    peer = data.get('peer_id') or {}
    channel = isinstance(peer, dict) and 'channel_id' in peer
    private = isinstance(ctx.chat_id, int) and ctx.chat_id > 0
    inline = bool(data.get('via_bot_id'))
    sticker = kind == 'sticker' or 'sticker' in mime
    photo = kind == 'photo' or mime.startswith('image/') and not sticker
    video = kind == 'video' or mime.startswith('video/')
    audio = kind in ('audio', 'voice') or mime.startswith('audio/')
    document = bool(media and not photo and not video and not audio and not sticker)
    checks = {'no_commands': not command, 'only_commands': command, 'out': bool(data.get('out')), 'in': not data.get('out'), 'only_messages': bool(text or media), 'editable': bool(data.get('out')), 'no_media': not media, 'only_media': media, 'only_photos': photo, 'only_videos': video, 'only_audios': audio, 'only_docs': document, 'only_stickers': sticker, 'only_inline': inline, 'only_channels': channel and not data.get('megagroup'), 'only_groups': not private and (not channel or data.get('megagroup')), 'only_pm': private, 'no_pm': not private, 'no_channels': not channel or data.get('megagroup'), 'no_groups': private or channel and not data.get('megagroup'), 'no_inline': not inline, 'no_stickers': not sticker, 'no_docs': not document, 'no_audios': not audio, 'no_videos': not video, 'no_photos': not photo, 'no_forwards': not data.get('fwd_from'), 'no_reply': not data.get('reply_to'), 'no_mention': not data.get('mentioned'), 'mention': bool(data.get('mentioned')), 'only_reply': bool(data.get('reply_to')), 'only_forwards': bool(data.get('fwd_from'))}
    return all(checks.get(key, False) for key, enabled in tags.items() if enabled)


def _build_module_code(project, extra_imports=None):
    meta = project['meta']
    commands = project.get('commands') or {}
    watchers = project.get('watchers') or {}
    loops = project.get('loops') or {}
    strings = _project_runtime_strings(project)
    module_id = re.sub('[^a-z0-9-]+', '-', str(meta.get('class_name') or meta.get('name') or 'module').lower()).strip('-')[:64]
    if not module_id:
        raise ValueError('Module name must contain Latin letters or digits')
    prefix = meta.get('prefix', '')
    spec = {'id': module_id, 'version': meta.get('version') or '1.0.0', 'commands': [prefix + name for name in commands], 'capabilities': ['state', 'net', 'mt', 'files'], 'watchers': ['watch_' + name for name in watchers], 'tasks': {name: {'interval': int(value.get('interval') or 60), 'autostart': True} for name, value in loops.items()}, 'config_schema': {cfg['key']: _config_spec(cfg) for cfg in project.get('configs', [])}, 'lexicon': {}, 'requires': _parse_dependencies(project.get('dependencies') or [])}
    if meta.get('banner'):
        spec['banner'] = meta['banner']
    for lang in _project_languages(project):
        pack = {**strings.get('en', {}), **strings.get(lang, {})}
        spec['lexicon'][lang] = {'name': meta.get('name', module_id), 'description': str(pack.get('_cls_doc') or project.get('description') or ''), 'strings': pack, 'commands': {prefix + name: {'description': _command_doc(project, name, lang) or _command_doc(project, name, 'en')} for name in commands}}
    imports = set(extra_imports or ()) | _collect_project_imports(project)
    imports = {line for line in imports if not any(word in line for word in ('herokutl', 'loader', 'translations', 'utils'))}
    lines = ['HOTARU = ' + repr(spec), 'import json', 'import random', 'import datetime', 'import re', 'import math', 'import hashlib'] + sorted(imports)
    lines += [
        'def _resource(ctx, cmd, kind, key, default=None):',
        "    suffix = {'texts': 'text', 'lists': 'list', 'values': 'value'}[kind]",
        "    key = '__cmd__{}__{}__{}'.format(cmd, suffix, key)",
        "    lang = 'jp' if ctx.i18n.language == 'ja' else ctx.i18n.language",
        "    base = HOTARU['lexicon']['en']['strings']",
        "    pack = HOTARU['lexicon'].get(lang, {}).get('strings', {})",
        "    value = pack.get(key, base.get(key))",
        '    if value is None:',
        '        return default',
        "    if kind == 'texts':",
        '        return str(value)',
        '    try:',
        '        value = json.loads(value)',
        "        return value if kind != 'lists' or isinstance(value, list) else list(default or [])",
        '    except (ValueError, TypeError):',
        '        return default',
    ]
    for kind, bucket in [('command', commands), ('watch', watchers), ('task', loops)]:
        for name, item in bucket.items():
            body = _command_body_source(item).strip() or 'pass'
            handler = kind + '_' + (prefix + name if kind == 'command' else name)
            lines += ['async def ' + handler + '(ctx' + (', invocation' if kind != 'task' else '') + '):']
            if kind == 'watch':
                lines += ['    if not _watcher_matches(ctx, ' + repr(item.get('tags') or {}) + '):', '        return']
            lines += ['    ' + line for line in body.splitlines()]
    lines += [_WATCHER_RUNTIME_SOURCE]
    return '\n'.join(lines) + '\n'


def _build_module_code_with_import_repair(project, *, max_passes=4):
    imports = _collect_project_imports(project)
    code = ''
    for _ in range(max_passes):
        try:
            code = _build_module_code(project, imports)
            compile(code, '<generated.hmod>', 'exec')
            tree = ast.parse(code)
            declared = ast.literal_eval(tree.body[0].value)
            if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,63}', declared['id']):
                return code, 'Invalid Hotaru module id', imports
            for cfg in project.get('configs', []):
                error = _validate_config_validator(cfg)
                if error:
                    return code, error, imports
            errors = _validate_name_resolution(tree)
            inferred = imports | _ast_detect_imports(code) | _missing_name_to_imports('\n'.join(errors))
            if inferred == imports:
                return code, ('\n'.join(errors) if errors else None), imports
            imports = inferred
        except Exception as exc:
            return code, str(exc), imports
    return code, 'Import repair did not converge', imports


def _validate_body_syntax(code):
    try:
        wrapped = 'async def _tmp(ctx, invocation=None):\n' + _indent(code or 'pass', 4)
        tree = ast.parse(wrapped)
        compile(tree, '<body>', 'exec')
        if any(isinstance(node, ast.Name) and node.id in {'self', 'message', 'utils', 'loader'} for node in ast.walk(tree)):
            return 'Use native ctx APIs and invocation.raw_args, not Heroku module/message APIs'
        errors = _validate_name_resolution(tree)
        return '\n'.join(errors) if errors else None
    except Exception as exc:
        return str(exc)


def _build_ai_request(ctx, project, state, user_prompt):
    name = state.get('cmd_name') or state.get('watcher_name') or state.get('loop_name') or 'command'
    return 'Write only the Python body for a Hotaru .hmod async handler (ctx, invocation=None). No imports, comments, definitions, decorators, markdown or explanations. Native APIs: await ctx.respond(text, parse_mode="HTML"), await ctx.reply_text(), invocation.raw_args, ctx.config, synchronous ctx.state.get(key, default), ctx.state.set(key, value), await ctx.net(url, method="GET", json=payload) returns status/body/headers; body is text, parse with json.loads. ctx.i18n.language is locale. Never use Heroku, Hikka, loader, utils, or direct network clients. Persistent shared toggles must use ctx.state. For localized resources use _resource(ctx, name, "texts", key, default), or kinds "lists" and "values". If loop or watcher depends on a toggle check state first. Telegram HTML only. Module: ' + json.dumps(project.get('meta', {}), ensure_ascii=False) + '\nEntity: ' + name + '\nKind: ' + str(state.get('entity_kind', 'command')) + '\nInterval: ' + str(state.get('interval', 60)) + '\nWatcher tags: ' + repr(state.get('watcher_tags', {})) + '\nTopology: ' + repr({key: list((project.get(key) or {}).keys()) for key in ('commands', 'watchers', 'loops')}) + '\nConfiguration: ' + repr(project.get('configs', [])) + '\nRequest: ' + user_prompt


AI_SYSTEM_PROMPT = 'You produce complete working Python bodies exclusively for native Hotaru .hmod modules. Follow the supplied native context API. No Heroku/Hikka APIs, imports, comments, Markdown or surrounding text.'


_session = SimpleNamespace(_active={}, _core_cache=None)


