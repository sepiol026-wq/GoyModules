def _ai_settings(ctx):
    provider = str(ctx.config.get('ai_provider', 'anthropic')).strip().lower()
    token = str(ctx.config.get('ai_token', '')).strip()
    model = str(ctx.config.get('ai_model', '')).strip()
    base_url = str(ctx.config.get('ai_base_url', '')).strip()
    if provider not in AI_PROVIDER_OPTIONS:
        return (None, _t(ctx, 'ai_invalid_provider', provider=provider or '?'))
    if not token:
        return (None, _t(ctx, 'ai_token_missing'))
    if not model:
        return (None, _t(ctx, 'ai_model_missing'))
    return ({'provider': provider, 'token': token, 'model': model, 'base_url': base_url}, None)

def _get_lang(ctx):
    lang = ctx.i18n.language
    return 'jp' if lang == 'ja' else lang

def _lang_pack(ctx, lang):
    return {**_locale_en, **_locale_packs.get(lang, {}), **IDE_I18N_PATCHES.get(lang, {})}

def _t(ctx, text_key, **kwargs):
    default = _lang_pack(ctx, 'en').get(text_key, text_key)
    value = _lang_pack(ctx, _get_lang(ctx)).get(text_key, default)
    rendered = value.format(**kwargs) if kwargs else value
    if text_key.endswith('_btn') or text_key in NO_PREMIUM_TEXT_KEYS:
        return rendered
    return _apply_premium_text_emojis(rendered)

def _get_projects(ctx):
    projects = ctx.state.get('projects', None)
    return projects if isinstance(projects, dict) else {}

def _save_projects(ctx, projects):
    ctx.state.set('projects', projects)

def _get_project(ctx, pid):
    project = _get_projects(ctx).get(pid)
    if not isinstance(project, dict):
        return project
    return _normalize_project_schema(ctx, project)

def _touch_project(ctx, project):
    meta = project.setdefault('meta', {})
    now = int(time.time())
    meta.setdefault('created_at', now)
    meta['updated_at'] = now

def _save_project(ctx, pid, project):
    project = _normalize_project_schema(ctx, project)
    _touch_project(ctx, project)
    projects = _get_projects(ctx)
    projects[pid] = project
    _save_projects(ctx, projects)

def _delete_project(ctx, pid):
    projects = _get_projects(ctx)
    projects.pop(pid, None)
    _save_projects(ctx, projects)

def _new_project(ctx, name, class_name=None):
    pid = _make_project_id()
    normalized, _ = _normalize_module_name(name)
    display_name = normalized['display_name'] if normalized else name
    final_class_name = class_name or (normalized['class_name'] if normalized else name)
    now = int(time.time())
    project = {'meta': {'name': display_name, 'class_name': final_class_name, 'prefix': '', 'developer': '', 'license': '', 'version': '', 'banner': '', 'pic': '', 'heroku_min': '', 'created_at': now, 'updated_at': now}, 'description': '', 'configs': [], 'commands': {}, 'watchers': {}, 'loops': {}, 'dependencies': [], 'command_docs': {}, 'command_resources': {}, 'extra_langs': [], 'strings': {'en': {'name': display_name}, 'ru': {}}}
    _save_project(ctx, pid, project)
    return pid

def _normalize_project_schema(ctx, project):
    if not isinstance(project, dict):
        return project
    meta = project.setdefault('meta', {})
    if not isinstance(meta, dict):
        meta = {}
        project['meta'] = meta
    for key in ('developer', 'license', 'version', 'banner', 'pic', 'heroku_min'):
        meta[key] = _normalize_meta_text(meta.get(key))
    if meta.get('version'):
        meta['version'] = _normalize_version(meta.get('version')) or ''
    if meta.get('heroku_min'):
        meta['heroku_min'] = _normalize_version(meta.get('heroku_min')) or ''
    for key in ('banner', 'pic'):
        if meta.get(key) and (not _is_valid_image_meta(meta.get(key))):
            meta[key] = ''
    commands = project.setdefault('commands', {})
    watchers = project.setdefault('watchers', {})
    loops = project.setdefault('loops', {})
    strings = project.setdefault('strings', {})
    project.setdefault('command_docs', {})
    project.setdefault('command_resources', {})
    project.setdefault('extra_langs', [])
    project['dependencies'] = _parse_dependencies(project.get('dependencies') or [])
    if not isinstance(watchers, dict):
        watchers = {}
        project['watchers'] = watchers
    if not isinstance(loops, dict):
        loops = {}
        project['loops'] = loops
    command_docs = project.get('command_docs')
    if not isinstance(command_docs, dict):
        command_docs = {}
        project['command_docs'] = command_docs
    command_resources = project.get('command_resources')
    if not isinstance(command_resources, dict):
        command_resources = {}
        project['command_resources'] = command_resources
    extra_langs = []
    for lang in project.get('extra_langs') or []:
        normalized = _normalize_lang_code(lang)
        if normalized and normalized not in REQUIRED_LANGS and (normalized not in extra_langs):
            extra_langs.append(normalized)
    project['extra_langs'] = extra_langs
    for lang in _project_languages(project):
        lang_strings = strings.setdefault(lang, {}) if lang != 'en' else strings.setdefault('en', {})
        if not isinstance(lang_strings, dict):
            lang_strings = {}
            strings[lang] = lang_strings
    for cmd_name in list(commands):
        per_command = command_docs.setdefault(cmd_name, {})
        if not isinstance(per_command, dict):
            per_command = {}
            command_docs[cmd_name] = per_command
        legacy_key = '{}_doc'.format(cmd_name)
        for lang in _project_languages(project):
            lang_strings = strings.get(lang) or {}
            legacy_value = lang_strings.pop(legacy_key, None)
            if legacy_value and (not per_command.get(lang)):
                per_command[lang] = legacy_value
        per_command_resources = command_resources.setdefault(cmd_name, {})
        if not isinstance(per_command_resources, dict):
            per_command_resources = {}
            command_resources[cmd_name] = per_command_resources
        for lang in _project_languages(project):
            lang_bucket = per_command_resources.setdefault(lang, {})
            if not isinstance(lang_bucket, dict):
                lang_bucket = {}
                per_command_resources[lang] = lang_bucket
            for key in ('texts', 'lists', 'values'):
                value = lang_bucket.setdefault(key, {})
                if not isinstance(value, dict):
                    lang_bucket[key] = {}
    for watcher_name in list(watchers):
        watcher_meta = watchers.get(watcher_name)
        if not isinstance(watcher_meta, dict):
            watcher_meta = {}
            watchers[watcher_name] = watcher_meta
        watcher_meta['body'] = _command_body_source(watcher_meta)
        tags = watcher_meta.get('tags') or {}
        if not isinstance(tags, dict):
            tags = {}
        watcher_meta['tags'] = {str(tag): bool(value) for tag, value in tags.items() if str(tag) in WATCHER_TAG_OPTIONS and value}
    for loop_name in list(loops):
        loop_meta = loops.get(loop_name)
        if not isinstance(loop_meta, dict):
            loop_meta = {}
            loops[loop_name] = loop_meta
        loop_meta['body'] = _command_body_source(loop_meta)
        try:
            loop_meta['interval'] = max(1, int(loop_meta.get('interval') or 60))
        except Exception:
            loop_meta['interval'] = 60
    return project

def _short(ctx, value, limit=80):
    text = str(value or '').strip()
    text = re.sub('\\s+', ' ', text)
    if not text:
        return '—'
    if len(text) <= limit:
        return text
    return text[:max(0, limit - 1)].rstrip() + '…'

def _fmt_time(ctx, stamp):
    if not stamp:
        return '—'
    try:
        return time.strftime('%Y-%m-%d %H:%M', time.localtime(int(stamp)))
    except Exception:
        return '—'

def _default_repr(ctx, value):
    return _short(ctx, repr(value) if value != '' else "''", 72)

def _validator_args_text(ctx, cfg):
    validator = cfg.get('validator', 'String')
    meta = cfg.get('validator_args') or {}
    if validator in {'Choice', 'MultiChoice'}:
        values = meta.get('possible_values') or []
        if not values:
            return '<code>{}</code>'.format(_t(ctx, 'missing_possible_values'))
        return ', '.join(('<code>{}</code>'.format(_escape_html(item)) for item in values))
    if validator == 'RegExp':
        regex = meta.get('regex')
        return '<code>{}</code>'.format(_escape_html(regex)) if regex else '<code>{}</code>'.format(_t(ctx, 'missing_regex'))
    return '<code>—</code>'

def _project_button_text(ctx, name):
    return _t(ctx, 'project_btn_line', name=name)

def _command_button_text(ctx, cmd_name):
    return _t(ctx, 'command_btn_line', cmd=cmd_name)

def _config_button_text(ctx, key):
    return _t(ctx, 'config_btn_line', key=key)

def _watcher_button_text(ctx, name):
    return _t(ctx, 'watcher_btn_line', name=name)

def _loop_button_text(ctx, name):
    return _t(ctx, 'loop_btn_line', name=name)

def _lang_button_text(ctx, lang, project):
    if lang in REQUIRED_LANGS:
        return _t(ctx, 'lang_btn_required', lang=lang)
    if project['strings'].get(lang):
        return _t(ctx, 'lang_btn_ready', lang=lang)
    return _t(ctx, 'lang_btn_empty', lang=lang)

def _dependencies_text(ctx, project):
    deps = _parse_dependencies(project.get('dependencies') or [])
    if not deps:
        return _t(ctx, 'empty_dependencies')
    return ', '.join(('<code>{}</code>'.format(_escape_html(dep)) for dep in deps))

def _meta_text(ctx, value):
    normalized = _normalize_meta_text(value)
    if not normalized:
        return _t(ctx, 'meta_empty')
    return '<code>{}</code>'.format(_escape_html(normalized))

def _watcher_tags_summary(ctx, watcher):
    enabled = [tag for tag in WATCHER_TAG_OPTIONS if (watcher or {}).get('tags', {}).get(tag)]
    if not enabled:
        return _t(ctx, 'empty_tags')
    return ', '.join(('<code>{}</code>'.format(_escape_html(tag)) for tag in enabled))

def _choice_values(ctx, cfg):
    return list((cfg.get('validator_args') or {}).get('possible_values') or [])

def _config_default_label(ctx, value):
    if value in ('', None, [], ()):
        return _t(ctx, 'none_selected')
    if isinstance(value, (list, tuple, set)):
        return ', '.join((str(item) for item in value))
    return str(value)

def _command_body_preview(ctx, body):
    text = _short(ctx, body, 96)
    return _escape_html(text)

def _command_doc_lines(ctx, project, cmd_name):
    lines = []
    for lang in _project_languages(project):
        value = _command_doc(project, cmd_name, lang)
        if lang == 'en' and (not value):
            value = cmd_name
        shown = _escape_html(_short(ctx, value, 120)) if value else _t(ctx, 'empty_lang_value')
        lines.append(_t(ctx, 'module_lang_line', status='✅' if value else '➕', lang=LANG_LABELS.get(lang, lang), value=shown))
    return '\n'.join(lines)

def _get_config_entry(ctx, project, key):
    for cfg in project.get('configs', []):
        if cfg.get('key') == key:
            return cfg
    return None

def _module_desc_lines(ctx, project):
    lines = []
    strings = project.get('strings', {})
    fallback_en = project.get('description') or project.get('meta', {}).get('name', '')
    for lang in _project_languages(project):
        value = strings.get(lang, {}).get('_cls_doc', '')
        if lang == 'en' and (not value):
            value = fallback_en
        shown = _escape_html(_short(ctx, value, 140)) if value else _t(ctx, 'empty_lang_value')
        lines.append(_t(ctx, 'module_lang_line', status='✅' if value else '➕', lang=LANG_LABELS.get(lang, lang), value=shown))
    return '\n'.join(lines)

def _module_lang_buttons(ctx, pid):
    project = _get_project(ctx, pid) or {}
    buttons = []
    row = []
    for lang in _project_languages(project):
        if lang in {'en', 'ru'}:
            continue
        row.append(_control(ctx, LANG_LABELS.get(lang, lang), ('_cb_edit_module_desc', [pid, lang], {})))
        if len(row) == 3:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    return buttons

def _command_lang_buttons(ctx, project, pid, cmd_name):
    buttons = []
    row = []
    for lang in _project_languages(project):
        if lang in {'en', 'ru'}:
            continue
        has_doc = bool(_command_doc(project, cmd_name, lang))
        row.append(_control(ctx, '{} {}'.format('✅' if has_doc else '➕', LANG_LABELS.get(lang, lang)), ('_cb_edit_command_doc', [pid, cmd_name, lang], {})))
        if len(row) == 3:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    return buttons

def _validator_followup_prompt(ctx, validator, key):
    if validator in {'Choice', 'MultiChoice'}:
        return _t(ctx, 'ask_cfg_choice_values', validator=validator)
    if validator == 'RegExp':
        return _t(ctx, 'ask_cfg_regex', key=key)
    return ''

def _project_overview_text(ctx, pid, project, notice=None):
    meta = project.get('meta', {})
    desc_en = project.get('description') or project.get('strings', {}).get('en', {}).get('_cls_doc', '')
    desc_ru = project.get('strings', {}).get('ru', {}).get('_cls_doc', '')
    text = _t(ctx, 'project_panel', name=meta.get('name', _t(ctx, 'unknown_name')), class_name=meta.get('class_name', _t(ctx, 'unknown_class')), pid=pid, cmds=len(project.get('commands', {})), watchers=len(project.get('watchers', {})), loops=len(project.get('loops', {})), cfgs=len(project.get('configs', [])), langs=sum((1 for lang in _project_languages(project) if project['strings'].get(lang))), total_langs=len(_project_languages(project)), created=_fmt_time(ctx, meta.get('created_at')), updated=_fmt_time(ctx, meta.get('updated_at')), desc_en=_escape_html(_short(ctx, desc_en, 140)), desc_ru=_escape_html(_short(ctx, desc_ru, 140)))
    if notice:
        return '{}\n\n{}'.format(notice, text)
    return text

def _module_panel_text(ctx, pid, project):
    meta = project.get('meta', {})
    return '{}\n\n{}'.format(_t(ctx, 'module_section_hint'), _t(ctx, 'module_panel', name=meta.get('name', _t(ctx, 'unknown_name')), class_name=meta.get('class_name', _t(ctx, 'unknown_class')), pid=pid, updated=_fmt_time(ctx, meta.get('updated_at')), developer=_meta_text(ctx, meta.get('developer')), license=_meta_text(ctx, meta.get('license')), version=_meta_text(ctx, meta.get('version')), banner=_meta_text(ctx, meta.get('banner')), pic=_meta_text(ctx, meta.get('pic')), heroku_min=_meta_text(ctx, meta.get('heroku_min')), descs=_module_desc_lines(ctx, project), dependencies=_dependencies_text(ctx, project)))

def _commands_panel_text(ctx, project):
    lines = [_t(ctx, 'commands_panel', count=len(project.get('commands', {}))), '', _t(ctx, 'command_section_hint'), '']
    if not project.get('commands'):
        lines.append(_t(ctx, 'empty_commands'))
        return '\n'.join(lines)
    for cmd_name, cmd in sorted(project['commands'].items()):
        lines.append(_t(ctx, 'command_list_line', cmd=cmd_name, doc=_escape_html(_short(ctx, _command_doc(project, cmd_name, 'en') or cmd_name, 70)), body=_command_body_preview(ctx, _command_body_source(cmd))))
    return '\n'.join(lines)

def _configs_panel_text(ctx, project):
    lines = [_t(ctx, 'configs_panel', count=len(project.get('configs', []))), '', _t(ctx, 'config_section_hint'), '']
    if not project.get('configs'):
        lines.append(_t(ctx, 'empty_configs'))
        return '\n'.join(lines)
    for cfg in project['configs']:
        lines.append(_t(ctx, 'config_list_line', key=cfg.get('key', '?'), validator=cfg.get('validator', 'String'), default=_escape_html(_default_repr(ctx, cfg.get('default', '')))))
    return '\n'.join(lines)

def _command_detail_text(ctx, project, cmd_name):
    cmd = project['commands'][cmd_name]
    return _t(ctx, 'command_panel', cmd=cmd_name, docs=_command_doc_lines(ctx, project, cmd_name), body=_escape_html(_command_body_source(cmd).strip() or 'pass'))

def _config_detail_text(ctx, cfg):
    return _t(ctx, 'config_panel', key=cfg.get('key', '?'), validator=cfg.get('validator', 'String'), default=_escape_html(_default_repr(ctx, cfg.get('default', ''))), validator_args=_validator_args_text(ctx, cfg))

def _watchers_panel_text(ctx, project):
    lines = [_t(ctx, 'watchers_panel', count=len(project.get('watchers', {}))), '', _t(ctx, 'watcher_section_hint'), '']
    if not project.get('watchers'):
        lines.append(_t(ctx, 'empty_watchers'))
        return '\n'.join(lines)
    for watcher_name, watcher in sorted(project.get('watchers', {}).items()):
        lines.append(_t(ctx, 'watcher_list_line', name=watcher_name, tags=_escape_html(_short(ctx, ', '.join((tag for tag in WATCHER_TAG_OPTIONS if watcher.get('tags', {}).get(tag))) or _t(ctx, 'empty_tags'), 72)), body=_command_body_preview(ctx, _command_body_source(watcher))))
    return '\n'.join(lines)

def _loops_panel_text(ctx, project):
    lines = [_t(ctx, 'loops_panel', count=len(project.get('loops', {}))), '', _t(ctx, 'loop_section_hint'), '']
    if not project.get('loops'):
        lines.append(_t(ctx, 'empty_loops'))
        return '\n'.join(lines)
    for loop_name, loop_meta in sorted(project.get('loops', {}).items()):
        lines.append(_t(ctx, 'loop_list_line', name=loop_name, interval=int((loop_meta or {}).get('interval') or 60), body=_command_body_preview(ctx, _command_body_source(loop_meta))))
    return '\n'.join(lines)

def _watcher_detail_text(ctx, project, watcher_name):
    watcher = project.get('watchers', {}).get(watcher_name, {})
    return _t(ctx, 'watcher_panel', name=watcher_name, tags=_watcher_tags_summary(ctx, watcher), body=_escape_html(_command_body_source(watcher).strip() or 'pass'))

def _loop_detail_text(ctx, project, loop_name):
    loop_meta = project.get('loops', {}).get(loop_name, {})
    return _t(ctx, 'loop_panel', name=loop_name, interval=int((loop_meta or {}).get('interval') or 60), body=_escape_html(_command_body_source(loop_meta).strip() or 'pass'))

def _state_aliases(ctx, call, extra_keys=()):
    key = _menu_origin(ctx)
    return [key]

def _set_state(ctx, call, **data):
    for key in _state_aliases(ctx, call):
        _session._active[key] = data

def _get_state(ctx, call, extra_keys=()):
    return _session._active.get(_state_aliases(ctx, call)[0], {})

def _clear_state(ctx, call):
    _session._active.pop(_state_aliases(ctx, call)[0], None)


async def _edit_ui(ctx, call, text, reply_markup=None, **kwargs):
    return await _edit_menu(ctx, call, text, reply_markup, **kwargs)


def _scan_core_signature(ctx):
    return {key: set(value) for key, value in _CORE_SIGNATURE.items()}

def _sanitize_projects(ctx):
    """Remove corrupted projects that are missing required fields."""
    projects = _get_projects(ctx)
    bad = [pid for pid, proj in projects.items() if not isinstance(proj, dict) or not isinstance(proj.get('meta'), dict) or (not proj['meta'].get('name'))]
    if bad:
        for pid in bad:
            projects.pop(pid, None)
        _save_projects(ctx, projects)

def _project_name_exists(ctx, display_name, class_name=None, skip_pid=None):
    for pid, project in _get_projects(ctx).items():
        if pid == skip_pid:
            continue
        meta = project.get('meta') if isinstance(project, dict) else None
        if not meta or not meta.get('name'):
            continue
        project_name = meta['name'].lower()
        project_class_name = meta.get('class_name', meta['name']).lower()
        if project_name == display_name.lower():
            return True
        if class_name and project_class_name == class_name.lower():
            return True
    return False

def _check_module_name(ctx, name, skip_pid=None):
    normalized, reason = _normalize_module_name(name)
    if reason:
        return _t(ctx, 'invalid_module_name')
    display_name = normalized['display_name']
    class_name = normalized['class_name']
    if _project_name_exists(ctx, display_name, class_name=class_name, skip_pid=skip_pid):
        return _t(ctx, 'duplicate_project_name', name=display_name)
    core_modules = _scan_core_signature(ctx)['modules']
    if display_name.lower() in core_modules or class_name.lower() in core_modules:
        return _t(ctx, 'core_module_conflict', name=display_name)
    return None

def _check_command_name(ctx, project, cmd_name):
    if not re.match('^[a-z][a-z0-9_]{0,31}$', cmd_name):
        return _t(ctx, 'invalid_command_name')
    if cmd_name in project['commands']:
        return _t(ctx, 'duplicate_command_name', cmd=cmd_name)
    if cmd_name in project.get('watchers', {}) or cmd_name in project.get('loops', {}):
        return _t(ctx, 'duplicate_handler_name', name=cmd_name)
    if cmd_name.lower() in _scan_core_signature(ctx)['commands']:
        return _t(ctx, 'core_command_conflict', cmd=cmd_name)
    return None

def _check_watcher_name(ctx, project, watcher_name, *, skip_name=None):
    if not re.match('^[a-z][a-z0-9_]{0,31}$', watcher_name):
        return _t(ctx, 'invalid_watcher_name')
    if watcher_name != skip_name and watcher_name in project.get('watchers', {}):
        return _t(ctx, 'duplicate_watcher_name', name=watcher_name)
    if watcher_name in project.get('commands', {}) or watcher_name in project.get('loops', {}):
        return _t(ctx, 'duplicate_handler_name', name=watcher_name)
    method_name = '{}watcher'.format(watcher_name).lower()
    core = _scan_core_signature(ctx)
    if watcher_name in RESERVED_METHOD_NAMES or method_name in core.get('methods', set()):
        return _t(ctx, 'core_watcher_conflict', name=watcher_name)
    return None

def _check_loop_name(ctx, project, loop_name, *, skip_name=None):
    if not re.match('^[a-z][a-z0-9_]{0,31}$', loop_name):
        return _t(ctx, 'invalid_loop_name')
    if loop_name != skip_name and loop_name in project.get('loops', {}):
        return _t(ctx, 'duplicate_loop_name', name=loop_name)
    if loop_name in project.get('commands', {}) or loop_name in project.get('watchers', {}):
        return _t(ctx, 'duplicate_handler_name', name=loop_name)
    method_name = '{}loop'.format(loop_name).lower()
    core = _scan_core_signature(ctx)
    if loop_name in RESERVED_METHOD_NAMES or method_name in core.get('methods', set()):
        return _t(ctx, 'core_loop_conflict', name=loop_name)
    return None

def _check_config_key(ctx, project, key):
    if not re.match('^[a-z][a-z0-9_]{0,63}$', key):
        return _t(ctx, 'invalid_config_name')
    if any((cfg['key'] == key for cfg in project['configs'])):
        return _t(ctx, 'duplicate_config_name', key=key)
    return None

def _validate_project_conflicts(ctx, project):
    name = project['meta']['name']
    class_name = project['meta'].get('class_name', name)
    core_modules = _scan_core_signature(ctx)['modules']
    if name.lower() in core_modules or class_name.lower() in core_modules:
        return _t(ctx, 'core_module_conflict', name=name)
    for cmd_name in project['commands']:
        if cmd_name.lower() in _scan_core_signature(ctx)['commands']:
            return _t(ctx, 'core_command_conflict', cmd=cmd_name)
    for watcher_name in project.get('watchers', {}):
        conflict = _check_watcher_name(ctx, project, watcher_name, skip_name=watcher_name)
        if conflict:
            return conflict
    for loop_name in project.get('loops', {}):
        conflict = _check_loop_name(ctx, project, loop_name, skip_name=loop_name)
        if conflict:
            return conflict
    return None

def _input_button(ctx, handler, args=(), placeholder=None, prompt_text=None, origin_inline_message_id=None):
    return _control(ctx, _t(ctx, 'enter_btn'), handler, args=args, prompt=_strip_html(placeholder or prompt_text or _t(ctx, 'enter_btn')))

async def _prompt(ctx, call, text, handler, args=(), placeholder=None, skip_handler=None, skip_args=(), cancel_callback=None):
    buttons = [[_input_button(ctx, handler, args=args, placeholder=placeholder, prompt_text=text)]]
    row = []
    if skip_handler:
        row.append(_control(ctx, _t(ctx, 'skip_btn'), skip_handler, args=skip_args))
    if cancel_callback:
        row.append(_control(ctx, _t(ctx, 'cancel_btn'), cancel_callback, clear=True))
    if row:
        buttons.append(row)
    await _edit_ui(ctx, call, text, reply_markup=buttons)

async def _show_main_menu(ctx, message):
    _sanitize_projects(ctx)
    projects = _get_projects(ctx)
    buttons = [[_control(ctx, _t(ctx, 'create_btn'), _cb_create_project)]]
    if projects:
        buttons.append([_control(ctx, _t(ctx, 'list_btn'), _cb_list_projects)])
    _menu_forms[_menu_origin(ctx)] = await message.inline_form(_t(ctx, 'welcome', count=len(projects)), buttons=buttons, form_handle=True)

async def _show_project_panel(ctx, call, pid, notice=None):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    text = _project_overview_text(ctx, pid, project, notice=notice)
    buttons = [[_control(ctx, _t(ctx, 'overview_btn'), ('_show_project_panel', [pid], {})), _control(ctx, _t(ctx, 'module_btn'), ('_cb_module_panel', [pid], {})), _control(ctx, _t(ctx, 'languages_btn'), ('_cb_lang_panel', [pid], {}))], [_control(ctx, _t(ctx, 'commands_btn'), ('_cb_commands_panel', [pid], {})), _control(ctx, _t(ctx, 'watchers_btn'), ('_cb_watchers_panel', [pid], {})), _control(ctx, _t(ctx, 'loops_btn'), ('_cb_loops_panel', [pid], {}))], [_control(ctx, _t(ctx, 'configs_btn'), ('_cb_configs_panel', [pid], {})), _control(ctx, _t(ctx, 'compile_btn'), ('_cb_compile', [pid], {}))], [_control(ctx, _t(ctx, 'delete_btn'), ('_cb_delete_confirm', [pid], {})), _control(ctx, _t(ctx, 'back_btn'), _cb_list_projects)]]
    await _edit_ui(ctx, call, text, reply_markup=buttons)

async def _cb_module_panel(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    buttons = [[_control(ctx, _t(ctx, 'edit_name_btn'), ('_cb_edit_module_name', [pid], {}))], [_control(ctx, _t(ctx, 'edit_developer_btn'), ('_cb_edit_module_meta', [pid, 'developer'], {})), _control(ctx, _t(ctx, 'edit_license_btn'), ('_cb_license_panel', [pid], {}))], [_control(ctx, _t(ctx, 'edit_version_btn'), ('_cb_edit_module_meta', [pid, 'version'], {})), _control(ctx, _t(ctx, 'edit_scope_btn'), ('_cb_edit_module_meta', [pid, 'heroku_min'], {}))], [_control(ctx, _t(ctx, 'edit_banner_btn'), ('_cb_edit_module_meta', [pid, 'banner'], {})), _control(ctx, _t(ctx, 'edit_pic_btn'), ('_cb_edit_module_meta', [pid, 'pic'], {}))], [_control(ctx, _t(ctx, 'edit_desc_en_btn'), ('_cb_edit_module_desc', [pid, 'en'], {})), _control(ctx, _t(ctx, 'edit_desc_ru_btn'), ('_cb_edit_module_desc', [pid, 'ru'], {}))], [_control(ctx, _t(ctx, 'dependencies_btn'), ('_cb_dependencies_panel', [pid], {}))]]
    buttons.extend(_module_lang_buttons(ctx, pid))
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_show_project_panel', [pid], {}))])
    await _edit_ui(ctx, call, _module_panel_text(ctx, pid, project), reply_markup=buttons)

async def _cb_edit_module_name(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='edit_module_name', pid=pid)
    await _prompt(ctx, call, _t(ctx, 'ask_name'), _handle_edit_module_name, args=(pid,), placeholder=project['meta'].get('name', _t(ctx, 'placeholder_module_name')), cancel_callback=('_cb_module_panel', [pid], {}))

async def _handle_edit_module_name(ctx, call, data, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    raw_name = (data or '').strip()
    error = _check_module_name(ctx, raw_name, skip_pid=pid)
    if error:
        return await _prompt(ctx, call, error + '\n\n' + _t(ctx, 'ask_name'), _handle_edit_module_name, args=(pid,), placeholder=project['meta'].get('name', _t(ctx, 'placeholder_module_name')), cancel_callback=('_cb_module_panel', [pid], {}))
    normalized, _ = _normalize_module_name(raw_name)
    project['meta']['name'] = normalized['display_name']
    project['meta']['class_name'] = normalized['class_name']
    project['strings'].setdefault('en', {})
    project['strings']['en']['name'] = normalized['display_name']
    if not project['strings']['en'].get('_cls_doc'):
        project['strings']['en']['_cls_doc'] = normalized['display_name']
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _edit_ui(ctx, call, _t(ctx, 'meta_saved'))
    await asyncio.sleep(1)
    await _cb_module_panel(ctx, call, pid)

async def _cb_edit_module_desc(ctx, call, pid, lang):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    current = ''
    if lang == 'en':
        current = project.get('description', '') or project['strings'].get('en', {}).get('_cls_doc', '')
    else:
        current = project['strings'].get(lang, {}).get('_cls_doc', '')
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='edit_module_desc', pid=pid, lang=lang)
    await _prompt(ctx, call, _t(ctx, 'ask_desc_en') if lang == 'en' else _t(ctx, 'ask_desc_ru') if lang == 'ru' else _t(ctx, 'ask_lang_cls', lang=LANG_LABELS.get(lang, lang)), _handle_edit_module_desc, args=(pid, lang), placeholder=current or (_t(ctx, 'placeholder_desc_en') if lang == 'en' else _t(ctx, 'placeholder_desc_ru') if lang == 'ru' else _t(ctx, 'placeholder_lang_desc')), skip_handler=('_handle_edit_module_desc', ['', pid, lang], {}), cancel_callback=('_cb_module_panel', [pid], {}))

async def _handle_edit_module_desc(ctx, call, data, pid, lang):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    value = (data or '').strip()
    project['strings'].setdefault(lang, {})
    if lang == 'en':
        project['description'] = value
        project['strings']['en']['_cls_doc'] = value or project['meta']['name']
    elif value:
        project['strings'][lang]['_cls_doc'] = value
    else:
        project['strings'][lang].pop('_cls_doc', None)
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _edit_ui(ctx, call, _t(ctx, 'meta_saved'))
    await asyncio.sleep(1)
    await _cb_module_panel(ctx, call, pid)

async def _cb_edit_module_meta(ctx, call, pid, field):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    prompts = {'developer': ('ask_module_developer', 'placeholder_module_developer'), 'version': ('ask_module_version', 'placeholder_module_version'), 'banner': ('ask_module_banner', 'placeholder_module_banner'), 'pic': ('ask_module_pic', 'placeholder_module_pic'), 'heroku_min': ('ask_module_heroku_min', 'placeholder_module_heroku_min')}
    if field not in prompts:
        return await _cb_module_panel(ctx, call, pid)
    prompt_key, placeholder_key = prompts[field]
    current = project.get('meta', {}).get(field, '')
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='edit_module_meta', pid=pid, field=field)
    await _prompt(ctx, call, _t(ctx, prompt_key), _handle_edit_module_meta, args=(pid, field), placeholder=current or _t(ctx, placeholder_key), skip_handler=('_handle_edit_module_meta', ['', pid, field], {}), cancel_callback=('_cb_module_panel', [pid], {}))

async def _handle_edit_module_meta(ctx, call, data, pid, field):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    value = _normalize_meta_text(data)
    error = None
    if field == 'version':
        normalized = _normalize_version(value)
        if value and (not normalized):
            error = _t(ctx, 'invalid_module_version')
        value = normalized
    elif field == 'heroku_min':
        normalized = _normalize_version(value)
        if value and (not normalized):
            error = _t(ctx, 'invalid_module_heroku_min')
        value = normalized
    elif field in {'banner', 'pic'} and value and (not _is_valid_image_meta(value)):
        error = _t(ctx, 'invalid_module_image')
    if error:
        return await _prompt(ctx, call, error + '\n\n' + _t(ctx, {'developer': 'ask_module_developer', 'version': 'ask_module_version', 'banner': 'ask_module_banner', 'pic': 'ask_module_pic', 'heroku_min': 'ask_module_heroku_min'}[field]), _handle_edit_module_meta, args=(pid, field), placeholder=project.get('meta', {}).get(field, '') or _t(ctx, {'developer': 'placeholder_module_developer', 'version': 'placeholder_module_version', 'banner': 'placeholder_module_banner', 'pic': 'placeholder_module_pic', 'heroku_min': 'placeholder_module_heroku_min'}[field]), cancel_callback=('_cb_module_panel', [pid], {}))
    project.setdefault('meta', {})[field] = value
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _edit_ui(ctx, call, _t(ctx, 'meta_saved'))
    await asyncio.sleep(1)
    await _cb_module_panel(ctx, call, pid)

async def _cb_license_panel(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    current = project.get('meta', {}).get('license', '')
    buttons = []
    row = []
    for license_name in LICENSE_OPTIONS:
        row.append(_control(ctx, '{} {}'.format('✅' if license_name == current else '•', license_name), ('_handle_module_license', [pid, license_name], {})))
        if len(row) == 3:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    buttons.append([_control(ctx, _t(ctx, 'clear_meta_btn'), ('_handle_module_license', [pid, ''], {})), _control(ctx, _t(ctx, 'back_btn'), ('_cb_module_panel', [pid], {}))])
    await _edit_ui(ctx, call, _t(ctx, 'license_panel', current=_meta_text(ctx, current)), reply_markup=buttons)

async def _handle_module_license(ctx, call, pid, license_name):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    project.setdefault('meta', {})['license'] = _normalize_meta_text(license_name)
    _save_project(ctx, pid, project)
    await _edit_ui(ctx, call, _t(ctx, 'meta_saved'))
    await asyncio.sleep(1)
    await _cb_module_panel(ctx, call, pid)

async def _cb_dependencies_panel(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    await _edit_ui(ctx, call, _t(ctx, 'dependencies_panel', deps=_dependencies_text(ctx, project)), reply_markup=[[_control(ctx, _t(ctx, 'edit_dependencies_btn'), ('_cb_edit_dependencies', [pid], {}))], [_control(ctx, _t(ctx, 'back_btn'), ('_cb_module_panel', [pid], {}))]])

async def _cb_edit_dependencies(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='edit_dependencies', pid=pid)
    await _prompt(ctx, call, _t(ctx, 'ask_dependencies'), _handle_edit_dependencies, args=(pid,), placeholder=', '.join(_parse_dependencies(project.get('dependencies') or [])), skip_handler=('_handle_edit_dependencies', ['', pid], {}), cancel_callback=('_cb_dependencies_panel', [pid], {}))

async def _handle_edit_dependencies(ctx, call, data, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    project['dependencies'] = _parse_dependencies(data or '')
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _edit_ui(ctx, call, _t(ctx, 'dependencies_saved'))
    await asyncio.sleep(1)
    await _cb_dependencies_panel(ctx, call, pid)

async def _cb_create_project(ctx, call):
    _clear_state(ctx, call)
    await _prompt(ctx, call, _t(ctx, 'ask_name'), _handle_project_name, placeholder=_t(ctx, 'placeholder_module_name'), cancel_callback=_cb_back_to_main)

async def _handle_project_name(ctx, call, data):
    raw_name = (data or '').strip()
    error = _check_module_name(ctx, raw_name)
    if error:
        return await _prompt(ctx, call, error + '\n\n' + _t(ctx, 'ask_name'), _handle_project_name, placeholder=_t(ctx, 'placeholder_module_name'), cancel_callback=_cb_back_to_main)
    normalized, _ = _normalize_module_name(raw_name)
    _set_state(ctx, call, flow='create_project', name=normalized['display_name'], class_name=normalized['class_name'])
    await _prompt(ctx, call, _t(ctx, 'ask_desc_en'), _handle_project_desc_en, placeholder=_t(ctx, 'placeholder_desc_en'), skip_handler=_skip_project_desc_en, cancel_callback=_cb_back_to_main)

async def _skip_project_desc_en(ctx, call):
    await _handle_project_desc_en(ctx, call, '')

async def _handle_project_desc_en(ctx, call, data):
    state = _get_state(ctx, call)
    state['desc_en'] = (data or '').strip()
    _set_state(ctx, call, **state)
    await _prompt(ctx, call, _t(ctx, 'ask_desc_ru'), _handle_project_desc_ru, placeholder=_t(ctx, 'placeholder_desc_ru'), skip_handler=_skip_project_desc_ru, cancel_callback=_cb_back_to_main)

async def _skip_project_desc_ru(ctx, call):
    await _handle_project_desc_ru(ctx, call, '')

async def _handle_project_desc_ru(ctx, call, data):
    state = _get_state(ctx, call)
    name = state.get('name')
    class_name = state.get('class_name')
    if not name:
        return await _cb_back_to_main(ctx, call)
    pid = _new_project(ctx, name, class_name=class_name)
    project = _get_project(ctx, pid)
    desc_en = state.get('desc_en', '').strip()
    desc_ru = (data or '').strip()
    project['description'] = desc_en
    project['strings']['en']['_cls_doc'] = desc_en or name
    if desc_ru:
        project['strings']['ru']['_cls_doc'] = desc_ru
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _show_project_panel(ctx, call, pid, notice=_t(ctx, 'project_created', name=name))

async def _cb_list_projects(ctx, call):
    _sanitize_projects(ctx)
    projects = _get_projects(ctx)
    if not projects:
        return await _edit_ui(ctx, call, _t(ctx, 'no_projects'), reply_markup=[[_control(ctx, _t(ctx, 'back_btn'), _cb_back_to_main)]])
    text = _t(ctx, 'list_title') + '\n\n'
    buttons = []
    for pid, proj in projects.items():
        text += _t(ctx, 'project_list_line', name=proj['meta']['name'], cmds=len(proj['commands']), cfgs=len(proj['configs']))
        buttons.append([_control(ctx, _project_button_text(ctx, proj['meta']['name']), ('_show_project_panel', [pid], {}))])
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), _cb_back_to_main)])
    await _edit_ui(ctx, call, text, reply_markup=buttons)

async def _cb_commands_panel(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    buttons = [[_control(ctx, _t(ctx, 'add_cmd_btn'), ('_cb_add_command', [pid], {}))]]
    for cmd_name in sorted(project['commands']):
        buttons.append([_control(ctx, _command_button_text(ctx, cmd_name), ('_cb_command_detail', [pid, cmd_name], {}))])
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_show_project_panel', [pid], {}))])
    await _edit_ui(ctx, call, _commands_panel_text(ctx, project), reply_markup=buttons)

async def _cb_command_detail(ctx, call, pid, cmd_name):
    project = _get_project(ctx, pid)
    if not project or cmd_name not in project.get('commands', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    buttons = [[_control(ctx, _t(ctx, 'edit_doc_en_btn'), ('_cb_edit_command_doc', [pid, cmd_name, 'en'], {})), _control(ctx, _t(ctx, 'edit_doc_ru_btn'), ('_cb_edit_command_doc', [pid, cmd_name, 'ru'], {}))]]
    buttons.extend(_command_lang_buttons(ctx, project, pid, cmd_name))
    buttons.extend([[_control(ctx, _t(ctx, 'edit_docs_btn'), ('_cb_command_docs_panel', [pid, cmd_name], {})), _control(ctx, _t(ctx, 'edit_body_btn'), ('_cb_edit_command_body', [pid, cmd_name], {}))], [_control(ctx, _t(ctx, 'delete_btn'), ('_cb_delete_command', [pid, cmd_name], {}))], [_control(ctx, _t(ctx, 'back_btn'), ('_cb_commands_panel', [pid], {}))]])
    await _edit_ui(ctx, call, _command_detail_text(ctx, project, cmd_name), reply_markup=buttons)

async def _cb_command_docs_panel(ctx, call, pid, cmd_name):
    project = _get_project(ctx, pid)
    if not project or cmd_name not in project.get('commands', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    buttons = []
    row = []
    for lang in _project_languages(project):
        row.append(_control(ctx, _lang_button_text(ctx, lang, {'strings': {lang: {'_cls_doc': _command_doc(project, cmd_name, lang)}}}), ('_cb_edit_command_doc', [pid, cmd_name, lang], {})))
        if len(row) == 3:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_cb_command_detail', [pid, cmd_name], {}))])
    await _edit_ui(ctx, call, _command_detail_text(ctx, project, cmd_name), reply_markup=buttons)

async def _cb_edit_command_doc(ctx, call, pid, cmd_name, lang):
    project = _get_project(ctx, pid)
    if not project or cmd_name not in project.get('commands', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    current = _command_doc(project, cmd_name, lang)
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='edit_command_doc', pid=pid, cmd_name=cmd_name, lang=lang)
    await _prompt(ctx, call, _t(ctx, 'ask_cmd_doc_en') if lang == 'en' else _t(ctx, 'ask_cmd_doc_ru') if lang == 'ru' else _t(ctx, 'ask_cmd_doc_lang', lang=LANG_LABELS.get(lang, lang)), _handle_edit_command_doc, args=(pid, cmd_name, lang), placeholder=current or (_t(ctx, 'placeholder_cmd_desc_en') if lang == 'en' else _t(ctx, 'placeholder_cmd_desc_ru') if lang == 'ru' else _t(ctx, 'placeholder_lang_desc')), skip_handler=('_handle_edit_command_doc', ['', pid, cmd_name, lang], {}), cancel_callback=('_cb_command_docs_panel', [pid, cmd_name], {}))

async def _handle_edit_command_doc(ctx, call, data, pid, cmd_name, lang):
    project = _get_project(ctx, pid)
    if not project or cmd_name not in project.get('commands', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    value = (data or '').strip()
    project.setdefault('command_docs', {})
    project['command_docs'].setdefault(cmd_name, {})
    if lang == 'en':
        project['command_docs'][cmd_name][lang] = value or cmd_name
    elif value:
        project['command_docs'][cmd_name][lang] = value
    else:
        project['command_docs'][cmd_name].pop(lang, None)
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _edit_ui(ctx, call, _t(ctx, 'cmd_updated', cmd=cmd_name))
    await asyncio.sleep(1)
    await _cb_command_detail(ctx, call, pid, cmd_name)

async def _cb_edit_command_body(ctx, call, pid, cmd_name):
    project = _get_project(ctx, pid)
    if not project or cmd_name not in project.get('commands', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='edit_command_body', pid=pid, cmd_name=cmd_name, original_cmd_name=cmd_name, entity_kind='command', editing_command=True, doc_en=_command_doc(project, cmd_name, 'en') or cmd_name, doc_ru=_command_doc(project, cmd_name, 'ru'))
    await _show_body_mode(ctx, call, pid)

async def _cb_delete_command(ctx, call, pid, cmd_name):
    project = _get_project(ctx, pid)
    if not project or cmd_name not in project.get('commands', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    project['commands'].pop(cmd_name, None)
    project.setdefault('command_docs', {}).pop(cmd_name, None)
    project.setdefault('command_resources', {}).pop(cmd_name, None)
    _save_project(ctx, pid, project)
    await _edit_ui(ctx, call, _t(ctx, 'cmd_deleted', cmd=cmd_name))
    await asyncio.sleep(1)
    await _cb_commands_panel(ctx, call, pid)

async def _cb_watchers_panel(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    buttons = [[_control(ctx, _t(ctx, 'add_watcher_btn'), ('_cb_add_watcher', [pid], {}))]]
    for watcher_name in sorted(project.get('watchers', {})):
        buttons.append([_control(ctx, _watcher_button_text(ctx, watcher_name), ('_cb_watcher_detail', [pid, watcher_name], {}))])
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_show_project_panel', [pid], {}))])
    await _edit_ui(ctx, call, _watchers_panel_text(ctx, project), reply_markup=buttons)

async def _cb_add_watcher(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='add_watcher', pid=pid, entity_kind='watcher')
    await _prompt(ctx, call, _t(ctx, 'ask_watcher_name'), _handle_watcher_name, args=(pid,), placeholder=_t(ctx, 'placeholder_watcher_name'), cancel_callback=('_cb_watchers_panel', [pid], {}))

async def _handle_watcher_name(ctx, call, data, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    watcher_name = (data or '').strip().lower()
    error = _check_watcher_name(ctx, project, watcher_name)
    if error:
        return await _prompt(ctx, call, error + '\n\n' + _t(ctx, 'ask_watcher_name'), _handle_watcher_name, args=(pid,), placeholder=_t(ctx, 'placeholder_watcher_name'), cancel_callback=('_cb_watchers_panel', [pid], {}))
    state = _get_state(ctx, call)
    state.update({'pid': pid, 'watcher_name': watcher_name, 'entity_kind': 'watcher', 'watcher_tags': {}})
    _set_state(ctx, call, **state)
    await _show_watcher_body_mode(ctx, call, pid)

async def _show_watcher_body_mode(ctx, call, pid):
    state = _get_state(ctx, call)
    watcher_name = state.get('watcher_name', '?')
    cancel_callback = ('_cb_watcher_detail', [pid, watcher_name], {}) if state.get('editing_watcher') else ('_cb_watchers_panel', [pid], {})
    await _edit_ui(ctx, call, _t(ctx, 'watcher_body_mode', name=watcher_name), reply_markup=[[_control(ctx, _t(ctx, 'ai_body_btn'), _handle_watcher_ai_body, args=(pid,), prompt=_t(ctx, 'ask_watcher_ai_prompt', name=watcher_name))], [_control(ctx, _t(ctx, 'manual_body_btn'), _handle_watcher_manual_body, args=(pid,), prompt=_t(ctx, 'ask_watcher_body', name=watcher_name))], [_control(ctx, _t(ctx, 'stub_body_btn'), ('_save_watcher', [pid, 'pass'], {})), _control(ctx, _t(ctx, 'cancel_btn'), cancel_callback)]])

async def _handle_watcher_ai_body(ctx, call, data, pid):
    prompt = (data or '').strip()
    state = _get_state(ctx, call)
    watcher_name = state.get('watcher_name', 'watcher')
    if not prompt:
        return await _show_watcher_body_mode(ctx, call, pid)
    settings, settings_error = _ai_settings(ctx)
    if settings_error:
        await _edit_ui(ctx, call, settings_error)
        await asyncio.sleep(2)
        return await _show_watcher_body_mode(ctx, call, pid)
    await _edit_ui(ctx, call, _t(ctx, 'ai_generating', cmd=watcher_name))
    project = _get_project(ctx, pid)
    generated = await _ai_generate(ctx, _build_ai_request(ctx, project or {}, state, prompt), settings)
    if generated.startswith('# AI Error'):
        await _edit_ui(ctx, call, _t(ctx, 'ai_error', err=generated))
        await asyncio.sleep(2)
        return await _show_watcher_body_mode(ctx, call, pid)
    body_error = _validate_body_syntax(generated)
    if body_error:
        await _edit_ui(ctx, call, _t(ctx, 'invalid_code', err=body_error))
        await asyncio.sleep(2)
        return await _show_watcher_body_mode(ctx, call, pid)
    await _edit_ui(ctx, call, _t(ctx, 'ai_done', cmd=watcher_name))
    await asyncio.sleep(1)
    await _save_watcher(ctx, call, pid, generated)

async def _handle_watcher_manual_body(ctx, call, data, pid):
    body = (data or '').strip() or 'pass'
    body_error = _validate_body_syntax(body)
    if body_error:
        await _edit_ui(ctx, call, _t(ctx, 'invalid_code', err=body_error))
        await asyncio.sleep(2)
        return await _show_watcher_body_mode(ctx, call, pid)
    await _save_watcher(ctx, call, pid, body)

async def _save_watcher(ctx, call, pid, body):
    state = _get_state(ctx, call)
    project = _get_project(ctx, pid)
    if not project:
        _clear_state(ctx, call)
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    watcher_name = state.get('watcher_name')
    original_watcher_name = state.get('original_watcher_name')
    existing = bool(original_watcher_name and original_watcher_name in project.get('watchers', {}))
    error = _check_watcher_name(ctx, project, watcher_name, skip_name=original_watcher_name if existing else None)
    if error:
        _clear_state(ctx, call)
        return await _edit_ui(ctx, call, error)
    existing_watcher = project.get('watchers', {}).get(original_watcher_name or watcher_name, {})
    project.setdefault('watchers', {})
    project['watchers'][watcher_name] = {'body': body, 'tags': dict(state.get('watcher_tags') or existing_watcher.get('tags') or {})}
    if existing and original_watcher_name != watcher_name:
        project['watchers'].pop(original_watcher_name, None)
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _edit_ui(ctx, call, _t(ctx, 'watcher_updated' if existing else 'watcher_added', name=watcher_name))
    await asyncio.sleep(1)
    if existing:
        await _cb_watcher_detail(ctx, call, pid, watcher_name)
    else:
        await _cb_watchers_panel(ctx, call, pid)

async def _cb_watcher_detail(ctx, call, pid, watcher_name):
    project = _get_project(ctx, pid)
    if not project or watcher_name not in project.get('watchers', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    await _edit_ui(ctx, call, _watcher_detail_text(ctx, project, watcher_name), reply_markup=[[_control(ctx, _t(ctx, 'edit_body_btn'), ('_cb_edit_watcher_body', [pid, watcher_name], {})), _control(ctx, _t(ctx, 'tags_btn'), ('_cb_watcher_tags_panel', [pid, watcher_name], {}))], [_control(ctx, _t(ctx, 'delete_btn'), ('_cb_delete_watcher', [pid, watcher_name], {}))], [_control(ctx, _t(ctx, 'back_btn'), ('_cb_watchers_panel', [pid], {}))]])

async def _cb_edit_watcher_body(ctx, call, pid, watcher_name):
    project = _get_project(ctx, pid)
    if not project or watcher_name not in project.get('watchers', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='edit_watcher_body', pid=pid, watcher_name=watcher_name, original_watcher_name=watcher_name, entity_kind='watcher', editing_watcher=True, watcher_tags=dict(project['watchers'][watcher_name].get('tags') or {}))
    await _show_watcher_body_mode(ctx, call, pid)

async def _cb_watcher_tags_panel(ctx, call, pid, watcher_name):
    project = _get_project(ctx, pid)
    if not project or watcher_name not in project.get('watchers', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    watcher = project['watchers'][watcher_name]
    buttons = []
    row = []
    for tag in WATCHER_TAG_OPTIONS:
        enabled = bool(watcher.get('tags', {}).get(tag))
        row.append(_control(ctx, '{} {}'.format('✅' if enabled else '➕', tag), ('_toggle_watcher_tag', [pid, watcher_name, tag], {})))
        if len(row) == 3:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_cb_watcher_detail', [pid, watcher_name], {}))])
    await _edit_ui(ctx, call, _t(ctx, 'watcher_tags_panel', name=watcher_name, tags=_watcher_tags_summary(ctx, watcher)), reply_markup=buttons)

async def _toggle_watcher_tag(ctx, call, pid, watcher_name, tag):
    project = _get_project(ctx, pid)
    if not project or watcher_name not in project.get('watchers', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    watcher = project['watchers'][watcher_name]
    tags = dict(watcher.get('tags') or {})
    if tags.get(tag):
        tags.pop(tag, None)
    else:
        tags[tag] = True
    watcher['tags'] = tags
    _save_project(ctx, pid, project)
    await _cb_watcher_tags_panel(ctx, call, pid, watcher_name)

async def _cb_delete_watcher(ctx, call, pid, watcher_name):
    project = _get_project(ctx, pid)
    if not project or watcher_name not in project.get('watchers', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    project['watchers'].pop(watcher_name, None)
    _save_project(ctx, pid, project)
    await _edit_ui(ctx, call, _t(ctx, 'watcher_deleted', name=watcher_name))
    await asyncio.sleep(1)
    await _cb_watchers_panel(ctx, call, pid)

async def _cb_loops_panel(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    buttons = [[_control(ctx, _t(ctx, 'add_loop_btn'), ('_cb_add_loop', [pid], {}))]]
    for loop_name in sorted(project.get('loops', {})):
        buttons.append([_control(ctx, _loop_button_text(ctx, loop_name), ('_cb_loop_detail', [pid, loop_name], {}))])
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_show_project_panel', [pid], {}))])
    await _edit_ui(ctx, call, _loops_panel_text(ctx, project), reply_markup=buttons)

async def _cb_add_loop(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='add_loop', pid=pid, entity_kind='loop')
    await _prompt(ctx, call, _t(ctx, 'ask_loop_name'), _handle_loop_name, args=(pid,), placeholder=_t(ctx, 'placeholder_loop_name'), cancel_callback=('_cb_loops_panel', [pid], {}))

async def _handle_loop_name(ctx, call, data, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    loop_name = (data or '').strip().lower()
    error = _check_loop_name(ctx, project, loop_name)
    if error:
        return await _prompt(ctx, call, error + '\n\n' + _t(ctx, 'ask_loop_name'), _handle_loop_name, args=(pid,), placeholder=_t(ctx, 'placeholder_loop_name'), cancel_callback=('_cb_loops_panel', [pid], {}))
    state = _get_state(ctx, call)
    state.update({'pid': pid, 'loop_name': loop_name, 'entity_kind': 'loop'})
    _set_state(ctx, call, **state)
    await _prompt(ctx, call, _t(ctx, 'ask_loop_interval', name=loop_name), _handle_loop_interval, args=(pid, loop_name, False), placeholder='60', cancel_callback=('_cb_loops_panel', [pid], {}))

async def _handle_loop_interval(ctx, call, data, pid, loop_name, editing):
    raw = (data or '').strip()
    try:
        interval = int(raw)
        if interval <= 0:
            raise ValueError
    except Exception:
        return await _prompt(ctx, call, _t(ctx, 'invalid_loop_interval') + '\n\n' + _t(ctx, 'ask_loop_interval', name=loop_name), _handle_loop_interval, args=(pid, loop_name, editing), placeholder=raw or '60', cancel_callback=('_cb_loop_detail', [pid, loop_name], {}) if editing else ('_cb_loops_panel', [pid], {}))
    project = _get_project(ctx, pid)
    if editing:
        if not project or loop_name not in project.get('loops', {}):
            return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
        project['loops'][loop_name]['interval'] = interval
        _save_project(ctx, pid, project)
        await _edit_ui(ctx, call, _t(ctx, 'loop_updated', name=loop_name))
        await asyncio.sleep(1)
        return await _cb_loop_detail(ctx, call, pid, loop_name)
    state = _get_state(ctx, call)
    state['interval'] = interval
    _set_state(ctx, call, **state)
    await _show_loop_body_mode(ctx, call, pid)

async def _show_loop_body_mode(ctx, call, pid):
    state = _get_state(ctx, call)
    loop_name = state.get('loop_name', '?')
    cancel_callback = ('_cb_loop_detail', [pid, loop_name], {}) if state.get('editing_loop') else ('_cb_loops_panel', [pid], {})
    await _edit_ui(ctx, call, _t(ctx, 'loop_body_mode', name=loop_name, interval=int(state.get('interval') or 60)), reply_markup=[[_control(ctx, _t(ctx, 'ai_body_btn'), _handle_loop_ai_body, args=(pid,), prompt=_t(ctx, 'ask_loop_ai_prompt', name=loop_name))], [_control(ctx, _t(ctx, 'manual_body_btn'), _handle_loop_manual_body, args=(pid,), prompt=_t(ctx, 'ask_loop_body', name=loop_name))], [_control(ctx, _t(ctx, 'stub_body_btn'), ('_save_loop', [pid, 'pass'], {})), _control(ctx, _t(ctx, 'cancel_btn'), cancel_callback)]])

async def _handle_loop_ai_body(ctx, call, data, pid):
    prompt = (data or '').strip()
    state = _get_state(ctx, call)
    loop_name = state.get('loop_name', 'loop')
    if not prompt:
        return await _show_loop_body_mode(ctx, call, pid)
    settings, settings_error = _ai_settings(ctx)
    if settings_error:
        await _edit_ui(ctx, call, settings_error)
        await asyncio.sleep(2)
        return await _show_loop_body_mode(ctx, call, pid)
    await _edit_ui(ctx, call, _t(ctx, 'ai_generating', cmd=loop_name))
    project = _get_project(ctx, pid)
    generated = await _ai_generate(ctx, _build_ai_request(ctx, project or {}, state, prompt), settings)
    if generated.startswith('# AI Error'):
        await _edit_ui(ctx, call, _t(ctx, 'ai_error', err=generated))
        await asyncio.sleep(2)
        return await _show_loop_body_mode(ctx, call, pid)
    body_error = _validate_body_syntax(generated)
    if body_error:
        await _edit_ui(ctx, call, _t(ctx, 'invalid_code', err=body_error))
        await asyncio.sleep(2)
        return await _show_loop_body_mode(ctx, call, pid)
    await _edit_ui(ctx, call, _t(ctx, 'ai_done', cmd=loop_name))
    await asyncio.sleep(1)
    await _save_loop(ctx, call, pid, generated)

async def _handle_loop_manual_body(ctx, call, data, pid):
    body = (data or '').strip() or 'pass'
    body_error = _validate_body_syntax(body)
    if body_error:
        await _edit_ui(ctx, call, _t(ctx, 'invalid_code', err=body_error))
        await asyncio.sleep(2)
        return await _show_loop_body_mode(ctx, call, pid)
    await _save_loop(ctx, call, pid, body)

async def _save_loop(ctx, call, pid, body):
    state = _get_state(ctx, call)
    project = _get_project(ctx, pid)
    if not project:
        _clear_state(ctx, call)
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    loop_name = state.get('loop_name')
    original_loop_name = state.get('original_loop_name')
    existing = bool(original_loop_name and original_loop_name in project.get('loops', {}))
    error = _check_loop_name(ctx, project, loop_name, skip_name=original_loop_name if existing else None)
    if error:
        _clear_state(ctx, call)
        return await _edit_ui(ctx, call, error)
    existing_loop = project.get('loops', {}).get(original_loop_name or loop_name, {})
    project.setdefault('loops', {})
    project['loops'][loop_name] = {'body': body, 'interval': int(state.get('interval') or existing_loop.get('interval') or 60)}
    if existing and original_loop_name != loop_name:
        project['loops'].pop(original_loop_name, None)
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _edit_ui(ctx, call, _t(ctx, 'loop_updated' if existing else 'loop_added', name=loop_name))
    await asyncio.sleep(1)
    if existing:
        await _cb_loop_detail(ctx, call, pid, loop_name)
    else:
        await _cb_loops_panel(ctx, call, pid)

async def _cb_loop_detail(ctx, call, pid, loop_name):
    project = _get_project(ctx, pid)
    if not project or loop_name not in project.get('loops', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    await _edit_ui(ctx, call, _loop_detail_text(ctx, project, loop_name), reply_markup=[[_control(ctx, _t(ctx, 'interval_btn'), ('_cb_edit_loop_interval', [pid, loop_name], {})), _control(ctx, _t(ctx, 'edit_body_btn'), ('_cb_edit_loop_body', [pid, loop_name], {}))], [_control(ctx, _t(ctx, 'delete_btn'), ('_cb_delete_loop', [pid, loop_name], {}))], [_control(ctx, _t(ctx, 'back_btn'), ('_cb_loops_panel', [pid], {}))]])

async def _cb_edit_loop_interval(ctx, call, pid, loop_name):
    project = _get_project(ctx, pid)
    if not project or loop_name not in project.get('loops', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    await _prompt(ctx, call, _t(ctx, 'ask_loop_interval', name=loop_name), _handle_loop_interval, args=(pid, loop_name, True), placeholder=str(project['loops'][loop_name].get('interval') or 60), cancel_callback=('_cb_loop_detail', [pid, loop_name], {}))

async def _cb_edit_loop_body(ctx, call, pid, loop_name):
    project = _get_project(ctx, pid)
    if not project or loop_name not in project.get('loops', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='edit_loop_body', pid=pid, loop_name=loop_name, original_loop_name=loop_name, entity_kind='loop', editing_loop=True, interval=int(project['loops'][loop_name].get('interval') or 60))
    await _show_loop_body_mode(ctx, call, pid)

async def _cb_delete_loop(ctx, call, pid, loop_name):
    project = _get_project(ctx, pid)
    if not project or loop_name not in project.get('loops', {}):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    project['loops'].pop(loop_name, None)
    _save_project(ctx, pid, project)
    await _edit_ui(ctx, call, _t(ctx, 'loop_deleted', name=loop_name))
    await asyncio.sleep(1)
    await _cb_loops_panel(ctx, call, pid)

async def _cb_configs_panel(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    buttons = [[_control(ctx, _t(ctx, 'add_cfg_btn'), ('_cb_add_config', [pid], {}))]]
    for cfg in project['configs']:
        buttons.append([_control(ctx, _config_button_text(ctx, cfg['key']), ('_cb_config_detail', [pid, cfg['key']], {}))])
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_show_project_panel', [pid], {}))])
    await _edit_ui(ctx, call, _configs_panel_text(ctx, project), reply_markup=buttons)

async def _cb_config_detail(ctx, call, pid, key):
    project = _get_project(ctx, pid)
    cfg = _get_config_entry(ctx, project, key) if project else None
    if not project or not cfg:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    await _edit_ui(ctx, call, _config_detail_text(ctx, cfg), reply_markup=[[_control(ctx, _t(ctx, 'edit_default_btn'), ('_cb_edit_config_default', [pid, key], {})), _control(ctx, _t(ctx, 'edit_validator_btn'), ('_cb_edit_config_validator', [pid, key], {}))], [_control(ctx, _t(ctx, 'delete_btn'), ('_cb_delete_config', [pid, key], {})), _control(ctx, _t(ctx, 'back_btn'), ('_cb_configs_panel', [pid], {}))]])

async def _cb_edit_config_default(ctx, call, pid, key):
    project = _get_project(ctx, pid)
    cfg = _get_config_entry(ctx, project, key) if project else None
    if not project or not cfg:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    _clear_state(ctx, call)
    return await _start_config_default_step(ctx, call, pid, key, cfg.get('validator', 'String'), cfg.get('validator_args') or {}, edit=True, current_default=cfg.get('default', ''))

async def _handle_edit_config_default(ctx, call, data, pid, key):
    project = _get_project(ctx, pid)
    cfg = _get_config_entry(ctx, project, key) if project else None
    if not project or not cfg:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    return await _handle_config_default_input(ctx, call, data, pid, key, cfg.get('validator', 'String'), True)

def _config_default_prompt_text(ctx, validator, key):
    if validator == 'Boolean':
        return _t(ctx, 'ask_cfg_boolean_default', key=key)
    if validator == 'Choice':
        return _t(ctx, 'ask_cfg_choice_default', key=key)
    if validator == 'MultiChoice':
        return _t(ctx, 'ask_cfg_multichoice_default', key=key)
    return _t(ctx, 'ask_cfg_default')

async def _start_config_default_step(ctx, call, pid, key, validator, validator_args, *, edit, current_default=''):
    selected = current_default
    if validator == 'MultiChoice':
        if isinstance(current_default, (list, tuple, set)):
            selected = list(current_default)
        elif current_default == '':
            selected = []
        else:
            selected = [current_default]
    _set_state(ctx, call, flow='edit_config_default' if edit else 'add_config_default', pid=pid, key=key, validator=validator, validator_args=validator_args or {}, editing_config=edit, pending_default=selected)
    cancel_callback = ('_cb_config_detail', [pid, key], {}) if edit else ('_cb_configs_panel', [pid], {})
    if validator == 'Boolean':
        return await _show_boolean_default_picker(ctx, call, pid, key, edit)
    if validator == 'Choice':
        return await _show_choice_default_picker(ctx, call, pid, key, edit)
    if validator == 'MultiChoice':
        return await _show_multichoice_default_picker(ctx, call, pid, key, edit)
    return await _prompt(ctx, call, _config_default_prompt_text(ctx, validator, key), _handle_config_default_input, args=(pid, key, validator, edit), placeholder=str(current_default) if current_default != '' else _t(ctx, 'placeholder_cfg_default'), skip_handler=('_handle_config_default_input', ['', pid, key, validator, edit], {}), cancel_callback=cancel_callback)

async def _show_boolean_default_picker(ctx, call, pid, key, edit):
    await _edit_ui(ctx, call, _config_default_prompt_text(ctx, 'Boolean', key), reply_markup=[[_control(ctx, _t(ctx, 'true_btn'), ('_finalize_config_entry', [pid, key, 'Boolean', True], {'edit': edit})), _control(ctx, _t(ctx, 'false_btn'), ('_finalize_config_entry', [pid, key, 'Boolean', False], {'edit': edit}))], [_control(ctx, _t(ctx, 'back_btn'), ('_cb_config_detail', [pid, key], {}) if edit else ('_cb_configs_panel', [pid], {}))]])

async def _show_choice_default_picker(ctx, call, pid, key, edit):
    state = _get_state(ctx, call)
    values = list((state.get('validator_args') or {}).get('possible_values') or [])
    buttons = []
    row = []
    for value in values:
        row.append(_control(ctx, str(value), ('_finalize_config_entry', [pid, key, 'Choice', value], {'edit': edit})))
        if len(row) == 2:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_cb_config_detail', [pid, key], {}) if edit else ('_cb_configs_panel', [pid], {}))])
    await _edit_ui(ctx, call, _config_default_prompt_text(ctx, 'Choice', key), reply_markup=buttons)

async def _show_multichoice_default_picker(ctx, call, pid, key, edit):
    state = _get_state(ctx, call)
    values = list((state.get('validator_args') or {}).get('possible_values') or [])
    selected = set(state.get('pending_default') or [])
    buttons = []
    row = []
    for value in values:
        row.append(_control(ctx, '{} {}'.format('✅' if value in selected else '▫️', value), ('_toggle_multichoice_default', [pid, key, value, edit], {})))
        if len(row) == 2:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    buttons.append([_control(ctx, _t(ctx, 'save_btn'), ('_save_multichoice_default', [pid, key, edit], {})), _control(ctx, _t(ctx, 'clear_btn'), ('_clear_multichoice_default', [pid, key, edit], {}))])
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_cb_config_detail', [pid, key], {}) if edit else ('_cb_configs_panel', [pid], {}))])
    text = '{}\n\n{}'.format(_config_default_prompt_text(ctx, 'MultiChoice', key), _t(ctx, 'selected_values_line', values=_escape_html(_config_default_label(ctx, list(selected)))))
    await _edit_ui(ctx, call, text, reply_markup=buttons)

async def _toggle_multichoice_default(ctx, call, pid, key, value, edit):
    state = _get_state(ctx, call)
    selected = list(state.get('pending_default') or [])
    if value in selected:
        selected = [item for item in selected if item != value]
    else:
        selected.append(value)
    _set_state(ctx, call, **{**state, 'pending_default': selected})
    return await _show_multichoice_default_picker(ctx, call, pid, key, edit)

async def _clear_multichoice_default(ctx, call, pid, key, edit):
    state = _get_state(ctx, call)
    _set_state(ctx, call, **{**state, 'pending_default': []})
    return await _show_multichoice_default_picker(ctx, call, pid, key, edit)

async def _save_multichoice_default(ctx, call, pid, key, edit):
    state = _get_state(ctx, call)
    return await _finalize_config_entry(ctx, call, pid, key, 'MultiChoice', list(state.get('pending_default') or []), edit=edit)

async def _prompt_validator_meta(ctx, call, pid, key, validator, *, edit):
    _set_state(ctx, call, flow='edit_config_validator_meta' if edit else 'config_validator_meta', pid=pid, key=key, validator=validator, editing_config=edit)
    await _prompt(ctx, call, _validator_followup_prompt(ctx, validator, key), _handle_validator_meta, args=(pid, key, validator, edit), placeholder=_t(ctx, 'placeholder_cfg_default'), cancel_callback=('_cb_config_detail', [pid, key], {}) if edit else ('_cb_configs_panel', [pid], {}))

async def _finalize_config_entry(ctx, call, pid, key, validator, default, *, edit):
    project = _get_project(ctx, pid)
    if not project:
        _clear_state(ctx, call)
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    state = _get_state(ctx, call)
    validator_args = state.get('validator_args') or {}
    parsed_default, error = _parse_default_for_validator(validator, default, validator_args)
    if error:
        return await _edit_ui(ctx, call, _t(ctx, 'validator_default_invalid', validator=validator))
    if edit:
        cfg = _get_config_entry(ctx, project, key)
        if not cfg:
            _clear_state(ctx, call)
            return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
        cfg['validator'] = validator
        cfg['validator_args'] = validator_args or {}
        cfg['default'] = parsed_default
        _save_project(ctx, pid, project)
        _clear_state(ctx, call)
        await _edit_ui(ctx, call, _t(ctx, 'cfg_updated', key=key))
        await asyncio.sleep(1)
        return await _cb_config_detail(ctx, call, pid, key)
    error = _check_config_key(ctx, project, key)
    if error:
        _clear_state(ctx, call)
        return await _edit_ui(ctx, call, error)
    project['configs'].append({'key': key, 'default': parsed_default, 'validator': validator, 'validator_args': validator_args or {}})
    project['strings']['en']['{}_doc'.format(key)] = 'Config: {}'.format(key)
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _edit_ui(ctx, call, _t(ctx, 'cfg_added', key=key))
    await asyncio.sleep(1)
    return await _cb_configs_panel(ctx, call, pid)

async def _handle_config_default_input(ctx, call, data, pid, key, validator, edit):
    state = _get_state(ctx, call)
    parsed_default, error = _parse_default_for_validator(validator, (data or '').strip(), state.get('validator_args') or {})
    if error:
        return await _prompt(ctx, call, _t(ctx, 'validator_default_invalid', validator=validator) + '\n\n' + _config_default_prompt_text(ctx, validator, key), _handle_config_default_input, args=(pid, key, validator, edit), placeholder=_t(ctx, 'placeholder_cfg_default'), cancel_callback=('_cb_config_detail', [pid, key], {}) if edit else ('_cb_configs_panel', [pid], {}))
    return await _finalize_config_entry(ctx, call, pid, key, validator, parsed_default, edit=edit)

async def _handle_validator_meta(ctx, call, data, pid, key, validator, edit):
    validator_args, error = _parse_validator_meta(validator, data)
    if error:
        return await _prompt(ctx, call, _t(ctx, 'invalid_validator_meta', validator=validator) + '\n\n' + _validator_followup_prompt(ctx, validator, key), _handle_validator_meta, args=(pid, key, validator, edit), placeholder=_t(ctx, 'placeholder_cfg_default'), cancel_callback=('_cb_config_detail', [pid, key], {}) if edit else ('_cb_configs_panel', [pid], {}))
    current_default = ''
    if edit:
        project = _get_project(ctx, pid)
        cfg = _get_config_entry(ctx, project, key) if project else None
        current_default = cfg.get('default', '') if cfg else ''
    return await _start_config_default_step(ctx, call, pid, key, validator, validator_args or {}, edit=edit, current_default=current_default)

async def _cb_edit_config_validator(ctx, call, pid, key):
    project = _get_project(ctx, pid)
    cfg = _get_config_entry(ctx, project, key) if project else None
    if not project or not cfg:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    buttons = []
    row = []
    for validator in VALIDATORS_LIST:
        row.append(_control(ctx, validator, ('_handle_edit_config_validator', [validator, pid, key], {})))
        if len(row) == 3:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_cb_config_detail', [pid, key], {}))])
    await _edit_ui(ctx, call, _t(ctx, 'ask_cfg_validator', key=key), reply_markup=buttons)

async def _handle_edit_config_validator(ctx, call, validator, pid, key):
    project = _get_project(ctx, pid)
    cfg = _get_config_entry(ctx, project, key) if project else None
    current_default = cfg.get('default', '') if cfg else ''
    _set_state(ctx, call, pid=pid, key=key, validator=validator, validator_args={}, editing_config=True)
    if validator in VALIDATOR_REQUIRED_META:
        return await _prompt_validator_meta(ctx, call, pid, key, validator, edit=True)
    return await _start_config_default_step(ctx, call, pid, key, validator, {}, edit=True, current_default=current_default)

async def _cb_delete_config(ctx, call, pid, key):
    project = _get_project(ctx, pid)
    cfg = _get_config_entry(ctx, project, key) if project else None
    if not project or not cfg:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    project['configs'] = [item for item in project['configs'] if item.get('key') != key]
    project['strings'].setdefault('en', {})
    project['strings']['en'].pop(f'{key}_doc', None)
    _save_project(ctx, pid, project)
    await _edit_ui(ctx, call, _t(ctx, 'cfg_deleted', key=key))
    await asyncio.sleep(1)
    await _cb_configs_panel(ctx, call, pid)

async def _cb_add_command(ctx, call, pid):
    if not _get_project(ctx, pid):
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='add_command', pid=pid, entity_kind='command')
    await _prompt(ctx, call, _t(ctx, 'ask_cmd_name'), _handle_cmd_name, args=(pid,), placeholder=_t(ctx, 'placeholder_cmd_name'), cancel_callback=('_show_project_panel', [pid], {}))

async def _handle_cmd_name(ctx, call, data, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    cmd_name = (data or '').strip().lower()
    error = _check_command_name(ctx, project, cmd_name)
    if error:
        return await _prompt(ctx, call, error + '\n\n' + _t(ctx, 'ask_cmd_name'), _handle_cmd_name, args=(pid,), placeholder=_t(ctx, 'placeholder_cmd_name'), cancel_callback=('_show_project_panel', [pid], {}))
    state = _get_state(ctx, call)
    state.update({'pid': pid, 'cmd_name': cmd_name, 'entity_kind': 'command'})
    _set_state(ctx, call, **state)
    await _prompt(ctx, call, _t(ctx, 'ask_cmd_doc_en'), _handle_cmd_doc_en, args=(pid,), placeholder=_t(ctx, 'placeholder_cmd_desc_en'), skip_handler=('_handle_cmd_doc_en', ['', pid], {}), cancel_callback=('_show_project_panel', [pid], {}))

async def _handle_cmd_doc_en(ctx, call, data, pid):
    state = _get_state(ctx, call)
    state['doc_en'] = (data or '').strip() or state.get('cmd_name', '')
    _set_state(ctx, call, **state)
    await _prompt(ctx, call, _t(ctx, 'ask_cmd_doc_ru'), _handle_cmd_doc_ru, args=(pid,), placeholder=_t(ctx, 'placeholder_cmd_desc_ru'), skip_handler=('_handle_cmd_doc_ru', ['', pid], {}), cancel_callback=('_show_project_panel', [pid], {}))

async def _handle_cmd_doc_ru(ctx, call, data, pid):
    state = _get_state(ctx, call)
    state['doc_ru'] = (data or '').strip()
    _set_state(ctx, call, **state)
    await _show_body_mode(ctx, call, pid)

async def _show_body_mode(ctx, call, pid):
    state = _get_state(ctx, call)
    cmd_name = state.get('cmd_name', '?')
    cancel_callback = ('_cb_command_detail', [pid, cmd_name], {}) if state.get('editing_command') else ('_cb_commands_panel', [pid], {})
    await _edit_ui(ctx, call, _t(ctx, 'body_mode', cmd=cmd_name), reply_markup=[[_control(ctx, _t(ctx, 'ai_body_btn'), _handle_cmd_ai_body, args=(pid,), prompt=_t(ctx, 'ask_cmd_ai_prompt', cmd=cmd_name))], [_control(ctx, _t(ctx, 'manual_body_btn'), _handle_cmd_manual_body, args=(pid,), prompt=_t(ctx, 'ask_cmd_body', cmd=cmd_name)), _control(ctx, _t(ctx, 'template_body_btn'), ('_cb_template_panel', [pid], {}))], [_control(ctx, _t(ctx, 'stub_body_btn'), ('_save_command', [pid, 'pass'], {})), _control(ctx, _t(ctx, 'cancel_btn'), cancel_callback)]])

async def _cb_template_panel(ctx, call, pid):
    state = _get_state(ctx, call)
    cmd_name = state.get('cmd_name', '?')
    buttons = []
    row = []
    for template_key, meta in COMMAND_TEMPLATES.items():
        row.append(_control(ctx, meta['title'], ('_cb_apply_template', [pid, template_key], {})))
        if len(row) == 2:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_show_body_mode', [pid], {}))])
    await _edit_ui(ctx, call, _t(ctx, 'template_panel', cmd=cmd_name), reply_markup=buttons)

async def _cb_apply_template(ctx, call, pid, template_key):
    meta = COMMAND_TEMPLATES.get(template_key)
    state = _get_state(ctx, call)
    cmd_name = state.get('cmd_name', '?')
    if not meta:
        return await _cb_template_panel(ctx, call, pid)
    if meta.get('needs_input'):
        prompt_key = meta.get('prompt_key')
        return await _prompt(ctx, call, _t(ctx, prompt_key, cmd=cmd_name), _handle_template_input, args=(pid, template_key), placeholder=_t(ctx, 'placeholder_cfg_default'), cancel_callback=('_cb_template_panel', [pid], {}))
    return await _apply_template(ctx, call, pid, template_key, '')

async def _handle_template_input(ctx, call, data, pid, template_key):
    return await _apply_template(ctx, call, pid, template_key, data or '')

async def _apply_template(ctx, call, pid, template_key, payload):
    state = _get_state(ctx, call)
    cmd_name = state.get('cmd_name', '?')
    rendered = _template_body(template_key, payload, cmd_name=cmd_name)
    if not rendered:
        await _edit_ui(ctx, call, _t(ctx, 'invalid_code', err=_t(ctx, 'template_payload_invalid')))
        await asyncio.sleep(2)
        return await _cb_template_panel(ctx, call, pid)
    body, resources = rendered
    body_error = _validate_body_syntax(body)
    if body_error:
        await _edit_ui(ctx, call, _t(ctx, 'invalid_code', err=body_error))
        await asyncio.sleep(2)
        return await _cb_template_panel(ctx, call, pid)
    await _edit_ui(ctx, call, _t(ctx, 'template_saved', cmd=cmd_name))
    await asyncio.sleep(1)
    await _save_command(ctx, call, pid, body, resources=resources)

async def _handle_cmd_ai_body(ctx, call, data, pid):
    prompt = (data or '').strip()
    state = _get_state(ctx, call)
    cmd_name = state.get('cmd_name', 'command')
    if not prompt:
        return await _show_body_mode(ctx, call, pid)
    settings, settings_error = _ai_settings(ctx)
    if settings_error:
        await _edit_ui(ctx, call, settings_error)
        await asyncio.sleep(2)
        return await _show_body_mode(ctx, call, pid)
    await _edit_ui(ctx, call, _t(ctx, 'ai_generating', cmd=cmd_name))
    project = _get_project(ctx, pid)
    generated = await _ai_generate(ctx, _build_ai_request(ctx, project or {}, state, prompt), settings)
    if generated.startswith('# AI Error'):
        await _edit_ui(ctx, call, _t(ctx, 'ai_error', err=generated))
        await asyncio.sleep(2)
        return await _show_body_mode(ctx, call, pid)
    if not generated.strip():
        await _edit_ui(ctx, call, _t(ctx, 'ai_error', err=_t(ctx, 'empty_code')))
        await asyncio.sleep(2)
        return await _show_body_mode(ctx, call, pid)
    ai_contract_error = _validate_ai_body_contracts(generated)
    if ai_contract_error:
        await _edit_ui(ctx, call, _t(ctx, 'invalid_code', err=ai_contract_error))
        await asyncio.sleep(2)
        return await _show_body_mode(ctx, call, pid)
    body_error = _validate_body_syntax(generated)
    if body_error:
        await _edit_ui(ctx, call, _t(ctx, 'invalid_code', err=body_error))
        await asyncio.sleep(2)
        return await _show_body_mode(ctx, call, pid)
    await _edit_ui(ctx, call, _t(ctx, 'ai_done', cmd=cmd_name))
    await asyncio.sleep(1)
    await _save_command(ctx, call, pid, generated)

async def _handle_cmd_manual_body(ctx, call, data, pid):
    body = (data or '').strip() or 'pass'
    body_error = _validate_body_syntax(body)
    if body_error:
        await _edit_ui(ctx, call, _t(ctx, 'invalid_code', err=body_error))
        await asyncio.sleep(2)
        return await _show_body_mode(ctx, call, pid)
    await _save_command(ctx, call, pid, body)

async def _save_command(ctx, call, pid, body, *, resources=None):
    state = _get_state(ctx, call)
    project = _get_project(ctx, pid)
    if not project:
        _clear_state(ctx, call)
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    cmd_name = state.get('cmd_name')
    original_cmd_name = state.get('original_cmd_name')
    existing = bool(original_cmd_name and original_cmd_name in project['commands'])
    error = None
    if not existing or original_cmd_name != cmd_name:
        error = _check_command_name(ctx, project, cmd_name)
    if error:
        _clear_state(ctx, call)
        return await _edit_ui(ctx, call, error)
    existing_command = project['commands'].get(original_cmd_name or cmd_name, {}) if isinstance(project.get('commands'), dict) else {}
    project['commands'][cmd_name] = {'body': body, 'tags': dict(existing_command.get('tags', {})) if isinstance(existing_command, dict) else {}}
    project.setdefault('command_docs', {})
    project['command_docs'].setdefault(cmd_name, {})
    project['command_docs'][cmd_name]['en'] = state.get('doc_en', cmd_name)
    if state.get('doc_ru'):
        project['command_docs'][cmd_name]['ru'] = state['doc_ru']
    else:
        project['command_docs'][cmd_name].pop('ru', None)
    project.setdefault('command_resources', {})
    if resources is not None:
        cmd_resources = project['command_resources'].setdefault(cmd_name, {})
        cmd_resources['en'] = {'texts': dict((resources or {}).get('texts') or {}), 'lists': dict((resources or {}).get('lists') or {}), 'values': dict((resources or {}).get('values') or {})}
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _edit_ui(ctx, call, _t(ctx, 'cmd_updated' if existing else 'cmd_added', cmd=cmd_name))
    await asyncio.sleep(1)
    if existing:
        await _cb_command_detail(ctx, call, pid, cmd_name)
    else:
        await _cb_commands_panel(ctx, call, pid)

async def _cb_add_config(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='add_config', pid=pid)
    await _prompt(ctx, call, _t(ctx, 'ask_cfg_key'), _handle_cfg_key, args=(pid,), placeholder=_t(ctx, 'placeholder_cfg_key'), cancel_callback=('_show_project_panel', [pid], {}))

async def _handle_cfg_key(ctx, call, data, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    key = (data or '').strip()
    error = _check_config_key(ctx, project, key)
    if error:
        return await _prompt(ctx, call, error + '\n\n' + _t(ctx, 'ask_cfg_key'), _handle_cfg_key, args=(pid,), placeholder=_t(ctx, 'placeholder_cfg_key'), cancel_callback=('_show_project_panel', [pid], {}))
    state = _get_state(ctx, call)
    state['key'] = key
    _set_state(ctx, call, **state)
    await _handle_cfg_default(ctx, call, '', pid)

async def _handle_cfg_default(ctx, call, data, pid):
    state = _get_state(ctx, call)
    buttons = []
    row = []
    for validator in VALIDATORS_LIST:
        row.append(_control(ctx, validator, ('_handle_cfg_validator', [validator, pid], {})))
        if len(row) == 3:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    buttons.append([_control(ctx, _t(ctx, 'cancel_btn'), ('_show_project_panel', [pid], {}))])
    await _edit_ui(ctx, call, _t(ctx, 'ask_cfg_validator', key=state['key']), reply_markup=buttons)

async def _handle_cfg_validator(ctx, call, validator, pid):
    state = _get_state(ctx, call)
    key = state.get('key')
    _set_state(ctx, call, **{**state, 'validator': validator, 'validator_args': {}, 'editing_config': False})
    if validator in VALIDATOR_REQUIRED_META:
        return await _prompt_validator_meta(ctx, call, pid, key, validator, edit=False)
    return await _start_config_default_step(ctx, call, pid, key, validator, {}, edit=False, current_default='')

async def _cb_lang_panel(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    buttons = []
    row = []
    for lang in _project_languages(project):
        row.append(_control(ctx, _lang_button_text(ctx, lang, project), ('_cb_edit_lang', [pid, lang], {})))
        if len(row) == 3:
            buttons.append(row)
            row = []
    if row:
        buttons.append(row)
    buttons.append([_control(ctx, _t(ctx, 'add_lang_btn'), ('_cb_add_custom_lang', [pid], {}))])
    buttons.append([_control(ctx, _t(ctx, 'back_btn'), ('_show_project_panel', [pid], {}))])
    await _edit_ui(ctx, call, _t(ctx, 'lang_panel'), reply_markup=buttons)

async def _cb_add_custom_lang(ctx, call, pid):
    _clear_state(ctx, call)
    _set_state(ctx, call, flow='add_custom_lang', pid=pid)
    await _prompt(ctx, call, _t(ctx, 'ask_lang_code'), _handle_add_custom_lang, args=(pid,), placeholder='es', cancel_callback=('_cb_lang_panel', [pid], {}))

async def _handle_add_custom_lang(ctx, call, data, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    lang = _normalize_lang_code(data)
    if not lang:
        return await _prompt(ctx, call, _t(ctx, 'invalid_lang_code') + '\n\n' + _t(ctx, 'ask_lang_code'), _handle_add_custom_lang, args=(pid,), placeholder='es', cancel_callback=('_cb_lang_panel', [pid], {}))
    extra_langs = list(project.get('extra_langs') or [])
    if lang not in REQUIRED_LANGS and lang not in SUPPORTED_LANGS and (lang not in extra_langs):
        extra_langs.append(lang)
    project['extra_langs'] = extra_langs
    project['strings'].setdefault(lang, {})
    _save_project(ctx, pid, project)
    _clear_state(ctx, call)
    await _edit_ui(ctx, call, _t(ctx, 'lang_saved', lang=LANG_LABELS.get(lang, lang)))
    await asyncio.sleep(1)
    await _cb_lang_panel(ctx, call, pid)

async def _cb_edit_lang(ctx, call, pid, lang):
    await _prompt(ctx, call, _t(ctx, 'ask_lang_cls', lang=LANG_LABELS.get(lang, lang)), _handle_lang_cls, args=(pid, lang), placeholder=_t(ctx, 'placeholder_lang_desc'), skip_handler=('_cb_lang_panel', [pid], {}), cancel_callback=('_cb_lang_panel', [pid], {}))

async def _handle_lang_cls(ctx, call, data, pid, lang):
    value = (data or '').strip()
    if not value:
        return await _cb_lang_panel(ctx, call, pid)
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    project['strings'].setdefault(lang, {})
    project['strings'][lang]['_cls_doc'] = value
    _save_project(ctx, pid, project)
    await _edit_ui(ctx, call, _t(ctx, 'lang_saved', lang=LANG_LABELS.get(lang, lang)))
    await asyncio.sleep(1)
    await _cb_lang_panel(ctx, call, pid)

async def _cb_compile(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    conflict = _validate_project_conflicts(ctx, project)
    if conflict:
        return await _edit_ui(ctx, call, conflict, reply_markup=[[_control(ctx, _t(ctx, 'back_btn'), ('_show_project_panel', [pid], {}))]])
    for cfg in project.get('configs', []):
        cfg_error = _validate_config_validator(cfg)
        if cfg_error:
            return await _edit_ui(ctx, call, _t(ctx, 'compile_error', err=cfg_error), reply_markup=[[_control(ctx, _t(ctx, 'back_btn'), ('_cb_configs_panel', [pid], {}))]])
    await _edit_ui(ctx, call, _t(ctx, 'compile_start', name=project['meta']['name']))
    code, err, _resolved_imports = _build_module_code_with_import_repair(project)
    if err:
        return await _edit_ui(ctx, call, _t(ctx, 'compile_error', err=err), reply_markup=[[_control(ctx, _t(ctx, 'back_btn'), ('_show_project_panel', [pid], {}))]])
    file_obj = io.BytesIO(code.encode('utf-8'))
    file_obj.name = '{}.hmod'.format(project['meta'].get('class_name', project['meta']['name']))
    await ctx.reply_file(file_obj.getvalue(), filename=file_obj.name, caption=_t(ctx, 'compiled_caption', name=project['meta']['name'], cmds=len(project['commands']), watchers=len(project.get('watchers', {})), loops=len(project.get('loops', {})), cfgs=len(project['configs'])), parse_mode='html')
    with contextlib.suppress(Exception):
        await call.delete()

async def _cb_delete_confirm(ctx, call, pid):
    project = _get_project(ctx, pid)
    if not project:
        return await _edit_ui(ctx, call, _t(ctx, 'project_not_found'))
    await _edit_ui(ctx, call, _t(ctx, 'delete_confirm', name=project['meta']['name']), reply_markup=[[_control(ctx, _t(ctx, 'delete_btn'), ('_cb_do_delete', [pid, project['meta']['name']], {})), _control(ctx, _t(ctx, 'cancel_btn'), ('_show_project_panel', [pid], {}))]])

async def _cb_do_delete(ctx, call, pid, name):
    _delete_project(ctx, pid)
    await _edit_ui(ctx, call, _t(ctx, 'project_deleted', name=name))
    await asyncio.sleep(1)
    await _cb_back_to_main(ctx, call)

async def _cb_back_to_main(ctx, call):
    projects = _get_projects(ctx)
    buttons = [[_control(ctx, _t(ctx, 'create_btn'), _cb_create_project)]]
    if projects:
        buttons.append([_control(ctx, _t(ctx, 'list_btn'), _cb_list_projects)])
    await _edit_ui(ctx, call, _t(ctx, 'welcome', count=len(projects)), reply_markup=buttons)

async def rcbm(ctx, message):
    """Open RedConstructor."""
    await _show_main_menu(ctx, message)

async def rchp(ctx, message):
    """Show IDE help."""
    await message.respond(_t(ctx, 'help_text'))

async def rcls(ctx, message):
    """List IDE projects."""
    _sanitize_projects(ctx)
    projects = _get_projects(ctx)
    if not projects:
        return await message.respond(_t(ctx, 'no_projects'))
    text = _t(ctx, 'list_title') + '\n\n'
    for pid, proj in projects.items():
        text += _t(ctx, 'project_list_line_with_id', name=proj['meta']['name'], pid=pid, cmds=len(proj['commands']), cfgs=len(proj['configs']))
    await message.respond(text)

async def rcpg(ctx, message):
    """Remove corrupted IDE projects from DB."""
    count_before = len(_get_projects(ctx))
    _sanitize_projects(ctx)
    count_after = len(_get_projects(ctx))
    removed = count_before - count_after
    await message.respond(_t(ctx, 'purge_done', removed=removed, remaining=count_after))
_locale_packs = {lang: globals().get("_locale_" + lang, {}) for lang in SUPPORTED_LANGS}
