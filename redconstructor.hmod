_menu_contexts = {}
_menu_forms = {}


def _menu_origin(ctx):
    key = str(ctx.chat_id) + ':' + str(ctx.message_id)
    _menu_contexts[key] = ctx
    if len(_menu_contexts) > 256:
        _menu_contexts.pop(next(iter(_menu_contexts)))
    return key


def _menu_context(key):
    if key not in _menu_contexts:
        raise ValueError('Constructor session expired')
    return _menu_contexts[key]


def _control(ctx, text, target, args=(), prompt=None, clear=False):
    if isinstance(target, tuple):
        action, bound_args, kwargs = target
    else:
        action, bound_args, kwargs = target.__name__, [], {}
    payload = {'action': action, 'args': list(bound_args) + list(args), 'kwargs': kwargs, 'clear': clear, 'origin': _menu_origin(ctx)}
    if prompt:
        return {'text': text, 'k': 'input', 'm': 'redconstructor', 'f': 'menu_input', 'p': prompt, 'a': payload}
    return ctx.ui.button(text, menu_callback, payload)


async def _edit_menu(ctx, call, text, rows=None, **kwargs):
    if isinstance(call, dict):
        return await ctx.edit_form(call['form_key'], text, buttons=rows)
    return await call.edit(text, reply_markup=rows, **kwargs)


async def menu_callback(call, payload=None):
    payload = payload or {}
    ctx = _menu_context(payload.get('origin', {}))
    return await _menu_action(ctx, call, payload)


async def _menu_action(ctx, call, payload):
    action = payload.get('action', '')
    if not action.startswith(('_cb_', '_handle_', '_skip_', '_show_', '_save_', '_clear_', '_toggle_', '_finalize_')) or not callable(globals().get(action)):
        raise ValueError('Unknown constructor control')
    if payload.get('clear'):
        _clear_state(ctx, call)
    return await globals()[action](ctx, call, *payload.get('args', []), **payload.get('kwargs', {}))


async def menu_input(ctx, nav):
    payload = {name: nav.arg(name) for name in ('action', 'args', 'kwargs', 'clear', 'origin')}
    origin = _menu_context(payload['origin'])
    action = payload.get('action', '')
    if not action.startswith(('_cb_', '_handle_', '_skip_', '_show_', '_save_', '_clear_', '_toggle_', '_finalize_')) or not callable(globals().get(action)):
        raise ValueError('Unknown constructor control')
    target = {'form_key': _menu_forms[payload['origin']]}
    if payload.get('clear'):
        _clear_state(origin, target)
    await globals()[action](origin, target, str(nav.value or ''), *payload.get('args', []), **payload.get('kwargs', {}))
    return None


SUPPORTED_LANGS = ['en', 'ru', 'de', 'uk', 'jp', 'tiktok', 'neofit', 'leet', 'uwu']
REQUIRED_LANGS = ['en', 'ru']
LANG_CODE_RE = re.compile('^[a-z][a-z0-9_]{0,15}$')
VALIDATORS_LIST = ['Boolean', 'Integer', 'String', 'Float', 'Hidden', 'Link', 'Choice', 'MultiChoice', 'Series', 'TelegramID', 'RegExp', 'Emoji']
VALIDATOR_REQUIRED_META = {'Choice': 'possible_values', 'MultiChoice': 'possible_values', 'RegExp': 'regex'}
VERSION_RE = re.compile('^\\d+(?:\\.\\d+)+$')
